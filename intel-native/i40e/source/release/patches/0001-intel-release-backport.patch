+static int
+scrape_iavf_pfs( char const * if_name ) {
+  char members[ FD_IAVF_MEMBER_MAX ][ IF_NAMESIZE ];
+  ulong member_cnt;
+  if( FD_UNLIKELY( -1==fd_iavf_member_interfaces( if_name, members, &member_cnt ) ) ) return 0;
