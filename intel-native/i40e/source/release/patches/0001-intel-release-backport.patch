+// Transmit jobs dropped, by reason
+message MetricsIavfPktTxDropped {
+  // Invalid packet headers, or GRE packet exceeding the MTU
+  uint64 invalid = 1;
+  // No matching route
+  uint64 no_route = 2;
+  // Unsupported route type
+  uint64 unsupported_route = 3;
+  // Interface not available
+  uint64 interface_missing = 4;
+  // Interface type not supported
+  uint64 unsupported_interface = 5;
+  // No source IP address chosen
+  uint64 source_ip_missing = 6;
+  // Next-hop neighbor unresolved
+  uint64 no_neighbor = 7;
+  // TX ring full or no TX buffer available
+  uint64 ring_full = 8;
+  // GRE tunnel addresses missing or outer route is itself tunnelled
+  uint64 gre_no_route = 9;
+}
+
+// Received packets dropped, by reason
+message MetricsIavfPktRxDropped {
+  // Undersized, oversized, or malformed Ethernet, IPv4 or UDP headers
+  uint64 malformed = 1;
+  // Destination IP does not match the bind address
+  uint64 dst_ip_mismatch = 2;
+  // No output link for the destination UDP port
+  uint64 dst_port_unbound = 3;
+  // GRE tunnel peer or headers invalid
+  uint64 gre_invalid = 4;
+  // GRE packet with no GRE tunnel configured
+  uint64 gre_unconfigured = 5;
+}
+
+// Times the tile tried to park while idle (efficient mode), by result
+message MetricsIavfParkAttempted {
+  // Woken by a doorbell ring
+  uint64 ring = 1;
+  // Deadline or park cap lapsed
+  uint64 deadline = 2;
+  // Pre-park recheck found work, did not park
+  uint64 pending = 3;
+}
+
+// Thread wall time since start, by scheduler state; Idle is the remainder, so parts sum to about the lifetime.  User, System and Interrupt have 10 ms resolution; Interrupt is 0 unless it is the only live tile pinned to its CPU
+message MetricsIavfThreadDurationNanos {
+  // Wait (task was runnable but not scheduled)
+  uint64 wait = 1;
+  // Idle (task was not runnable)
+  uint64 idle = 2;
+  // User (task was scheduled and executing in user mode)
+  uint64 user = 3;
+  // System (task was scheduled and executing in kernel mode)
+  uint64 system = 4;
+  // Interrupt (CPU time stolen by hardirq/softirq handlers or a hypervisor; fixed tiles only)
+  uint64 interrupt = 5;
+}
+
+// Tile wall time, by regime; regimes are exhaustive and groups Busy, Idle, Backpressure and Housekeeping partition it
+message MetricsIavfRegimeDurationNanos {
+  // Caught up + Housekeeping
+  uint64 caught_up_housekeeping = 1;
+  // Processing + Housekeeping
+  uint64 processing_housekeeping = 2;
+  // Backpressure + Housekeeping
+  uint64 backpressure_housekeeping = 3;
+  // Caught up + Prefrag
+  uint64 caught_up_prefrag = 4;
+  // Processing + Prefrag
+  uint64 processing_prefrag = 5;
+  // Backpressure + Prefrag
+  uint64 backpressure_prefrag = 6;
+  // Caught up + Postfrag
+  uint64 caught_up_postfrag = 7;
+  // Processing + Postfrag
+  uint64 processing_postfrag = 8;
+  // Caught up + Sleeping
+  uint64 caught_up_sleeping = 9;
+  // Backpressure + Sleeping
+  uint64 backpressure_sleeping = 10;
+}
+
 // The validator received a verified, deduplicated transaction
 message Txn {
   // The source IP address of the transaction sender
