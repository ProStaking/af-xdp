+static void
+test_rx_non_fd_packets( void ) {
+  struct {
+    ushort dst_port;
+    ushort udp_sz;
+    ulong  out_idx;
+    int    published;
+    int    non_fd;
+    ulong  drop_reason;
+  } const cases[] = {
+    { .dst_port=80U,   .udp_sz=8U, .non_fd=1 },
+    { .dst_port=9000U, .udp_sz=8U, .published=1 },
+    { .dst_port=9000U, .udp_sz=7U, .drop_reason=FD_METRICS_ENUM_PKT_RX_DROP_REASON_V_MALFORMED_IDX },
+    { .dst_port=9000U, .udp_sz=8U, .out_idx=ULONG_MAX, .drop_reason=FD_METRICS_ENUM_PKT_RX_DROP_REASON_V_DST_PORT_UNBOUND_IDX }
+  };
+  for( ulong i=0UL; i<sizeof(cases)/sizeof(cases[0]); i++ ) {
+    test_vfs_init();
+    test_tile.vf_cnt             = 1UL;
+    test_tile.batch_size         = 1U;
+    test_tile.net.dst_port_cnt   = 1UL;
+    test_tile.net.dst_ports[0]   = 9000U;
+    test_tile.net.dst_protos[0]  = DST_PROTO_SHRED;
+    test_tile.net.dst_out_idx[0] = cases[i].out_idx;
+    test_tile.net.rx_out_cnt     = 1UL;
+    test_tile.net.pkt_buf_chunk0 = 1UL;
+    test_tile.net.pkt_buf_wmark  = 33UL;
+    uchar packet_memory[ 4096 ] __attribute__((aligned(64))) = {0};
+    test_tile.net.pkt_buf_wksp_base = packet_memory;
+    fd_eth_hdr_t * eth = fd_chunk_to_laddr( packet_memory, 1UL );
+    eth->net_type = fd_ushort_bswap( FD_ETH_HDR_TYPE_IP );
+    fd_ip4_hdr_t * ip4 = (fd_ip4_hdr_t *)(eth+1);
+    *ip4 = (fd_ip4_hdr_t) {
+      .verihl=FD_IP4_VERIHL( 4,5 ), .protocol=FD_IP4_HDR_PROTOCOL_UDP,
+      .net_tot_len=fd_ushort_bswap( 28U ), .saddr=FD_IP4_ADDR( 198,51,100,1 )
+    };
+    fd_udp_hdr_t * udp = (fd_udp_hdr_t *)(ip4+1);
+    *udp = (fd_udp_hdr_t) { .net_sport=fd_ushort_bswap( 4321U ),
+                           .net_dport=fd_ushort_bswap( cases[i].dst_port ), .net_len=fd_ushort_bswap( cases[i].udp_sz ) };
+
+    fd_frag_meta_t mcache[ 128 ] __attribute__((aligned(128))) = {0};
+    mcache[0].chunk = 33U;
+    fd_frag_meta_t * mcaches[] = { mcache };
+    ulong seq=0UL, depth=128UL;
+    int reliable=0;
+    fd_stem_context_t stem = { .mcaches=mcaches, .seqs=&seq, .depths=&depth, .out_reliable=&reliable };
+    fd_iavf_hw_rx_desc_t desc[ 128 ] = {0};
+    uint chunks[ 128 ] = { 1U };
+    uint tail = 0U;
+    fd_iavf_tile_vf_t * vf = &test_tile.vfs[0];
+    vf->rx_queue = (fd_iavf_queue_t) { .ring=desc, .depth=128U, .tail=&tail, .prod=1UL, .posted=1UL };
+    vf->rx_desc_buf_chunk = chunks;
+    desc[0].qword[1] = FD_IAVF_RX_DESC_DONE | FD_IAVF_RX_DESC_END_OF_PACKET | (42UL<<FD_IAVF_RX_DESC_LENGTH_SHIFT);
+    FD_TEST( fd_iavf_tile_poll_rx( &test_tile, &stem ) );
+    FD_TEST( test_tile.metrics.non_fd_pkt_cnt==(ulong)cases[i].non_fd );
+    FD_TEST( test_tile.net.metrics.rx_pkt_cnt==(ulong)cases[i].published && seq==(ulong)cases[i].published );
+    FD_TEST( chunks[1]==(cases[i].published ? 33U : 1U) );
+    for( ulong r=0UL; r<FD_METRICS_ENUM_PKT_RX_DROP_REASON_CNT; r++ ) {
+      FD_TEST( test_tile.net.metrics.rx_drop_cnt[r]==(ulong)(!cases[i].published && !cases[i].non_fd && r==cases[i].drop_reason) );
+    }
+  }
+}
