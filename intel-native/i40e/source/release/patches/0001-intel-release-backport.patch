+/* Release backport: preserve chunk ownership on all rejected short frames,
+   and retain Alpenglow repair response/ping payload routing. */
+static void
+test_release_rx_contract( void ) {
+  uchar memory[4096] __attribute__((aligned(64))) = {0};
+  fd_net_tile_t net = {0};
+  net.pkt_buf_wksp_base = memory;
+  fd_eth_hdr_t * eth = fd_chunk_to_laddr( memory, 1UL );
+  eth->net_type = fd_ushort_bswap( FD_ETH_HDR_TYPE_IP );
+  for( ulong n=0UL; n<sizeof(fd_eth_hdr_t)+sizeof(fd_ip4_hdr_t); n++ ) {
+    ulong recycled=0UL, unrelated=0UL;
+    FD_TEST( !fd_net_rx_pkt( &net, NULL, 1UL, n, 0UL, &recycled, &unrelated ) );
+    FD_TEST( recycled==1UL && unrelated==0UL );
+  }
+  eth->net_type = fd_ushort_bswap( FD_ETH_HDR_TYPE_ARP );
+  ulong recycled=0UL, unrelated=0UL;
+  FD_TEST( !fd_net_rx_pkt( &net, NULL, 1UL, sizeof(fd_eth_hdr_t), 0UL, &recycled, &unrelated ) );
+  FD_TEST( recycled==1UL && unrelated==1UL );
+  FD_TEST( !fd_net_rx_pkt( &net, NULL, 1UL, sizeof(fd_eth_hdr_t), 0UL, &recycled, NULL ) );
+  FD_TEST( recycled==1UL );
+
+  net.dst_port_cnt=1UL; net.dst_ports[0]=9000U;
+  net.dst_protos[0]=DST_PROTO_REPAIR; net.dst_out_idx[0]=0UL;
+  net.rx_out_cnt=2UL; net.repair_out_idx=1UL;
+  ulong out=ULONG_MAX, proto=ULONG_MAX;
+  FD_TEST( fd_net_rx_dst_port_lookup( &net, 9000U, AG_REPAIR_RESPONSE_MAX_SZ, &out, &proto ) );
+  FD_TEST( out==1UL && proto==DST_PROTO_REPAIR );
+  FD_TEST( fd_net_rx_dst_port_lookup( &net, 9000U, AG_REPAIR_RESPONSE_MAX_SZ+1UL, &out, &proto ) );
+  FD_TEST( out==0UL && proto==DST_PROTO_REPAIR );
