+static int
+fd_iavf_pci_addr_normalize( char         normalized[ FD_IAVF_PCI_ADDR_SZ ],
+                            char const * pci_addr ) {
+  if( FD_UNLIKELY( NULL==pci_addr || strnlen( pci_addr, FD_IAVF_PCI_ADDR_SZ )!=FD_IAVF_PCI_ADDR_SZ-1UL ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+  if( FD_UNLIKELY( pci_addr[4]!=':' || pci_addr[7]!=':' || pci_addr[10]!='.' ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  for( ulong i=0UL; i<FD_IAVF_PCI_ADDR_SZ-1UL; i++ ) {
+    if( i==4UL || i==7UL || i==10UL ) {
+      normalized[i] = pci_addr[i];
+      continue;
+    }
+    uchar c = (uchar)pci_addr[i];
+    if( FD_UNLIKELY( !isxdigit( c ) ) ) {
+      errno = EINVAL;
+      return -1;
+    }
+    normalized[i] = (char)tolower( c );
+  }
+  normalized[ FD_IAVF_PCI_ADDR_SZ-1UL ] = '\0';
+
+  ulong slot = strtoul( normalized+8, NULL, 16 );
+  if( FD_UNLIKELY( slot>31UL ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+  ulong function = strtoul( normalized+11, NULL, 16 );
+  if( FD_UNLIKELY( function>7UL ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+  return 0;
+}
+
+static void
+fd_iavf_path_join( char         path[ PATH_MAX ],
+                   char const * parent,
+                   char const * name ) {
+  int path_sz = snprintf( path, PATH_MAX, "%s/%s", parent, name );
+  FD_TEST( path_sz>=0 && path_sz<PATH_MAX );
+}
+
+static int
+fd_iavf_read_ulong( char const * path,
+                    int          base,
+                    ulong *      value ) {
+  int fd = open( path, O_RDONLY|O_CLOEXEC );
+  if( FD_UNLIKELY( -1==fd ) ) return -1;
+
+  char buf[ 64 ];
+  ssize_t read_sz = read( fd, buf, sizeof(buf)-1UL );
+  int     err     = 0;
+  if( FD_UNLIKELY( -1==read_sz ) )                        err = errno;
+  else if( FD_UNLIKELY( (ulong)read_sz==sizeof(buf)-1UL ) ) err = EOVERFLOW;
+  if( FD_UNLIKELY( -1==close( fd ) && 0==err ) )           err = errno;
+  if( FD_UNLIKELY( 0!=err ) ) {
+    errno = err;
+    return -1;
+  }
+
+  while( 0!=read_sz && isspace( (uchar)buf[ read_sz-1L ] ) ) read_sz--;
+  if( FD_UNLIKELY( 0==read_sz ) ) {
+    errno = EPROTO;
+    return -1;
+  }
+  buf[ read_sz ] = '\0';
+
+  errno = 0;
+  char * end;
+  ulong parsed = strtoul( buf, &end, base );
+  if( FD_UNLIKELY( 0!=errno || *end ) ) {
+    if( 0==errno ) errno = EPROTO;
+    return -1;
+  }
+  *value = parsed;
+  return 0;
+}
+
+static int
+fd_iavf_read_link_name( char *       name,
+                        ulong        name_max,
+                        char const * path,
+                        int          optional ) {
+  char target[ PATH_MAX ];
+  ssize_t target_sz = readlink( path, target, sizeof(target)-1UL );
+  if( FD_UNLIKELY( -1==target_sz ) ) {
+    if( optional && errno==ENOENT ) {
+      name[0] = '\0';
+      return 0;
+    }
+    return -1;
+  }
+  if( FD_UNLIKELY( (ulong)target_sz==sizeof(target)-1UL ) ) {
+    errno = ENAMETOOLONG;
+    return -1;
+  }
+  target[ target_sz ] = '\0';
+
+  char const * base = strrchr( target, '/' );
+  base              = NULL!=base ? base+1 : target;
+  ulong base_sz     = strlen( base );
+  if( FD_UNLIKELY( 0==base_sz || base_sz>=name_max ) ) {
+    errno = EPROTO;
+    return -1;
+  }
+  fd_memcpy( name, base, base_sz+1UL );
+  return 0;
+}
+
+int
+fd_iavf_vfio_avail( void ) {
+  struct stat st;
+  return 0==stat( "/sys/bus/pci/drivers/vfio-pci", &st ) && S_ISDIR( st.st_mode );
+}
+
+int
+fd_iavf_vfio_api_check( char const ** diagnostic ) {
+  if( NULL!=diagnostic ) *diagnostic = NULL;
+
+  char const * message = "Opening /dev/vfio/vfio failed";
+  int fd = open( "/dev/vfio/vfio", O_RDWR|O_CLOEXEC );
+  if( FD_UNLIKELY( -1==fd ) ) goto fail;
+
+  message = "Reading the VFIO API version from /dev/vfio/vfio failed";
+  int api_version = ioctl( fd, VFIO_GET_API_VERSION );
+  if( FD_UNLIKELY( -1==api_version ) ) goto fail;
+  if( FD_UNLIKELY( api_version!=VFIO_API_VERSION ) ) {
+    message = "The kernel's VFIO API version is incompatible with the iavf networking provider";
+    errno   = EPROTONOSUPPORT;
+    goto fail;
+  }
+  message = "Checking VFIO TYPE1v2 IOMMU support through /dev/vfio/vfio failed";
+  int type1v2_supported = ioctl( fd, VFIO_CHECK_EXTENSION, VFIO_TYPE1v2_IOMMU );
+  if( FD_UNLIKELY( -1==type1v2_supported ) ) goto fail;
+  if( FD_UNLIKELY( !type1v2_supported ) ) {
+    message = "VFIO TYPE1v2 IOMMU support is unavailable";
+    errno   = EPROTONOSUPPORT;
+    goto fail;
+  }
+  if( FD_UNLIKELY( -1==close( fd ) ) ) {
+    if( NULL!=diagnostic ) *diagnostic = "Closing /dev/vfio/vfio failed";
+    return -1;
+  }
+  return 0;
+
+fail:
+  {
+    int err = errno;
+    if( -1!=fd ) close( fd );
+    if( NULL!=diagnostic ) *diagnostic = message;
+    errno = err;
+    return -1;
+  }
+}
+
+int
+fd_iavf_member_interfaces( char const * interface,
+                           char         members[ FD_IAVF_MEMBER_MAX ][ IF_NAMESIZE ],
+                           ulong *      member_cnt ) {
+  if( NULL==interface || NULL==members || NULL==member_cnt || 0==interface[0] || strlen(interface)>=IF_NAMESIZE ) {
+    errno = EINVAL;
+    return -1;
+  }
+  *member_cnt = 0UL;
+  /* Find PF interfaces, expanding 802.3ad bonds into their members */
+  if( fd_bonding_is_master( interface ) ) {
+    if( !fd_bonding_is_lacp( interface ) ) {
+      errno = EOPNOTSUPP;
+      return -1;
+    }
+    fd_bonding_slave_iter_t iter[1];
+    for( fd_bonding_slave_iter_init( iter, interface );
+         !fd_bonding_slave_iter_done( iter );
+         fd_bonding_slave_iter_next( iter ) ) {
+      char const * name = fd_bonding_slave_iter_ele( iter );
+      if( *member_cnt>=FD_IAVF_MEMBER_MAX || strlen(name)>=IF_NAMESIZE ) {
+        errno = E2BIG;
+        return -1;
+      }
+      fd_cstr_ncpy( members[ (*member_cnt)++ ], name, IF_NAMESIZE );
+    }
+  } else {
+    fd_cstr_ncpy( members[0], interface, IF_NAMESIZE );
+    *member_cnt = 1UL;
+  }
+  if( 0==*member_cnt ) {
+    errno = ENODEV;
+    return -1;
+  }
+  /* Require ice or i40e on every PF */
+  for( ulong i=0UL; i<*member_cnt; i++ ) {
+    char path  [ PATH_MAX ];
+    char driver[ FD_IAVF_DRIVER_NAME_MAX ];
+    FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/driver", members[i] ) );
+    if( -1==fd_iavf_read_link_name( driver, sizeof(driver), path, 0 ) ) return -1;
+    if( 0!=strcmp(driver,"ice") && 0!=strcmp(driver,"i40e") ) {
+      errno = EPROTONOSUPPORT;
+      return -1;
+    }
+  }
+  return 0;
+}
+
+#if FD_HAS_X86
+static int
+fd_iavf_cpu_vendor( char vendor[ 13 ] ) {
+  uint eax, ebx, ecx, edx;
+  if( !__get_cpuid( 0U, &eax, &ebx, &ecx, &edx ) ) return 0;
+
+  /* CPUID returns the vendor string in EBX, EDX, ECX order. */
+  fd_memcpy( vendor,   &ebx, 4UL );
+  fd_memcpy( vendor+4, &edx, 4UL );
+  fd_memcpy( vendor+8, &ecx, 4UL );
+  vendor[ 12 ] = '\0';
+  return 1;
+}
+
+/* fd_iavf_cmdline_next splits one boot argument in place using Linux
+   lib/cmdline.c next_arg quoting rules. Quotes group whitespace and
+   backslashes are literal. Returns the remaining command line, or
+   NULL for unclosed quotes. param and value point into cmdline, with
+   value set to NULL when the argument has no value. */
+static char *
+fd_iavf_cmdline_next( char *  cmdline,
+                      char ** param,
+                      char ** value ) {
+  while( fd_isspace( (int)(uchar)*cmdline ) ) cmdline++;
+  int quoted = *cmdline=='"';
+  char * arg = cmdline+quoted;
+
+  char * equals = NULL;
+  char * end    = arg;
+  int in_quote  = quoted;
+  for( ; *end; end++ ) {
+    if( fd_isspace( (int)(uchar)*end ) && !in_quote ) break;
+    if( *end=='=' && NULL==equals && end!=arg ) equals = end;
+    if( *end=='"' ) in_quote = !in_quote;
+  }
+  if( in_quote ) return NULL;
+
+  char * next = end;
+  if( *next ) *next++ = '\0';
+  *param = arg;
+  *value = NULL;
+  if( NULL!=equals ) {
+    *equals = '\0';
+    *value  = equals+1;
+    if( **value=='"' ) {
+      (*value)++;
+      if( end>*value && end[-1]=='"' ) end[-1] = '\0';
+    }
+  }
+  if( quoted && end>arg && end[-1]=='"' ) end[-1] = '\0';
+  return next;
+}
+
+static int
+fd_iavf_intel_iommu_default_off( void ) {
+  struct utsname kernel;
+  if( -1==uname( &kernel ) ) return 0;
+
+  char config_path[ PATH_MAX ];
+  if( !fd_cstr_printf_check( config_path, sizeof(config_path), NULL, "/boot/config-%s", kernel.release ) ) return 0;
+
+  FILE * config_file = fopen( config_path, "r" );
+  if( NULL==config_file ) return 0;
+
+  /* Long CONFIG_CMDLINE values can span reads, so only match at line starts. */
+  char line[ 256 ];
+  int line_start     = 1;
+  int driver_enabled = 0;
+  int default_off    = 0;
+  while( NULL!=fgets( line, sizeof(line), config_file ) ) {
+    if( line_start ) {
+      if( 0==strcmp( line, "CONFIG_INTEL_IOMMU=y\n" ) ) driver_enabled = 1;
+      if( 0==strcmp( line, "# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set\n" ) ) default_off = 1;
+    }
+    line_start = NULL!=strchr( line, '\n' );
+  }
+
+  int read_err  = ferror( config_file );
+  int close_err = fclose( config_file );
+  return driver_enabled && default_off && !read_err && 0==close_err;
+}
+#endif
+
+char const *
+fd_iavf_sriov_bios_guide( int vendor_only ) {
+  char const * fallback = NULL;
+  if( !vendor_only ) {
+    fallback = "Enable SR-IOV and IOMMU in the system BIOS.\n"
+               "  Set Virtualization Mode to SR-IOV in the NIC's BIOS settings";
+  }
+
+#if FD_HAS_X86
+  char vendor[ 13 ];
+  if( !fd_iavf_cpu_vendor( vendor ) ) return fallback;
+  int is_intel = 0==strcmp( vendor, "GenuineIntel" );
+  int is_amd   = 0==strcmp( vendor, "AuthenticAMD" );
+  /* The board vendor can identify Supermicro in systems sold under another brand. */
+  char const * const paths[] = {
+    "/sys/class/dmi/id/board_vendor",
+    "/sys/class/dmi/id/sys_vendor"
+  };
+  for( ulong i=0UL; i<sizeof(paths)/sizeof(paths[0]); i++ ) {
+    int fd = open( paths[i], O_RDONLY|O_CLOEXEC );
+    if( -1==fd ) continue;
+
+    char manufacturer[ 128 ];
+    ulong manufacturer_sz;
+    int read_err  = fd_io_read( fd, manufacturer, sizeof(manufacturer), sizeof(manufacturer), &manufacturer_sz );
+    int close_err = close( fd );
+    if( read_err>=0 || -1==close_err || 0==manufacturer_sz ) continue;
+    manufacturer[ manufacturer_sz ] = '\0';
+
+    if( NULL!=strcasestr( manufacturer, "Supermicro" ) || NULL!=strcasestr( manufacturer, "Super Micro" ) ) {
+      if( is_intel ) {
+        return "Follow Supermicro's instructions at\n"
+               "    https://www.supermicro.com/en/support/faqs/faq.php?faq=31936";
+      }
+      if( is_amd ) {
+        return "Follow Supermicro's instructions at\n"
+               "    https://www.supermicro.com/en/support/faqs/faq.php?faq=31883";
+      }
+    }
+    if( NULL!=strcasestr( manufacturer, "Dell" ) ) {
+      if( is_intel ) {
+        return "This PowerEdge guide uses a Mellanox card, but the system and NIC BIOS\n"
+               "  changes are roughly the same for Intel NICs:\n"
+               "    https://enterprise-support.nvidia.com/s/article/howto-set-dell-poweredge-r730-bios-parameters-to-support-sr-iov";
+      }
+      if( is_amd ) {
+        return "This PowerEdge guide uses an Intel CPU and a Mellanox card, but the\n"
+               "  system and NIC BIOS changes are roughly the same for Intel NICs:\n"
+               "    https://enterprise-support.nvidia.com/s/article/howto-set-dell-poweredge-r730-bios-parameters-to-support-sr-iov";
+      }
+      return "Follow NVIDIA's PowerEdge SR-IOV configuration guide at\n"
+             "    https://enterprise-support.nvidia.com/s/article/howto-set-dell-poweredge-r730-bios-parameters-to-support-sr-iov";
+    }
+  }
+#endif
+  return fallback;
+}
+
+static char const *
+fd_iavf_iommu_diagnose( void ) {
+  char const * fallback = fd_iavf_sriov_bios_guide( 0 );
+
+#if FD_HAS_X86
+  char vendor[ 13 ];
+  if( !fd_iavf_cpu_vendor( vendor ) ) return fallback;
+  int is_intel = 0==strcmp( vendor, "GenuineIntel" );
+  int is_amd   = 0==strcmp( vendor, "AuthenticAMD" );
+
+  int cmdline_fd = open( "/proc/cmdline", O_RDONLY|O_CLOEXEC );
+  if( -1==cmdline_fd ) return fallback;
+
+  /* Read through EOF so a truncated command line cannot hide a later override. */
+  char cmdline[ 4096 ];
+  ulong cmdline_sz;
+  int read_err  = fd_io_read( cmdline_fd, cmdline, sizeof(cmdline), sizeof(cmdline), &cmdline_sz );
+  int close_err = close( cmdline_fd );
+  if( read_err>=0 || -1==close_err || 0==cmdline_sz ) return fallback;
+  cmdline[ cmdline_sz ] = '\0';
+
+  /* Match Linux's intel_iommu_setup, iommu_setup and parse_amd_iommu_options,
+     including prefix and substring matches. Intel's last on/off option wins. */
+  int iommu_off  = 0;
+  int intel_mode = -1;
+  int amd_off    = 0;
+  for( char * next=cmdline; *next; ) {
+    char * param;
+    char * value;
+    next = fd_iavf_cmdline_next( next, &param, &value );
+    if( NULL==next ) return fallback;
+    if( NULL==value ) {
+      if( 0==strcmp( param, "--" ) ) break;
+      continue;
+    }
+
+    if( is_amd && 0==strcmp( param, "amd_iommu" ) && NULL!=strstr( value, "off" ) ) amd_off = 1;
+    char * save;
+    for( char * opt=strtok_r( value, ",", &save ); NULL!=opt; opt=strtok_r( NULL, ",", &save ) ) {
+      if( 0==strcmp( param, "iommu" ) ) {
+        if( 0==strncmp( opt, "off", 3UL ) ) iommu_off = 1;
+        if( 0==strncmp( opt, "usedac", 6UL ) ) break;
+      } else if( is_intel && 0==strcmp( param, "intel_iommu" ) ) {
+        if(      0==strncmp( opt, "on",  2UL ) ) intel_mode = 1;
+        else if( 0==strncmp( opt, "off", 3UL ) ) intel_mode = 0;
+      }
+    }
+  }
+
+  if( iommu_off ) {
+    return "The iommu=off kernel boot argument disables IOMMU support, so remove it "
+           "from the boot arguments and reboot the machine";
+  }
+
+  if( is_intel && 0==intel_mode ) {
+    return "The intel_iommu=off kernel boot argument disables Intel IOMMU support, "
+           "so replace it with intel_iommu=on and reboot the machine";
+  }
+
+  if( is_amd && amd_off ) {
+    return "The amd_iommu=off kernel boot argument disables AMD IOMMU support, "
+           "so remove it from the boot arguments and reboot the machine";
+  }
+
+  if( is_intel && intel_mode<0 && fd_iavf_intel_iommu_default_off() ) {
+    return "Add intel_iommu=on to the kernel boot arguments and reboot the machine "
+           "to enable Intel IOMMU support";
+  }
+#endif
+  return fallback;
+}
+
+int
+fd_iavf_iommu_check( char const *  pf_if,
+                     char const ** diagnostic ) {
+  if( NULL!=diagnostic ) *diagnostic = NULL;
+
+  char path[ PATH_MAX ];
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/iommu_group", pf_if ) );
+  char resolved[ PATH_MAX ];
+  if( NULL!=realpath( path, resolved ) ) return 0;
+
+  int err = errno;
+  if( NULL!=diagnostic ) {
+    *diagnostic = err==ENOENT ? fd_iavf_iommu_diagnose()
+                             : "Check that the PF's iommu_group sysfs link is accessible "
+                               "so its IOMMU status can be determined";
+  }
+  errno = err;
+  return -1;
+}
+
+int
+fd_iavf_ari_check( char const * pf_if ) {
+  char path[ PATH_MAX ];
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/ari_enabled", pf_if ) );
+  ulong enabled;
+  if( FD_UNLIKELY( -1==fd_iavf_read_ulong( path, 10, &enabled ) ) ) return -1;
+  if( FD_UNLIKELY( enabled!=1UL ) ) {
+    errno = enabled==0UL ? EOPNOTSUPP : EPROTO;
+    return -1;
+  }
+  return 0;
+}
+
+int
+fd_iavf_numvfs_get( char const * pf_if,
+                    uint *       numvfs ) {
+  char path[ PATH_MAX ];
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/sriov_numvfs", pf_if ) );
+  ulong value;
+  if( FD_UNLIKELY( -1==fd_iavf_read_ulong( path, 10, &value ) ) ) return -1;
+  if( FD_UNLIKELY( value>UINT_MAX ) ) {
+    errno = EOVERFLOW;
+    return -1;
+  }
+  *numvfs = (uint)value;
+  return 0;
+}
+
+static int
+fd_iavf_sriov_bus_check( char const * pf_if ) {
+  char path[ PATH_MAX ];
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/sriov_offset", pf_if ) );
+  ulong vf_offset;
+  if( FD_UNLIKELY( -1==fd_iavf_read_ulong( path, 10, &vf_offset ) ) ) return -1;
+  if( FD_UNLIKELY( 0==vf_offset || vf_offset>USHRT_MAX ) ) {
+    errno = EPROTO;
+    return -1;
+  }
+
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device", pf_if ) );
+  char pci_addr[ FD_IAVF_PCI_ADDR_SZ ];
+  if( FD_UNLIKELY( -1==fd_iavf_read_link_name( pci_addr, sizeof(pci_addr), path, 0 ) ||
+                   -1==fd_iavf_pci_addr_normalize( pci_addr, pci_addr ) ) ) return -1;
+
+  ulong pf_bus      = strtoul( pci_addr+5,  NULL, 16 );
+  ulong pf_device   = strtoul( pci_addr+8,  NULL, 16 );
+  ulong pf_function = strtoul( pci_addr+11, NULL, 16 );
+  /* VF 0's function offset can carry into a higher PCI bus number */
+  ulong vf_bus = pf_bus+((pf_device*8UL+pf_function+vf_offset)>>8);
+  if( vf_bus==pf_bus ) return 0;
+
+  /* Check VF 0's bus against the parent bridge's assigned bus range */
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/../config", pf_if ) );
+  int fd = open( path, O_RDONLY|O_CLOEXEC );
+  if( FD_UNLIKELY( -1==fd ) ) return -1;
+  uchar config[ PCI_SUBORDINATE_BUS+1 ];
+  ssize_t read_sz = pread( fd, config, sizeof(config), 0 );
+  int     err     = 0;
+  if( FD_UNLIKELY( -1==read_sz ) )                         err = errno;
+  else if( FD_UNLIKELY( (ulong)read_sz!=sizeof(config) ) ) err = EPROTO;
+  if( FD_UNLIKELY( -1==close( fd ) && 0==err ) )           err = errno;
+  if( FD_UNLIKELY( 0!=err ) ) {
+    errno = err;
+    return -1;
+  }
+  if( FD_UNLIKELY( (config[ PCI_HEADER_TYPE ] & 0x7fU)!=PCI_HEADER_TYPE_BRIDGE ||
+                   config[ PCI_SECONDARY_BUS ]!=pf_bus ) ) {
+    errno = EPROTO;
+    return -1;
+  }
+  if( FD_UNLIKELY( vf_bus>config[ PCI_SUBORDINATE_BUS ] ) ) {
+    errno = ENOSPC;
+    return -1;
+  }
+  return 0;
+}
+
+int
+fd_iavf_sriov_resources_check( char const * pf_if ) {
+  if( FD_UNLIKELY( -1==fd_iavf_sriov_bus_check( pf_if ) ) ) return -1;
+
+  char path[ PATH_MAX ];
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/resource", pf_if ) );
+  FILE * file = fopen( path, "re" );
+  if( FD_UNLIKELY( NULL==file ) ) return -1;
+
+  int err = 0;
+  /* Linux lists VF BAR0 and BAR3 at resource indices 7 and 10 */
+  for( ulong resource_idx=0UL; resource_idx<13UL; resource_idx++ ) {
+    ulong start, end, flags;
+    errno = 0;
+    if( FD_UNLIKELY( fscanf( file, "%lx %lx %lx", &start, &end, &flags )!=3 ) ) {
+      err = ferror( file ) ? (0!=errno ? errno : EIO) : EPROTO;
+      break;
+    }
+    if( resource_idx!=7UL && resource_idx!=10UL ) continue;
+    if( FD_UNLIKELY( 0==start || end<start || !(flags & FD_IAVF_PCI_RESOURCE_MEM) ||
+                     (flags & FD_IAVF_PCI_RESOURCE_UNUSABLE) ) ) {
+      err = ENOMEM;
+      break;
+    }
+  }
+  if( FD_UNLIKELY( EOF==fclose( file ) && 0==err ) ) err = errno;
+  if( FD_UNLIKELY( 0!=err ) ) {
+    errno = err;
+    return -1;
+  }
+  return 0;
+}
+
+int
+fd_iavf_get_last_vf( char const * pf_if,
+                     uint *       vf_idx,
+                     char         vf_pci_addr[ FD_IAVF_PCI_ADDR_SZ ] ) {
+  /* Find the highest enabled VF index */
+  uint numvfs;
+  if( FD_UNLIKELY( -1==fd_iavf_numvfs_get( pf_if, &numvfs ) ) ) return -1;
+  if( FD_UNLIKELY( 0==numvfs ) ) {
+    errno = ENOENT;
+    return -1;
+  }
+  uint const last_vf_idx = numvfs-1U;
+
+  /* Read the PCI address from the PF's virtfn link */
+  char path[ PATH_MAX ];
+  FD_TEST( fd_cstr_printf_check( path, sizeof(path), NULL, "/sys/class/net/%s/device/virtfn%u", pf_if, last_vf_idx ) );
+  char pci_addr[ FD_IAVF_PCI_ADDR_SZ ];
+  if( FD_UNLIKELY( -1==fd_iavf_read_link_name( pci_addr, sizeof(pci_addr), path, 0 ) ) ) return -1;
+  if( FD_UNLIKELY( -1==fd_iavf_pci_addr_normalize( vf_pci_addr, pci_addr ) ) ) return -1;
+  if( NULL!=vf_idx ) *vf_idx = last_vf_idx;
+  return 0;
+}
+
+static int
+fd_iavf_iommu_group_check( char const * pci_addr,
+                           uint         iommu_group ) {
+  char devices_path[ PATH_MAX ];
+  int path_sz = snprintf( devices_path, sizeof(devices_path),
+                          "/sys/kernel/iommu_groups/%u/devices", iommu_group );
+  FD_TEST( path_sz>=0 && (ulong)path_sz<sizeof(devices_path) );
+
+  DIR * devices = opendir( devices_path );
+  if( FD_UNLIKELY( NULL==devices ) ) return -1;
+
+  ulong device_cnt = 0UL;
+  ulong match_cnt  = 0UL;
+  int   err        = 0;
+  for(;;) {
+    errno                 = 0;
+    struct dirent * entry = readdir( devices );
+    if( NULL==entry ) {
+      err = errno;
+      break;
+    }
+    if( entry->d_name[0]=='.' ) continue;
+    device_cnt++;
+    match_cnt += (ulong)(0==strcmp( entry->d_name, pci_addr ));
+  }
+  if( FD_UNLIKELY( -1==closedir( devices ) && 0==err ) ) err = errno;
+  if( FD_UNLIKELY( 0!=err ) ) {
+    errno = err;
+    return -1;
+  }
+  if( FD_UNLIKELY( device_cnt!=1UL || match_cnt!=1UL ) ) {
+    FD_LOG_WARNING(( "PCI %s is not alone in IOMMU group %u (%i-%s)", pci_addr, iommu_group, EBUSY, fd_io_strerror( EBUSY ) ));
+    errno = EBUSY;
+    return -1;
+  }
+  return 0;
+}
+
+int
+fd_iavf_pci_probe( fd_iavf_pci_info_t * info,
+                   char const *         pci_addr ) {
+  if( FD_UNLIKELY( NULL==info ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+  fd_memset( info, 0, sizeof(*info) );
+
+  fd_iavf_pci_info_t probed[1];
+  fd_memset( probed, 0, sizeof(probed) );
+  if( FD_UNLIKELY( -1==fd_iavf_pci_addr_normalize( probed->pci_addr, pci_addr ) ) ) return -1;
+
+  char device_path[ PATH_MAX ];
+  fd_iavf_path_join( device_path, FD_IAVF_PCI_SYSFS, probed->pci_addr );
+
+  /* Check Intel Ethernet VF identity */
+  char  path[ PATH_MAX ];
+  ulong value;
+  fd_iavf_path_join( path, device_path, "vendor" );
+  if( FD_UNLIKELY( -1==fd_iavf_read_ulong( path, 0, &value ) ) ) return -1;
+  if( FD_UNLIKELY( value!=0x8086UL ) ) {
+    FD_LOG_WARNING(( "PCI %s vendor %#lx is not Intel (%i-%s)", pci_addr, value, ENODEV, fd_io_strerror( ENODEV ) ));
+    errno = ENODEV;
+    return -1;
+  }
+
+  fd_iavf_path_join( path, device_path, "class" );
+  if( FD_UNLIKELY( -1==fd_iavf_read_ulong( path, 0, &value ) ) ) return -1;
+  if( FD_UNLIKELY( value!=0x020000UL ) ) {
+    FD_LOG_WARNING(( "PCI %s class %#lx is not Ethernet (%i-%s)", pci_addr, value, ENODEV, fd_io_strerror( ENODEV ) ));
+    errno = ENODEV;
+    return -1;
+  }
+
+  fd_iavf_path_join( path, device_path, "device" );
+  if( FD_UNLIKELY( -1==fd_iavf_read_ulong( path, 0, &value ) ) ) return -1;
+  if( FD_UNLIKELY( value>USHRT_MAX ) ) {
+    FD_LOG_WARNING(( "PCI %s device ID %#lx exceeds 16 bits (%i-%s)", pci_addr, value, EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  probed->device_id = (ushort)value;
+  if( FD_UNLIKELY( !fd_iavf_device_supported( probed->device_id ) ) ) {
+    FD_LOG_WARNING(( "unsupported Intel VF device %#x (%i-%s)", (uint)probed->device_id, ENODEV, fd_io_strerror( ENODEV ) ));
+    errno = ENODEV;
+    return -1;
+  }
+
+  /* Confirm the VF's parent PF and IOMMU isolation */
+  char pf_addr[ FD_IAVF_PCI_ADDR_SZ ];
+  fd_iavf_path_join( path, device_path, "physfn" );
+  if( FD_UNLIKELY( -1==fd_iavf_read_link_name( pf_addr, sizeof(pf_addr), path, 0 ) ||
+                   -1==fd_iavf_pci_addr_normalize( probed->pf_pci_addr, pf_addr ) ) ) {
+    if( errno==ENOENT ) errno = ENODEV;
+    return -1;
+  }
+
+  char iommu_group_name[ 32 ];
+  fd_iavf_path_join( path, device_path, "iommu_group" );
+  if( FD_UNLIKELY( -1==fd_iavf_read_link_name( iommu_group_name, sizeof(iommu_group_name), path, 0 ) ) ) return -1;
+  errno = 0;
+  char * end;
+  ulong iommu_group = strtoul( iommu_group_name, &end, 10 );
+  if( FD_UNLIKELY( 0!=errno || *end || iommu_group>UINT_MAX ) ) {
+    int err = 0!=errno ? errno : EPROTO;
+    FD_LOG_WARNING(( "invalid IOMMU group for PCI %s (%i-%s)", pci_addr, err, fd_io_strerror( err ) ));
+    errno = err;
+    return -1;
+  }
+  probed->iommu_group = (uint)iommu_group;
+  if( FD_UNLIKELY( -1==fd_iavf_iommu_group_check( probed->pci_addr, probed->iommu_group ) ) ) return -1;
+
+  fd_iavf_path_join( path, device_path, "driver" );
+  if( FD_UNLIKELY( -1==fd_iavf_read_link_name( probed->driver, sizeof(probed->driver), path, 1 ) ) ) return -1;
+
+  *info = *probed;
+  return 0;
+}
+
+static void
+fd_iavf_vfio_cleanup( fd_iavf_vfio_t * vfio,
+                      int              container_set ) {
+  if( NULL!=vfio->bar0 ) munmap( (void *)vfio->bar0, FD_IAVF_BAR0_MAP_SZ );
+  if( vfio->device_fd>=0 ) close( vfio->device_fd );
+  if( container_set ) ioctl( vfio->group_fd, VFIO_GROUP_UNSET_CONTAINER );
+  if( vfio->group_fd>=0 )     close( vfio->group_fd );
+  if( vfio->container_fd>=0 ) close( vfio->container_fd );
+  vfio->bar0         = NULL;
+  vfio->device_fd    = -1;
+  vfio->group_fd     = -1;
+  vfio->container_fd = -1;
+}
+
+static int
+fd_iavf_vfio_wait_reset( fd_iavf_vfio_t * vfio ) {
+  volatile uint const * reset_reg = (volatile uint const *)(vfio->bar0 + FD_IAVF_VFGEN_RSTAT);
+  struct timespec       delay     = { .tv_sec=0L, .tv_nsec=FD_IAVF_POLL_INTERVAL_NS };
+  for( ulong retry=0UL; retry<FD_IAVF_RESET_RETRY_CNT; retry++ ) {
+    uint reset_state = *reset_reg & FD_IAVF_VFGEN_RSTAT_STATE;
+    if( reset_state==FD_IAVF_VFR_STATE_COMPLETED ||
+        reset_state==FD_IAVF_VFR_STATE_ACTIVE ) {
+      return 0;
+    }
+    if( FD_UNLIKELY( -1==nanosleep( &delay, NULL ) && errno!=EINTR ) ) return -1;
+  }
+  errno = ETIMEDOUT;
+  return -1;
+}
+
+static int
+fd_iavf_vfio_enable_pci( fd_iavf_vfio_t * vfio ) {
+  struct vfio_region_info config = {
+    .argsz = sizeof(config),
+    .index = VFIO_PCI_CONFIG_REGION_INDEX
+  };
+  if( FD_UNLIKELY( -1==ioctl( vfio->device_fd, VFIO_DEVICE_GET_REGION_INFO, &config ) ) ) return -1;
+  if( FD_UNLIKELY( config.size<PCI_COMMAND+sizeof(ushort) || config.offset>(ulong)LLONG_MAX-PCI_COMMAND ) ) {
+    errno = EPROTO;
+    return -1;
+  }
+
+  off_t command_off = (off_t)(config.offset+PCI_COMMAND);
+  ushort command;
+  errno = 0;
+  if( FD_UNLIKELY( pread( vfio->device_fd, &command, sizeof(command), command_off )!=(ssize_t)sizeof(command) ) ) {
+    if( 0==errno ) errno = EIO;
+    return -1;
+  }
+  command = (ushort)(command | PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER);
+  errno   = 0;
+  if( FD_UNLIKELY( pwrite( vfio->device_fd, &command, sizeof(command), command_off )!=(ssize_t)sizeof(command) ) ) {
+    if( 0==errno ) errno = EIO;
+    return -1;
+  }
+  ushort enabled;
+  errno = 0;
+  if( FD_UNLIKELY( pread( vfio->device_fd, &enabled, sizeof(enabled), command_off )!=(ssize_t)sizeof(enabled) ) ) {
+    if( 0==errno ) errno = EIO;
+    return -1;
+  }
+  if( FD_UNLIKELY( (enabled & (PCI_COMMAND_MEMORY|PCI_COMMAND_MASTER))!=(PCI_COMMAND_MEMORY|PCI_COMMAND_MASTER) ) ) {
+    errno = EIO;
+    return -1;
+  }
+  return 0;
+}
+
+int
+fd_iavf_vfio_map_bar( fd_iavf_vfio_t * vfio ) {
+  if( FD_UNLIKELY( NULL==vfio || vfio->device_fd<0 ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+  struct vfio_region_info bar0 = {
+    .argsz = sizeof(bar0),
+    .index = VFIO_PCI_BAR0_REGION_INDEX
+  };
+  if( FD_UNLIKELY( -1==ioctl( vfio->device_fd, VFIO_DEVICE_GET_REGION_INFO, &bar0 ) ) ) return -1;
+  if( FD_UNLIKELY( bar0.size<FD_IAVF_BAR0_MAP_SZ || bar0.offset>(ulong)LLONG_MAX ||
+                    !(bar0.flags & VFIO_REGION_INFO_FLAG_READ) ||
+                    !(bar0.flags & VFIO_REGION_INFO_FLAG_WRITE) ||
+                    !(bar0.flags & VFIO_REGION_INFO_FLAG_MMAP) ) ) {
+    errno = EOPNOTSUPP;
+    return -1;
+  }
+
+  void * bar0_map = mmap( NULL, FD_IAVF_BAR0_MAP_SZ, PROT_READ|PROT_WRITE,
+                          MAP_SHARED, vfio->device_fd, (off_t)bar0.offset );
+  if( FD_UNLIKELY( bar0_map==MAP_FAILED ) ) return -1;
+  vfio->bar0 = (volatile uchar *)bar0_map;
+
+  return 0;
+}
+
+int
+fd_iavf_vfio_unmap_bar( fd_iavf_vfio_t * vfio ) {
+  if( FD_UNLIKELY( -1==munmap( (void *)vfio->bar0, FD_IAVF_BAR0_MAP_SZ ) ) ) return -1;
+  vfio->bar0 = NULL;
+  return 0;
+}
+
+static int
+fd_iavf_vfio_init( fd_iavf_vfio_t *           vfio,
+                   fd_iavf_pci_info_t const * info ) {
+  if( FD_UNLIKELY( 0!=strcmp( info->driver, "vfio-pci" ) ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  *vfio = (fd_iavf_vfio_t) {
+    .container_fd = -1,
+    .group_fd     = -1,
+    .device_fd    = -1
+  };
+  int          container_set = 0;
+  char const * operation     = "open(/dev/vfio/vfio)";
+
+  /* Check VFIO API and IOMMU support */
+  vfio->container_fd = open( "/dev/vfio/vfio", O_RDWR|O_CLOEXEC );
+  if( FD_UNLIKELY( -1==vfio->container_fd ) ) goto fail;
+  operation       = "VFIO_GET_API_VERSION";
+  int api_version = ioctl( vfio->container_fd, VFIO_GET_API_VERSION );
+  if( FD_UNLIKELY( -1==api_version ) ) goto fail;
+  if( FD_UNLIKELY( api_version!=VFIO_API_VERSION ) ) {
+    operation = "unsupported VFIO API version";
+    errno     = EPROTONOSUPPORT;
+    goto fail;
+  }
+  operation             = "VFIO_CHECK_EXTENSION(TYPE1v2)";
+  int type1v2_supported = ioctl( vfio->container_fd, VFIO_CHECK_EXTENSION, VFIO_TYPE1v2_IOMMU );
+  if( FD_UNLIKELY( -1==type1v2_supported ) ) goto fail;
+  if( FD_UNLIKELY( !type1v2_supported ) ) {
+    operation = "VFIO TYPE1v2 IOMMU unsupported";
+    errno     = EPROTONOSUPPORT;
+    goto fail;
+  }
+
+  /* Attach the VF's IOMMU group to this container */
+  char group_path[ 64 ];
+  int group_path_sz = snprintf( group_path, sizeof(group_path), "/dev/vfio/%u", info->iommu_group );
+  FD_TEST( group_path_sz>=0 && (ulong)group_path_sz<sizeof(group_path) );
+  operation      = "open VFIO group";
+  vfio->group_fd = open( group_path, O_RDWR|O_CLOEXEC );
+  if( FD_UNLIKELY( -1==vfio->group_fd ) ) goto fail;
+
+  operation                             = "VFIO_GROUP_GET_STATUS";
+  struct vfio_group_status group_status = { .argsz=sizeof(group_status) };
+  if( FD_UNLIKELY( -1==ioctl( vfio->group_fd, VFIO_GROUP_GET_STATUS, &group_status ) ) ) goto fail;
+  if( FD_UNLIKELY( !(group_status.flags & VFIO_GROUP_FLAGS_VIABLE) ) ) {
+    operation = "VFIO group not viable";
+    errno     = EBUSY;
+    goto fail;
+  }
+  if( FD_UNLIKELY( (group_status.flags & VFIO_GROUP_FLAGS_CONTAINER_SET) ) ) {
+    operation = "VFIO group already has a container";
+    errno     = EBUSY;
+    goto fail;
+  }
+  operation = "VFIO_GROUP_SET_CONTAINER";
+  if( FD_UNLIKELY( -1==ioctl( vfio->group_fd, VFIO_GROUP_SET_CONTAINER, &vfio->container_fd ) ) ) goto fail;
+  container_set = 1;
+  operation     = "VFIO_SET_IOMMU";
+  if( FD_UNLIKELY( -1==ioctl( vfio->container_fd, VFIO_SET_IOMMU, VFIO_TYPE1v2_IOMMU ) ) ) goto fail;
+
+  /* Query page sizes for DMA mappings */
+  operation                               = "VFIO_IOMMU_GET_INFO";
+  struct vfio_iommu_type1_info iommu_info = { .argsz=sizeof(iommu_info) };
+  if( FD_UNLIKELY( -1==ioctl( vfio->container_fd, VFIO_IOMMU_GET_INFO, &iommu_info ) ) ) goto fail;
+  if( FD_UNLIKELY( !(iommu_info.flags & VFIO_IOMMU_INFO_PGSIZES) || 0==iommu_info.iova_pgsizes ) ) {
+    operation = "VFIO IOMMU page sizes missing";
+    errno     = EPROTO;
+    goto fail;
+  }
+  vfio->iova_pgsizes = (ulong)iommu_info.iova_pgsizes;
+
+  /* Open the VF and map its registers */
+  operation       = "VFIO_GROUP_GET_DEVICE_FD";
+  vfio->device_fd = ioctl( vfio->group_fd, VFIO_GROUP_GET_DEVICE_FD, info->pci_addr );
+  if( FD_UNLIKELY( -1==vfio->device_fd ) ) goto fail;
+
+  operation                           = "VFIO_DEVICE_GET_INFO";
+  struct vfio_device_info device_info = { .argsz=sizeof(device_info) };
+  if( FD_UNLIKELY( -1==ioctl( vfio->device_fd, VFIO_DEVICE_GET_INFO, &device_info ) ) ) goto fail;
+  if( FD_UNLIKELY( !(device_info.flags & VFIO_DEVICE_FLAGS_PCI) ||
+                    !(device_info.flags & VFIO_DEVICE_FLAGS_RESET) ) ) {
+    operation = "VFIO device lacks PCI or reset support";
+    errno     = EOPNOTSUPP;
+    goto fail;
+  }
+  if( FD_UNLIKELY( device_info.num_regions<=VFIO_PCI_BAR0_REGION_INDEX ) ) {
+    operation = "VFIO BAR0 region missing";
+    errno     = EPROTO;
+    goto fail;
+  }
+
+  operation = "VFIO BAR0 mapping";
+  if( FD_UNLIKELY( -1==fd_iavf_vfio_map_bar( vfio ) ) ) goto fail;
+
+  /* Reset the VF and wait for the PF to report it ready */
+  operation = "VFIO_DEVICE_RESET";
+  if( FD_UNLIKELY( -1==ioctl( vfio->device_fd, VFIO_DEVICE_RESET ) ) ) goto fail;
+  operation = "VF reset wait";
+  if( FD_UNLIKELY( -1==fd_iavf_vfio_wait_reset( vfio ) ) ) goto fail;
+  operation = "PCI memory and bus mastering enable";
+  if( FD_UNLIKELY( -1==fd_iavf_vfio_enable_pci( vfio ) ) ) goto fail;
+  return 0;
+
+fail:
+  {
+    int err = errno;
+    FD_LOG_WARNING(( "%s failed for PCI %s (%i-%s)", operation, info->pci_addr, err, fd_io_strerror( err ) ));
+    fd_iavf_vfio_cleanup( vfio, container_set );
+    errno = err;
+    return -1;
+  }
+}
+
+int
+fd_iavf_vfio_dma_map( fd_iavf_vfio_t * vfio,
+                      void *           memory,
+                      ulong            memory_sz,
+                      ulong            iova ) {
+  if( FD_UNLIKELY( NULL==vfio || vfio->container_fd<0 || NULL==memory || 0==memory_sz || 0==vfio->iova_pgsizes ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  /* The smallest supported IOMMU page size sets mapping alignment */
+  ulong page_sz = vfio->iova_pgsizes & -vfio->iova_pgsizes;
+  if( FD_UNLIKELY( !fd_ulong_is_aligned( (ulong)memory, page_sz ) ||
+                   !fd_ulong_is_aligned( memory_sz,     page_sz ) ||
+                   !fd_ulong_is_aligned( iova,          page_sz ) ||
+                   (ulong)memory>ULONG_MAX-memory_sz ||
+                   memory_sz>ULONG_MAX-iova ) ) {
+    FD_LOG_WARNING(( "invalid DMA mapping bounds or alignment, memory %p, size %lu, IOVA %#lx, required alignment %lu", memory, memory_sz, iova, page_sz ));
+    errno = EINVAL;
+    return -1;
+  }
+
+  struct vfio_iommu_type1_dma_map dma_map = {
+    .argsz = sizeof(dma_map),
+    .flags = VFIO_DMA_MAP_FLAG_READ|VFIO_DMA_MAP_FLAG_WRITE,
+    .vaddr = (ulong)memory,
+    .iova  = iova,
+    .size  = memory_sz
+  };
+  if( FD_UNLIKELY( -1==ioctl( vfio->container_fd, VFIO_IOMMU_MAP_DMA, &dma_map ) ) ) {
+    int err = errno;
+    FD_LOG_WARNING(( "VFIO_IOMMU_MAP_DMA failed, size %lu, IOVA %#lx (%i-%s)", memory_sz, iova, err, fd_io_strerror( err ) ));
+    errno = err;
+    return -1;
+  }
+  return 0;
+}
+
+static inline uint
+fd_iavf_mmio_read( fd_iavf_vfio_t const * vfio,
+                   ulong                  reg ) {
+  volatile uint const * ptr   = (volatile uint const *)(vfio->bar0 + reg);
+  uint                  value = *ptr;
+  FD_COMPILER_MFENCE();
+  return value;
+}
+
+static inline void
+fd_iavf_mmio_write( fd_iavf_vfio_t * vfio,
+                    ulong            reg,
+                    uint             value ) {
+  FD_COMPILER_MFENCE();
+  volatile uint * ptr = (volatile uint *)(vfio->bar0 + reg);
+  *ptr                = value;
+  FD_COMPILER_MFENCE();
+}
+
+static int
+fd_iavf_mmio_verify( fd_iavf_vfio_t const * vfio,
+                     ulong                  reg,
+                     uint                   expected ) {
+  uint const actual = fd_iavf_mmio_read( vfio, reg );
+  if( FD_UNLIKELY( actual!=expected ) ) {
+    FD_LOG_WARNING(( "register %#lx read %#x, expected %#x (%i-%s)", reg, actual, expected, EIO, fd_io_strerror( EIO ) ));
+    errno = EIO;
+    return -1;
+  }
+  return 0;
+}
+
+static inline fd_iavf_aq_desc_t *
+fd_iavf_adminq_atq_desc( fd_iavf_adminq_t * adminq,
+                         uint               idx ) {
+  return (fd_iavf_aq_desc_t *)((uchar *)adminq->dma_memory + FD_IAVF_ADMINQ_SEND_DESC_OFF) + idx;
+}
+
+static inline fd_iavf_aq_desc_t *
+fd_iavf_adminq_arq_desc( fd_iavf_adminq_t * adminq,
+                         uint               idx ) {
+  return (fd_iavf_aq_desc_t *)((uchar *)adminq->dma_memory + FD_IAVF_ADMINQ_RECV_DESC_OFF) + idx;
+}
+
+static inline uchar *
+fd_iavf_adminq_atq_buf( fd_iavf_adminq_t * adminq,
+                        uint               idx ) {
+  return (uchar *)adminq->dma_memory + FD_IAVF_ADMINQ_SEND_BUF_OFF + (ulong)idx*FD_IAVF_ADMINQ_BUF_SZ;
+}
+
+static inline uchar *
+fd_iavf_adminq_arq_buf( fd_iavf_adminq_t * adminq,
+                        uint               idx ) {
+  return (uchar *)adminq->dma_memory + FD_IAVF_ADMINQ_RECV_BUF_OFF + (ulong)idx*FD_IAVF_ADMINQ_BUF_SZ;
+}
+
+static inline ulong
+fd_iavf_adminq_atq_buf_iova( fd_iavf_adminq_t const * adminq,
+                             uint                     idx ) {
+  return adminq->dma_iova + FD_IAVF_ADMINQ_SEND_BUF_OFF + (ulong)idx*FD_IAVF_ADMINQ_BUF_SZ;
+}
+
+static inline ulong
+fd_iavf_adminq_arq_buf_iova( fd_iavf_adminq_t const * adminq,
+                             uint                     idx ) {
+  return adminq->dma_iova + FD_IAVF_ADMINQ_RECV_BUF_OFF + (ulong)idx*FD_IAVF_ADMINQ_BUF_SZ;
+}
+
+static inline void
+fd_iavf_adminq_desc_set_addr( fd_iavf_aq_desc_t * desc,
+                              ulong               iova ) {
+  desc->addr_high = (uint)(iova>>32);
+  desc->addr_low  = (uint)iova;
+}
+
+static void
+fd_iavf_adminq_arq_post( fd_iavf_adminq_t * adminq,
+                         uint               idx ) {
+  fd_iavf_aq_desc_t * desc = fd_iavf_adminq_arq_desc( adminq, idx );
+  fd_memset( desc, 0, sizeof(*desc) );
+  desc->flags   = FD_IAVF_AQ_FLAG_BUF|FD_IAVF_AQ_FLAG_LB;
+  desc->datalen = FD_IAVF_ADMINQ_BUF_SZ;
+  fd_iavf_adminq_desc_set_addr( desc, fd_iavf_adminq_arq_buf_iova( adminq, idx ) );
+}
+
+ulong
+fd_iavf_adminq_footprint( void ) {
+  return FD_IAVF_ADMINQ_FOOTPRINT;
+}
+
+static int
+fd_iavf_adminq_init( fd_iavf_vfio_t *   vfio,
+                     fd_iavf_adminq_t * adminq,
+                     void *             dma_memory,
+                     ulong              dma_iova ) {
+  if( FD_UNLIKELY( NULL==dma_memory ||
+                   !fd_ulong_is_aligned( (ulong)dma_memory, FD_IAVF_PAGE_SZ ) ||
+                   !fd_ulong_is_aligned( dma_iova,          FD_IAVF_PAGE_SZ ) ||
+                   0==(vfio->iova_pgsizes & FD_IAVF_PAGE_SZ) ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  /* Map Admin Queue rings and prepare receive buffers */
+  fd_memset( dma_memory, 0, FD_IAVF_ADMINQ_FOOTPRINT );
+  if( FD_UNLIKELY( -1==fd_iavf_vfio_dma_map( vfio, dma_memory, FD_IAVF_ADMINQ_FOOTPRINT, dma_iova ) ) ) return -1;
+
+  *adminq = (fd_iavf_adminq_t) {
+    .dma_memory = dma_memory,
+    .dma_iova   = dma_iova
+  };
+  for( uint idx=0U; idx<(uint)FD_IAVF_ADMINQ_DEPTH; idx++ ) fd_iavf_adminq_arq_post( adminq, idx );
+  fd_iavf_hw_dma_to_device();
+
+  /* Enable ATQ for outgoing PF requests */
+  ulong atq_iova = dma_iova + FD_IAVF_ADMINQ_SEND_DESC_OFF;
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ATQH,   0U );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ATQT,   0U );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ATQLEN, (uint)FD_IAVF_ADMINQ_DEPTH|FD_IAVF_ATQ_ENABLE );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ATQBAL, (uint)atq_iova );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ATQBAH, (uint)(atq_iova>>32) );
+
+  /* Enable ARQ and post buffers for PF replies and events */
+  ulong arq_iova = dma_iova + FD_IAVF_ADMINQ_RECV_DESC_OFF;
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ARQH,   0U );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ARQT,   0U );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ARQLEN, (uint)FD_IAVF_ADMINQ_DEPTH|FD_IAVF_ARQ_ENABLE );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ARQBAL, (uint)arq_iova );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ARQBAH, (uint)(arq_iova>>32) );
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ARQT,   (uint)FD_IAVF_ADMINQ_DEPTH-1U );
+
+  if( FD_UNLIKELY( -1==fd_iavf_mmio_verify( vfio, FD_IAVF_VF_ATQBAL, (uint)atq_iova ) ||
+                   -1==fd_iavf_mmio_verify( vfio, FD_IAVF_VF_ATQBAH, (uint)(atq_iova>>32) ) ||
+                   -1==fd_iavf_mmio_verify( vfio, FD_IAVF_VF_ARQBAL, (uint)arq_iova ) ||
+                   -1==fd_iavf_mmio_verify( vfio, FD_IAVF_VF_ARQBAH, (uint)(arq_iova>>32) ) ||
+                   -1==fd_iavf_mmio_verify( vfio, FD_IAVF_VF_ATQLEN, (uint)FD_IAVF_ADMINQ_DEPTH|FD_IAVF_ATQ_ENABLE ) ||
+                   -1==fd_iavf_mmio_verify( vfio, FD_IAVF_VF_ARQLEN, (uint)FD_IAVF_ADMINQ_DEPTH|FD_IAVF_ARQ_ENABLE ) ) ) return -1;
+  return 0;
+}
+
+static char const *
+fd_iavf_virtchnl_op_name( uint op ) {
+  switch( op ) {
+  case FD_IAVF_VIRTCHNL_VERSION:         return "version exchange";
+  case FD_IAVF_VIRTCHNL_GET_VF_RESOURCES: return "VF resource discovery";
+  case FD_IAVF_VIRTCHNL_CONFIG_QUEUES:    return "queue configuration";
+  case FD_IAVF_VIRTCHNL_CONFIG_IRQ_MAP:   return "IRQ mapping";
+  case FD_IAVF_VIRTCHNL_ENABLE_QUEUES:    return "queue enable";
+  case FD_IAVF_VIRTCHNL_ADD_ETH_ADDR:     return "MAC registration";
+  case FD_IAVF_VIRTCHNL_CONFIG_RSS_KEY:   return "RSS key configuration";
+  case FD_IAVF_VIRTCHNL_CONFIG_RSS_LUT:   return "RSS table configuration";
+  default:                              return "virtchnl request";
+  }
+}
+
+static int
+fd_iavf_adminq_send( fd_iavf_vfio_t *   vfio,
+                     fd_iavf_adminq_t * adminq,
+                     uint               virtchnl_op,
+                     void const *       message,
+                     ulong              message_sz ) {
+  uint                idx  = adminq->atq_prod;
+  uint                next = (idx+1U) & ((uint)FD_IAVF_ADMINQ_DEPTH-1U);
+  fd_iavf_aq_desc_t * desc = fd_iavf_adminq_atq_desc( adminq, idx );
+  fd_memset( desc, 0, sizeof(*desc) );
+  desc->flags       = FD_IAVF_AQ_FLAG_SI;
+  desc->opcode      = FD_IAVF_AQ_SEND_MSG_TO_PF;
+  desc->cookie_high = virtchnl_op;
+  if( 0!=message_sz ) {
+    fd_memcpy( fd_iavf_adminq_atq_buf( adminq, idx ), message, message_sz );
+    desc->flags   |= FD_IAVF_AQ_FLAG_BUF|FD_IAVF_AQ_FLAG_RD;
+    /* Match Linux IAVF's descriptor flags for large requests. */
+    if( message_sz>FD_IAVF_AQ_LARGE_BUF ) desc->flags |= FD_IAVF_AQ_FLAG_LB;
+    desc->datalen = (ushort)message_sz;
+    fd_iavf_adminq_desc_set_addr( desc, fd_iavf_adminq_atq_buf_iova( adminq, idx ) );
+  }
+  /* Publish the descriptor and payload before advancing ATQ tail */
+  fd_iavf_hw_dma_to_device();
+  adminq->atq_prod = next;
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ATQT, next );
+
+  /* Wait for send completion, the PF's reply arrives separately on ARQ */
+  struct timespec delay = { .tv_sec=0L, .tv_nsec=FD_IAVF_POLL_INTERVAL_NS };
+  for( ulong retry=0UL; retry<FD_IAVF_ADMINQ_RETRY_CNT; retry++ ) {
+    if( (fd_iavf_mmio_read( vfio, FD_IAVF_VF_ATQH ) & FD_IAVF_ATQ_HEAD)==next ) {
+      fd_iavf_hw_dma_from_device();
+      if( FD_UNLIKELY( (desc->flags & FD_IAVF_AQ_FLAG_ERR) || 0!=desc->retval ) ) {
+        FD_LOG_WARNING(( "%s Admin Queue send failed, status %hu (%i-%s)", fd_iavf_virtchnl_op_name( virtchnl_op ), desc->retval, EIO, fd_io_strerror( EIO ) ));
+        errno = EIO;
+        return -1;
+      }
+      return 0;
+    }
+    if( FD_UNLIKELY( -1==nanosleep( &delay, NULL ) && errno!=EINTR ) ) {
+      int err = errno;
+      FD_LOG_WARNING(( "%s send wait failed (%i-%s)", fd_iavf_virtchnl_op_name( virtchnl_op ), err, fd_io_strerror( err ) ));
+      errno = err;
+      return -1;
+    }
+  }
+  FD_LOG_WARNING(( "%s Admin Queue send timed out (%i-%s)", fd_iavf_virtchnl_op_name( virtchnl_op ), ETIMEDOUT, fd_io_strerror( ETIMEDOUT ) ));
+  errno = ETIMEDOUT;
+  return -1;
+}
+
+static int
+fd_iavf_adminq_recv( fd_iavf_vfio_t *   vfio,
+                     fd_iavf_adminq_t * adminq,
+                     uint *             virtchnl_op,
+                     int *              virtchnl_status,
+                     void *             message,
+                     ulong *            message_sz ) {
+  uint head = fd_iavf_mmio_read( vfio, FD_IAVF_VF_ARQH ) & FD_IAVF_ARQ_HEAD;
+  uint idx  = adminq->arq_cons;
+  if( head==idx ) return 0;
+
+  /* Read the message before returning its buffer to the NIC */
+  fd_iavf_hw_dma_from_device();
+  fd_iavf_aq_desc_t * desc      = fd_iavf_adminq_arq_desc( adminq, idx );
+  fd_iavf_aq_desc_t   comp_desc = *desc;
+  ulong               comp_sz   = comp_desc.datalen;
+  int                 err       = 0;
+  if( FD_UNLIKELY( comp_desc.opcode!=FD_IAVF_AQ_SEND_MSG_TO_VF ||
+                   (comp_desc.flags & FD_IAVF_AQ_FLAG_ERR) || 0!=comp_desc.retval ) ) err = EIO;
+  else if( FD_UNLIKELY( comp_sz>*message_sz ) ) err = EMSGSIZE;
+  else if( 0!=comp_sz ) fd_memcpy( message, fd_iavf_adminq_arq_buf( adminq, idx ), comp_sz );
+
+  /* ARQ tail names the last returned descriptor */
+  fd_iavf_adminq_arq_post( adminq, idx );
+  fd_iavf_hw_dma_to_device();
+  fd_iavf_mmio_write( vfio, FD_IAVF_VF_ARQT, idx );
+  adminq->arq_cons = (idx+1U) & ((uint)FD_IAVF_ADMINQ_DEPTH-1U);
+
+  if( FD_UNLIKELY( 0!=err ) ) {
+    errno = err;
+    return -1;
+  }
+  *virtchnl_op     = comp_desc.cookie_high;
+  *virtchnl_status = (int)comp_desc.cookie_low;
+  *message_sz      = comp_sz;
+  return 1;
+}
+
+static int
+fd_iavf_virtchnl_cache_event( fd_iavf_adminq_t * adminq,
+                              uint               op,
+                              int                status,
+                              void const *       message,
+                              ulong              message_sz ) {
+  if( FD_UNLIKELY( op!=FD_IAVF_VIRTCHNL_EVENT || 0!=status ||
+                   message_sz!=sizeof(fd_iavf_virtchnl_event_t) ) ) {
+    FD_LOG_WARNING(( "invalid PF event, operation %u, status %i, size %lu, expected %lu (%i-%s)",
+                     op, status, message_sz, sizeof(fd_iavf_virtchnl_event_t), EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  fd_iavf_virtchnl_event_t event;
+  fd_memcpy( &event, message, sizeof(event) );
+  if( FD_UNLIKELY( event.event==FD_IAVF_EVENT_RESET_IMPENDING ) ) {
+    FD_LOG_WARNING(( "PF reset impending (%i-%s)", ECONNRESET, fd_io_strerror( ECONNRESET ) ));
+    errno = ECONNRESET;
+    return -1;
+  }
+  if( FD_UNLIKELY( event.event==FD_IAVF_EVENT_PF_DRIVER_CLOSE ) ) {
+    FD_LOG_WARNING(( "PF driver closed (%i-%s)", ESHUTDOWN, fd_io_strerror( ESHUTDOWN ) ));
+    errno = ESHUTDOWN;
+    return -1;
+  }
+  /* Keep early link reports until resource discovery can apply them */
+  fd_memcpy( adminq->pending_event, message, message_sz );
+  adminq->pending_event_sz = message_sz;
+  return 0;
+}
+
+static int
+fd_iavf_virtchnl_request( fd_iavf_vfio_t *   vfio,
+                          fd_iavf_adminq_t * adminq,
+                          uint               virtchnl_op,
+                          void const *       request,
+                          ulong              request_sz,
+                          void *             response,
+                          ulong *            response_sz ) {
+  ulong response_capacity = *response_sz;
+  *response_sz            = 0UL;
+  if( FD_UNLIKELY( -1==fd_iavf_adminq_send( vfio, adminq, virtchnl_op, request, request_sz ) ) ) return -1;
+
+  struct timespec delay = { .tv_sec=0L, .tv_nsec=FD_IAVF_POLL_INTERVAL_NS };
+  for( ulong retry=0UL; retry<FD_IAVF_ADMINQ_RETRY_CNT; retry++ ) {
+    uchar message[ FD_IAVF_ADMINQ_BUF_SZ ];
+    ulong message_sz = sizeof(message);
+    uint received_op;
+    int  received_status;
+    int received = fd_iavf_adminq_recv( vfio, adminq, &received_op, &received_status,
+                                        message, &message_sz );
+    if( FD_UNLIKELY( -1==received ) ) goto fail;
+    if( 0==received ) {
+      if( FD_UNLIKELY( -1==nanosleep( &delay, NULL ) && errno!=EINTR ) ) goto fail;
+      continue;
+    }
+    /* PF events can arrive before the request's reply */
+    if( received_op==FD_IAVF_VIRTCHNL_EVENT ) {
+      if( FD_UNLIKELY( -1==fd_iavf_virtchnl_cache_event( adminq, received_op, received_status,
+                                                         message, message_sz ) ) ) return -1;
+      continue;
+    }
+    if( FD_UNLIKELY( received_op!=virtchnl_op ) ) {
+      FD_LOG_WARNING(( "unexpected PF operation %u during %s (%i-%s)", received_op, fd_iavf_virtchnl_op_name( virtchnl_op ), EPROTO, fd_io_strerror( EPROTO ) ));
+      errno = EPROTO;
+      return -1;
+    }
+    if( FD_UNLIKELY( 0!=received_status ) ) {
+      FD_LOG_WARNING(( "%s rejected, PF status %i (%i-%s)", fd_iavf_virtchnl_op_name( virtchnl_op ), received_status, EIO, fd_io_strerror( EIO ) ));
+      errno = EIO;
+      return -1;
+    }
+    if( FD_UNLIKELY( message_sz>response_capacity ) ) {
+      FD_LOG_WARNING(( "%s response size %lu exceeds %lu (%i-%s)", fd_iavf_virtchnl_op_name( virtchnl_op ), message_sz, response_capacity, EMSGSIZE, fd_io_strerror( EMSGSIZE ) ));
+      errno = EMSGSIZE;
+      return -1;
+    }
+    if( 0!=message_sz ) fd_memcpy( response, message, message_sz );
+    *response_sz = message_sz;
+    return 0;
+  }
+  errno = ETIMEDOUT;
+fail:
+  {
+    int err = errno;
+    FD_LOG_WARNING(( "%s PF reply failed (%i-%s)", fd_iavf_virtchnl_op_name( virtchnl_op ), err, fd_io_strerror( err ) ));
+    errno = err;
+    return -1;
+  }
+}
+
+int
+fd_iavf_virtchnl_version( fd_iavf_vfio_t *   vfio,
+                          fd_iavf_adminq_t * adminq ) {
+  fd_iavf_virtchnl_version_t requested = { .major=1U, .minor=1U };
+  fd_iavf_virtchnl_version_t response;
+  ulong response_sz = sizeof(response);
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_VERSION,
+                                                 &requested, sizeof(requested),
+                                                 &response, &response_sz ) ) ) return -1;
+  if( FD_UNLIKELY( response_sz!=sizeof(response) ) ) {
+    FD_LOG_WARNING(( "unsupported virtchnl version reply, size %lu (%i-%s)", response_sz, EPROTONOSUPPORT, fd_io_strerror( EPROTONOSUPPORT ) ));
+    errno = EPROTONOSUPPORT;
+    return -1;
+  }
+  if( FD_UNLIKELY( response.major!=1U || response.minor!=1U ) ) {
+    FD_LOG_WARNING(( "unsupported virtchnl version %u.%u (%i-%s)", response.major, response.minor, EPROTONOSUPPORT, fd_io_strerror( EPROTONOSUPPORT ) ));
+    errno = EPROTONOSUPPORT;
+    return -1;
+  }
+  return 0;
+}
+
+/* fd_iavf_virtchnl_apply_event returns 1 for a link report, including down */
+static int
+fd_iavf_virtchnl_apply_event( fd_iavf_adminq_t *  adminq,
+                             fd_iavf_vf_info_t * info ) {
+  if( 0==adminq->pending_event_sz ) return 0;
+  fd_iavf_virtchnl_event_t event;
+  fd_memcpy( &event, adminq->pending_event, sizeof(event) );
+  adminq->pending_event_sz = 0UL;
+  if( event.event==FD_IAVF_EVENT_LINK_CHANGE ) {
+    info->link_usable = !!event.link_up;
+    return 1;
+  }
+  return 0;
+}
+
+/* fd_iavf_virtchnl_wait_link_event accepts an initial down or unknown link
+   Tiles exclude the VF from packet traffic until an up report arrives */
+static int
+fd_iavf_virtchnl_wait_link_event( fd_iavf_vfio_t *    vfio,
+                                 fd_iavf_adminq_t *  adminq,
+                                 fd_iavf_vf_info_t * info ) {
+  if( fd_iavf_virtchnl_apply_event( adminq, info ) ) return 0;
+
+  struct timespec delay = { .tv_sec=0L, .tv_nsec=FD_IAVF_POLL_INTERVAL_NS };
+  for( ulong retry=0UL; retry<FD_IAVF_LINK_RETRY_CNT; retry++ ) {
+    uchar message[ FD_IAVF_ADMINQ_BUF_SZ ];
+    ulong message_sz = sizeof(message);
+    uint virtchnl_op;
+    int  virtchnl_status;
+    int received = fd_iavf_adminq_recv( vfio, adminq, &virtchnl_op, &virtchnl_status,
+                                        message, &message_sz );
+    if( FD_UNLIKELY( -1==received ) ) {
+      int err = errno;
+      FD_LOG_WARNING(( "link event receive failed (%i-%s)", err, fd_io_strerror( err ) ));
+      errno = err;
+      return -1;
+    }
+    if( 0==received ) {
+      if( FD_UNLIKELY( -1==nanosleep( &delay, NULL ) && errno!=EINTR ) ) {
+        int err = errno;
+        FD_LOG_WARNING(( "link event wait failed (%i-%s)", err, fd_io_strerror( err ) ));
+        errno = err;
+        return -1;
+      }
+      continue;
+    }
+    if( FD_UNLIKELY( -1==fd_iavf_virtchnl_cache_event( adminq, virtchnl_op, virtchnl_status,
+                                                       message, message_sz ) ) ) return -1;
+    if( fd_iavf_virtchnl_apply_event( adminq, info ) ) return 0;
+  }
+  return 0;
+}
+
+int
+fd_iavf_virtchnl_get_resources( fd_iavf_vfio_t *    vfio,
+                                fd_iavf_adminq_t *  adminq,
+                                fd_iavf_vf_info_t * info ) {
+  fd_memset( info, 0, sizeof(*info) );
+
+  /* Request Ethernet, timed writeback and PF-managed RSS */
+  uint requested_caps = FD_IAVF_VIRTCHNL_CAP_L2 | FD_IAVF_VIRTCHNL_CAP_WB_ON_ITR | FD_IAVF_VIRTCHNL_CAP_RSS_PF;
+  uchar response[ FD_IAVF_ADMINQ_BUF_SZ ];
+  ulong response_sz = sizeof(response);
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_GET_VF_RESOURCES,
+                                                 &requested_caps, sizeof(requested_caps),
+                                                 response, &response_sz ) ) ) return -1;
+  if( FD_UNLIKELY( response_sz<sizeof(fd_iavf_virtchnl_vf_resource_t) ) ) {
+    FD_LOG_WARNING(( "VF resource reply too short, %lu bytes (%i-%s)", response_sz, EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+
+  /* Validate reply length and required capabilities */
+  fd_iavf_virtchnl_vf_resource_t resources;
+  fd_memcpy( &resources, response, sizeof(resources) );
+  ulong expected_sz = sizeof(resources) + (ulong)resources.num_vsis*sizeof(fd_iavf_virtchnl_vsi_resource_t);
+  /* Linux i40e includes one extra VSI entry in the reply length. */
+  ulong legacy_sz = expected_sz + sizeof(fd_iavf_virtchnl_vsi_resource_t);
+  if( FD_UNLIKELY( 0==resources.num_vsis || 0==resources.num_queue_pairs ||
+                   !(resources.capability_flags & FD_IAVF_VIRTCHNL_CAP_L2) ) ) {
+    FD_LOG_WARNING(( "invalid VF resources, VSIs %hu, queue pairs %hu, capabilities %#x (L2 required) (%i-%s)",
+                     resources.num_vsis, resources.num_queue_pairs, resources.capability_flags, EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  if( FD_UNLIKELY( response_sz!=expected_sz && response_sz!=legacy_sz ) ) {
+    FD_LOG_WARNING(( "VF resource reply size %lu, expected %lu or %lu for %hu VSIs (%i-%s)",
+                     response_sz, expected_sz, legacy_sz, resources.num_vsis, EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  if( FD_UNLIKELY( !(resources.capability_flags & FD_IAVF_VIRTCHNL_CAP_RSS_PF) ) ) {
+    FD_LOG_WARNING(( "PF does not support RSS configuration (%i-%s)", EPROTONOSUPPORT, fd_io_strerror( EPROTONOSUPPORT ) ));
+    errno = EPROTONOSUPPORT;
+    return -1;
+  }
+
+  /* Select the SR-IOV VSI used for packet queues */
+  fd_iavf_virtchnl_vsi_resource_t selected     = {0};
+  ulong                           selected_cnt = 0UL;
+  for( ulong vsi_idx=0UL; vsi_idx<(ulong)resources.num_vsis; vsi_idx++ ) {
+    fd_iavf_virtchnl_vsi_resource_t vsi;
+    fd_memcpy( &vsi, response+sizeof(resources)+vsi_idx*sizeof(vsi), sizeof(vsi) );
+    if( vsi.vsi_type==FD_IAVF_VIRTCHNL_VSI_SRIOV ) {
+      selected = vsi;
+      selected_cnt++;
+    }
+  }
+  if( FD_UNLIKELY( selected_cnt!=1UL ) ) {
+    FD_LOG_WARNING(( "VF resources contain %lu SR-IOV VSIs, expected 1 (%i-%s)", selected_cnt, EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  if( FD_UNLIKELY( 0==selected.num_queue_pairs ) ) {
+    FD_LOG_WARNING(( "SR-IOV VSI %hu has no queue pairs (%i-%s)", selected.vsi_id, EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  if( FD_UNLIKELY( 0!=(selected.default_mac_addr[0] & 1U) ) ) {
+    FD_LOG_WARNING(( "SR-IOV VSI %hu MAC " FD_ETH_MAC_FMT " is multicast (%i-%s)",
+                     selected.vsi_id, FD_ETH_MAC_FMT_ARGS( selected.default_mac_addr ), EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  ulong mac_bits = 0UL;
+  fd_memcpy( &mac_bits, selected.default_mac_addr, sizeof(selected.default_mac_addr) );
+  if( FD_UNLIKELY( 0==mac_bits ) ) {
+    FD_LOG_WARNING(( "PF returned a zero VF MAC address (%i-%s)", EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+
+  /* Retain PF limits and the assigned MAC */
+  info->vsi_id         = selected.vsi_id;
+  info->queue_pair_cnt = fd_ushort_min( resources.num_queue_pairs, selected.num_queue_pairs );
+  info->vector_cnt     = resources.max_vectors;
+  info->max_mtu        = resources.max_mtu;
+  info->rss_key_sz     = resources.rss_key_sz;
+  info->rss_lut_sz     = resources.rss_lut_sz;
+  info->wb_on_itr      = !!(resources.capability_flags & FD_IAVF_VIRTCHNL_CAP_WB_ON_ITR);
+  if( FD_UNLIKELY( 0==info->rss_key_sz || info->rss_key_sz>FD_IAVF_RSS_KEY_MAX_SZ ||
+                   0==info->rss_lut_sz || info->rss_lut_sz>FD_IAVF_RSS_LUT_MAX_SZ ) ) {
+    FD_LOG_WARNING(( "invalid RSS sizes, key %u must be in [1,%lu], LUT %u must be in [1,%lu] (%i-%s)",
+                     info->rss_key_sz, FD_IAVF_RSS_KEY_MAX_SZ, info->rss_lut_sz, FD_IAVF_RSS_LUT_MAX_SZ, EPROTO, fd_io_strerror( EPROTO ) ));
+    errno = EPROTO;
+    return -1;
+  }
+  fd_memcpy( info->mac_addr, selected.default_mac_addr, sizeof(info->mac_addr) );
+  return fd_iavf_virtchnl_wait_link_event( vfio, adminq, info );
+}
+
+int
+fd_iavf_virtchnl_poll_link( fd_iavf_vfio_t *    vfio,
+                            fd_iavf_adminq_t *  adminq,
+                            fd_iavf_vf_info_t * info,
+                            int *               changed ) {
+  if( FD_UNLIKELY( NULL==vfio || NULL==adminq || NULL==info || NULL==changed ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  int const  old_usable  = info->link_usable;
+  /* Detect resets even when no PF event was received */
+  uint       reset_state = fd_iavf_mmio_read( vfio, FD_IAVF_VFGEN_RSTAT ) & FD_IAVF_VFGEN_RSTAT_STATE;
+  if( FD_UNLIKELY( (reset_state!=FD_IAVF_VFR_STATE_COMPLETED && reset_state!=FD_IAVF_VFR_STATE_ACTIVE) ||
+                   !(fd_iavf_mmio_read( vfio, FD_IAVF_VF_ATQLEN ) & FD_IAVF_ATQ_ENABLE) ||
+                   !(fd_iavf_mmio_read( vfio, FD_IAVF_VF_ARQLEN ) & FD_IAVF_ARQ_ENABLE) ) ) {
+    errno = ECONNRESET;
+    return -1;
+  }
+  fd_iavf_virtchnl_apply_event( adminq, info );
+
+  /* Bound event processing so housekeeping can return */
+  for( ulong i=0UL; i<FD_IAVF_ADMINQ_DEPTH; i++ ) {
+    uchar message[ FD_IAVF_ADMINQ_BUF_SZ ];
+    ulong message_sz = sizeof(message);
+    uint virtchnl_op;
+    int  virtchnl_status;
+    int const received = fd_iavf_adminq_recv( vfio, adminq, &virtchnl_op, &virtchnl_status,
+                                              message, &message_sz );
+    if( FD_UNLIKELY( -1==received ) ) {
+      int err = errno;
+      FD_LOG_WARNING(( "link event receive failed (%i-%s)", err, fd_io_strerror( err ) ));
+      errno = err;
+      return -1;
+    }
+    if( 0==received ) break;
+    if( FD_UNLIKELY( -1==fd_iavf_virtchnl_cache_event( adminq, virtchnl_op, virtchnl_status,
+                                                       message, message_sz ) ) ) return -1;
+    fd_iavf_virtchnl_apply_event( adminq, info );
+  }
+
+  *changed = old_usable!=info->link_usable;
+  return 0;
+}
+
+ulong
+fd_iavf_queue_footprint( uint tx_depth,
+                         uint rx_depth ) {
+  if( FD_UNLIKELY( tx_depth<FD_IAVF_QUEUE_DEPTH_MIN || tx_depth>FD_IAVF_QUEUE_DEPTH_MAX || !fd_uint_is_pow2( tx_depth ) ||
+                   rx_depth<FD_IAVF_QUEUE_DEPTH_MIN || rx_depth>FD_IAVF_QUEUE_DEPTH_MAX || !fd_uint_is_pow2( rx_depth ) ) ) return 0UL;
+  /* TX and RX descriptor rings followed by software TX completion tracking */
+  ulong tx_ring_sz = fd_ulong_align_up( (ulong)tx_depth*sizeof(fd_iavf_tx_desc_t), FD_IAVF_PAGE_SZ );
+  ulong rx_ring_sz = fd_ulong_align_up( (ulong)rx_depth*sizeof(fd_iavf_hw_rx_desc_t), FD_IAVF_PAGE_SZ );
+  ulong tx_comp_sz = fd_ulong_align_up( (ulong)tx_depth*sizeof(ulong), FD_IAVF_PAGE_SZ );
+  return tx_ring_sz + rx_ring_sz + tx_comp_sz;
+}
+
+int
+fd_iavf_virtchnl_configure_queues( fd_iavf_vfio_t *            vfio,
+                                   fd_iavf_adminq_t *          adminq,
+                                   fd_iavf_vf_info_t const *   info,
+                                   fd_iavf_vfio_tile_t const * tiles,
+                                   uint                        queue_cnt,
+                                   ulong                       dma_iova,
+                                   uint                        rx_buffer_sz,
+                                   uint                        max_frame_sz ) {
+  /* Check VF queue and frame limits */
+  if( FD_UNLIKELY( queue_cnt>info->queue_pair_cnt ) ) {
+    FD_LOG_WARNING(( "VF has %hu queue pairs but %u net tiles are configured. Please decrease [layout.net_tile_count] to %hu or less",
+                     info->queue_pair_cnt, queue_cnt, info->queue_pair_cnt ));
+    errno = EINVAL;
+    return -1;
+  }
+  if( FD_UNLIKELY( info->vector_cnt<2U ) ) {
+    FD_LOG_WARNING(( "VF has %hu interrupt vectors, queue setup requires at least 2", info->vector_cnt ));
+    errno = EINVAL;
+    return -1;
+  }
+  if( FD_UNLIKELY( 0==rx_buffer_sz || 0!=(rx_buffer_sz & 127U) ) ) {
+    FD_LOG_WARNING(( "RX buffer size %u must be a nonzero multiple of 128", rx_buffer_sz ));
+    errno = EINVAL;
+    return -1;
+  }
+  if( FD_UNLIKELY( max_frame_sz<64U || max_frame_sz>=16384U || max_frame_sz>rx_buffer_sz ||
+                   (0!=info->max_mtu && max_frame_sz>info->max_mtu) ) ) {
+    FD_LOG_WARNING(( "frame size %u must be in [64,16383], fit RX buffer %u and not exceed nonzero VF MTU limit %hu", max_frame_sz, rx_buffer_sz, info->max_mtu ));
+    errno = EINVAL;
+    return -1;
+  }
+
+  /* Check every tile's queue memory before mapping */
+  ulong queue_iova = dma_iova;
+  for( uint i=0U; i<queue_cnt; i++ ) {
+    fd_iavf_vfio_tile_t const * tile = &tiles[i];
+    if( FD_UNLIKELY( NULL==tile->tx_queue || NULL==tile->rx_queue || tile->tx_queue==tile->rx_queue || NULL==tile->queue_memory ) ) {
+      FD_LOG_WARNING(( "queue pair %u requires distinct non-NULL TX/RX queue state and non-NULL DMA memory", i ));
+      errno = EINVAL;
+      return -1;
+    }
+    uint  tx_depth  = tile->tx_queue->depth;
+    uint  rx_depth  = tile->rx_queue->depth;
+    ulong footprint = fd_iavf_queue_footprint( tx_depth, rx_depth );
+    if( FD_UNLIKELY( 0==footprint ) ) {
+      FD_LOG_WARNING(( "queue %u depths TX %u, RX %u must be powers of two in [%u,%u]", i, tx_depth, rx_depth, FD_IAVF_QUEUE_DEPTH_MIN, FD_IAVF_QUEUE_DEPTH_MAX ));
+      errno = EINVAL;
+      return -1;
+    }
+    if( FD_UNLIKELY( tile->queue_memory_sz<footprint || footprint>ULONG_MAX-queue_iova ) ) {
+      FD_LOG_WARNING(( "invalid queue %u DMA bounds, memory size %lu, required %lu, IOVA %#lx", i, tile->queue_memory_sz, footprint, queue_iova ));
+      errno = EINVAL;
+      return -1;
+    }
+    queue_iova += footprint;
+  }
+
+  /* Map tile queues at consecutive IOVAs, queue IDs match tile indices */
+  fd_iavf_virtchnl_queue_config_t config = {
+    .vsi_id         = info->vsi_id,
+    .queue_pair_cnt = (ushort)queue_cnt
+  };
+  queue_iova = dma_iova;
+  for( uint i=0U; i<queue_cnt; i++ ) {
+    fd_iavf_vfio_tile_t const * tile = &tiles[i];
+    uint  tx_depth   = tile->tx_queue->depth;
+    uint  rx_depth   = tile->rx_queue->depth;
+    ulong tx_ring_sz = fd_ulong_align_up( (ulong)tx_depth*sizeof(fd_iavf_tx_desc_t), FD_IAVF_PAGE_SZ );
+    ulong rx_ring_sz = fd_ulong_align_up( (ulong)rx_depth*sizeof(fd_iavf_hw_rx_desc_t), FD_IAVF_PAGE_SZ );
+    ulong tx_comp_sz = fd_ulong_align_up( (ulong)tx_depth*sizeof(ulong), FD_IAVF_PAGE_SZ );
+    ulong footprint  = tx_ring_sz + rx_ring_sz + tx_comp_sz;
+    if( FD_UNLIKELY( -1==fd_iavf_vfio_dma_map( vfio, tile->queue_memory, footprint, queue_iova ) ) ) return -1;
+    fd_memset( tile->queue_memory, 0, footprint );
+    *tile->tx_queue = (fd_iavf_queue_t) {
+      .ring      = tile->queue_memory,
+      .depth     = tx_depth,
+      .tail      = (volatile uint *)(vfio->bar0 + FD_IAVF_TX_TAIL( i )),
+      .comp_ring = (ulong *)((uchar *)tile->queue_memory + tx_ring_sz + rx_ring_sz)
+    };
+    *tile->rx_queue = (fd_iavf_queue_t) {
+      .ring  = (uchar *)tile->queue_memory + tx_ring_sz,
+      .depth = rx_depth,
+      .tail  = (volatile uint *)(vfio->bar0 + FD_IAVF_RX_TAIL( i ))
+    };
+    config.pairs[i].tx = (fd_iavf_virtchnl_txq_info_t) {
+      .vsi_id    = info->vsi_id,
+      .queue_id  = (ushort)i,
+      .ring_len  = (ushort)tx_depth,
+      .ring_iova = queue_iova
+    };
+    /* Without flexible RX descriptor negotiation, the PF uses the 32-byte base format */
+    config.pairs[i].rx = (fd_iavf_virtchnl_rxq_info_t) {
+      .vsi_id         = info->vsi_id,
+      .queue_id       = (ushort)i,
+      .ring_len       = rx_depth,
+      .data_buffer_sz = rx_buffer_sz,
+      .max_frame_sz   = max_frame_sz,
+      .ring_iova      = queue_iova + tx_ring_sz
+    };
+    queue_iova += footprint;
+  }
+
+  /* Include the unused queue-pair entry required by Linux PF validation */
+  ulong config_sz = offsetof(fd_iavf_virtchnl_queue_config_t, pairs) +
+                    ((ulong)queue_cnt+1UL)*sizeof(fd_iavf_virtchnl_queue_pair_t);
+  ulong response_sz = 0UL;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_CONFIG_QUEUES,
+                                                 &config, config_sz, NULL, &response_sz ) ) ) return -1;
+
+  /* Virtchnl requires queue interrupt mappings even when polling
+     Vector 0 is reserved for Admin Queue events */
+  ushort queue_map = (ushort)((1U<<queue_cnt)-1U);
+  fd_iavf_virtchnl_irq_map_t irq_map = {
+    .vector_cnt   = 1U,
+    .vsi_id       = info->vsi_id,
+    .vector_id    = 1U,
+    .rx_queue_map = queue_map,
+    .tx_queue_map = queue_map,
+    .rx_itr_idx   = 0U,
+    .tx_itr_idx   = 0U
+  };
+  response_sz = 0UL;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_CONFIG_IRQ_MAP,
+                                                 &irq_map, sizeof(irq_map), NULL, &response_sz ) ) ) return -1;
+
+  if( info->wb_on_itr ) {
+    /* WB_ON_ITR flushes sparse RX completions without interrupts.
+       Use DPDK's interval of 2 hardware timer counts. */
+    fd_iavf_mmio_write( vfio, FD_IAVF_VFINT_DYN_CTL,
+                        FD_IAVF_VFINT_WB_ON_ITR | (2U<<FD_IAVF_VFINT_INTERVAL_SHIFT) );
+    (void)fd_iavf_mmio_read( vfio, FD_IAVF_VFGEN_RSTAT );
+  }
+  return 0;
+}
+
+int
+fd_iavf_virtchnl_enable_queues( fd_iavf_vfio_t *            vfio,
+                                fd_iavf_adminq_t *          adminq,
+                                fd_iavf_vf_info_t *         info,
+                                fd_iavf_vfio_tile_t const * tiles,
+                                uint                        queue_cnt ) {
+  if( FD_UNLIKELY( NULL==vfio || NULL==adminq || NULL==info || NULL==tiles ||
+                   0==queue_cnt || queue_cnt>FD_IAVF_TILE_MAX || queue_cnt>info->queue_pair_cnt ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+  /* Post RX buffers before enabling reception on the VF */
+  for( uint i=0U; i<queue_cnt; i++ ) {
+    fd_iavf_queue_t const * tx_queue = tiles[i].tx_queue;
+    fd_iavf_queue_t const * rx_queue = tiles[i].rx_queue;
+    if( FD_UNLIKELY( NULL==tx_queue || NULL==rx_queue || tx_queue==rx_queue ||
+                     tx_queue->enabled || rx_queue->enabled || 0==rx_queue->posted ||
+                     rx_queue->posted!=rx_queue->prod ||
+                     rx_queue->prod-rx_queue->cons>=rx_queue->depth ) ) {
+      FD_LOG_WARNING(( "queue pair %u must have distinct disabled TX/RX queues and posted RX buffers below ring capacity", i ));
+      errno = EINVAL;
+      return -1;
+    }
+  }
+  uint queue_map = (1U<<queue_cnt)-1U;
+  fd_iavf_virtchnl_queue_select_t select = {
+    .vsi_id       = info->vsi_id,
+    .rx_queue_map = queue_map,
+    .tx_queue_map = queue_map
+  };
+  ulong response_sz = 0UL;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_ENABLE_QUEUES,
+                                                 &select, sizeof(select), NULL, &response_sz ) ) ) return -1;
+  for( uint i=0U; i<queue_cnt; i++ ) {
+    tiles[i].tx_queue->enabled = 1;
+    tiles[i].rx_queue->enabled = 1;
+  }
+
+  /* Queue enable triggers a new PF link report */
+  info->link_usable = 0;
+  return fd_iavf_virtchnl_wait_link_event( vfio, adminq, info );
+}
+
+static int
+fd_iavf_virtchnl_add_mac( fd_iavf_vfio_t *          vfio,
+                          fd_iavf_adminq_t *        adminq,
+                          fd_iavf_vf_info_t const * info ) {
+  /* Linux virtchnl_ether_addr_list with one primary address. PF message
+     validation requires space for one extra virtchnl_ether_addr entry. */
+  struct {
+    ushort vsi_id;
+    ushort count;
+    uchar  mac[ 6 ];
+    uchar  type;
+    uchar  pad;
+    uchar  legacy_padding[ 8 ];
+  } request = { .vsi_id=info->vsi_id, .count=1U, .type=FD_IAVF_VIRTCHNL_MAC_PRIMARY };
+  FD_STATIC_ASSERT( sizeof(request)==20UL, iavf_mac_request_sz );
+  fd_memcpy( request.mac, info->mac_addr, sizeof(request.mac) );
+  ulong response_sz = 0UL;
+  return fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_ADD_ETH_ADDR,
+                                   &request, sizeof(request), NULL, &response_sz );
+}
+
+static int
+fd_iavf_virtchnl_configure_rss( fd_iavf_vfio_t *          vfio,
+                                fd_iavf_adminq_t *        adminq,
+                                fd_iavf_vf_info_t const * info,
+                                uint                      queue_cnt ) {
+  /* Configure the PF-managed RSS hash key */
+  struct {
+    ushort vsi_id;
+    ushort count;
+    uchar  bytes[ FD_IAVF_ADMINQ_BUF_SZ-FD_IAVF_RSS_KEY_HEADER_SZ ];
+  } request = { .vsi_id=info->vsi_id, .count=(ushort)info->rss_key_sz };
+  FD_STATIC_ASSERT( offsetof(__typeof__(request), bytes)==FD_IAVF_RSS_KEY_HEADER_SZ, iavf_rss_key_header_sz );
+  FD_STATIC_ASSERT( offsetof(__typeof__(request), bytes)==FD_IAVF_RSS_LUT_HEADER_SZ, iavf_rss_lut_header_sz );
+  FD_STATIC_ASSERT( sizeof(request)==FD_IAVF_ADMINQ_BUF_SZ, iavf_rss_request_sz );
+  if( FD_UNLIKELY( NULL==fd_rng_secure( request.bytes, info->rss_key_sz ) ) ) return -1;
+  ulong response_sz = 0UL;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_CONFIG_RSS_KEY,
+                                                 &request, FD_IAVF_RSS_KEY_LEGACY_SZ+(ulong)info->rss_key_sz-1UL,
+                                                 NULL, &response_sz ) ) ) return -1;
+
+  /* Cycle queue IDs through the LUT, tile count need not be a power of two */
+  fd_memset( request.bytes, 0, sizeof(request.bytes) );
+  request.count = (ushort)info->rss_lut_sz;
+  for( uint i=0U; i<info->rss_lut_sz; i++ ) request.bytes[i] = (uchar)(i%queue_cnt);
+  response_sz = 0UL;
+  return fd_iavf_virtchnl_request( vfio, adminq, FD_IAVF_VIRTCHNL_CONFIG_RSS_LUT,
+                                   &request, FD_IAVF_RSS_LUT_LEGACY_SZ+(ulong)info->rss_lut_sz-1UL,
+                                   NULL, &response_sz );
+}
+
+int
+fd_iavf_init( fd_iavf_vfio_t *            vfio,
+              fd_iavf_adminq_t *          adminq,
+              fd_iavf_vf_info_t *         info,
+              fd_iavf_vfio_tile_t const * tiles,
+              uint                        tile_cnt,
+              char const *                pci_addr,
+              uint                        rx_buffer_sz,
+              uint                        max_frame_sz ) {
+  if( FD_UNLIKELY( NULL==vfio || NULL==adminq || NULL==info || NULL==tiles || 0==tile_cnt || tile_cnt>FD_IAVF_TILE_MAX ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+
+  /* Place Admin Queue and queue IOVAs after packet mappings to avoid overlap */
+  ulong adminq_iova = 0UL;
+  for( uint tile_idx=0U; tile_idx<tile_cnt; tile_idx++ ) {
+    fd_iavf_vfio_tile_t const * tile = &tiles[tile_idx];
+    if( FD_UNLIKELY( tile->packet_memory_sz>ULONG_MAX-tile->packet_iova ) ) {
+      errno = EINVAL;
+      return -1;
+    }
+    adminq_iova = fd_ulong_max( adminq_iova, tile->packet_iova+tile->packet_memory_sz );
+  }
+  ulong const adminq_memory_sz = fd_iavf_adminq_footprint();
+  if( FD_UNLIKELY( adminq_memory_sz>ULONG_MAX-adminq_iova ) ) {
+    errno = EINVAL;
+    return -1;
+  }
+  ulong const queue_iova = adminq_iova+adminq_memory_sz;
+
+  /* Open and reset the VF */
+  fd_iavf_pci_info_t pci;
+  if( FD_UNLIKELY( -1==fd_iavf_pci_probe( &pci, pci_addr ) ) ) return -1;
+  if( FD_UNLIKELY( -1==fd_iavf_vfio_init( vfio, &pci ) ) ) return -1;
+
+  /* Establish PF communication and discover VF resources */
+  if( FD_UNLIKELY( -1==fd_iavf_adminq_init( vfio, adminq, adminq->dma_memory, adminq_iova ) ) ) return -1;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_version( vfio, adminq ) ) ) return -1;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_get_resources( vfio, adminq, info ) ) ) return -1;
+
+  /* Configure tile queues and receive delivery */
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_configure_queues( vfio, adminq, info, tiles, tile_cnt,
+                                                          queue_iova, rx_buffer_sz, max_frame_sz ) ) ) return -1;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_add_mac( vfio, adminq, info ) ) ) return -1;
+  if( FD_UNLIKELY( -1==fd_iavf_virtchnl_configure_rss( vfio, adminq, info, tile_cnt ) ) ) return -1;
+
+  /* Map packet buffers before the caller posts RX buffers and enables queues */
+  for( uint tile_idx=0U; tile_idx<tile_cnt; tile_idx++ ) {
+    fd_iavf_vfio_tile_t const * tile = &tiles[tile_idx];
+    if( FD_UNLIKELY( -1==fd_iavf_vfio_dma_map( vfio, tile->packet_memory, tile->packet_memory_sz, tile->packet_iova ) ) ) return -1;
+  }
+  return 0;
+}
diff --git a/src/disco/net/iavf/fd_iavf.h b/src/disco/net/iavf/fd_iavf.h
new file mode 100644
index 0000000..9a6537f
--- /dev/null
+++ b/src/disco/net/iavf/fd_iavf.h
@@ -0,0 +1,104 @@
+#ifndef HEADER_fd_src_disco_net_iavf_fd_iavf_h
+#define HEADER_fd_src_disco_net_iavf_fd_iavf_h
+
+#define FD_IAVF_QUEUE_DEPTH_MIN (64U)
+#define FD_IAVF_QUEUE_DEPTH_MAX (4096U)
+
+#if defined(__linux__)
+#include "../../../util/bits/fd_bits.h"
+#include <net/if.h>
+
+#define FD_IAVF_PCI_ADDR_SZ     (13UL)
+#define FD_IAVF_DRIVER_NAME_MAX (32UL)
+#define FD_IAVF_MEMBER_MAX      (16UL)
+#define FD_IAVF_TILE_MAX        (8UL)
+
+/* fd_iavf_pci_info describes a validated Intel Ethernet Virtual Function. */
+struct fd_iavf_pci_info {
+  char   pci_addr[ FD_IAVF_PCI_ADDR_SZ ];
+  char   pf_pci_addr[ FD_IAVF_PCI_ADDR_SZ ];
+  char   driver[ FD_IAVF_DRIVER_NAME_MAX ];
+  uint   iommu_group;
+  ushort device_id;
+};
+typedef struct fd_iavf_pci_info fd_iavf_pci_info_t;
+
+FD_PROTOTYPES_BEGIN
+
+/* fd_iavf_vfio_avail returns 1 if the vfio-pci driver is registered with
+   the kernel, or 0 otherwise. Does not load the module. */
+int
+fd_iavf_vfio_avail( void );
+
+/* fd_iavf_vfio_api_check checks the VFIO API version and TYPE1v2 IOMMU
+   support through /dev/vfio/vfio
+   Returns 0 on success or -1 with errno set
+   If diagnostic is non-NULL, sets it to NULL on success or a static
+   error message on failure */
+int
+fd_iavf_vfio_api_check( char const ** diagnostic );
+
+/* fd_iavf_member_interfaces lists PFs for VF creation on interface or its
+   802.3ad bond members. Writes names to members and count to member_cnt.
+   Each PF must use ice or i40e. Returns 0 on success or -1 with errno set.
+   Outputs are valid only on success. Some bond sysfs errors terminate
+   the process. */
+int
+fd_iavf_member_interfaces( char const * interface,
+                           char         members[ FD_IAVF_MEMBER_MAX ][ IF_NAMESIZE ],
+                           ulong *      member_cnt );
+
+/* fd_iavf_sriov_bios_guide returns a static BIOS setup explanation for the
+   detected manufacturer and CPU, with a vendor URL when available.
+   Otherwise returns generic advice, or NULL if vendor_only is nonzero */
+char const *
+fd_iavf_sriov_bios_guide( int vendor_only );
+
+/* fd_iavf_iommu_check checks whether pf_if is in an IOMMU group.
+   The iavf provider requires an IOMMU to restrict which memory the NIC
+   can access. Returns 0 on success or -1 with errno set.
+   If diagnostic is non-NULL, sets it to NULL on success or a static
+   explanation on failure. */
+int
+fd_iavf_iommu_check( char const *  pf_if,
+                     char const ** diagnostic );
+
+/* fd_iavf_ari_check requires ARI forwarding on pf_if's PCI bus.
+   Reads ari_enabled and returns 0 on success or -1 with errno set,
+   including EOPNOTSUPP when disabled. Does not log failures. */
+int
+fd_iavf_ari_check( char const * pf_if );
+
+/* fd_iavf_numvfs_get reads pf_if's enabled VF count from sriov_numvfs.
+   A count of zero is valid. Returns 0 on success or -1 with errno set,
+   leaving numvfs unchanged on failure. Does not log failures. */
+int
+fd_iavf_numvfs_get( char const * pf_if,
+                    uint *       numvfs );
+
+/* fd_iavf_sriov_resources_check requires a PCI bus number for VF 0 and
+   assigned VF BAR0 and BAR3 memory ranges. Returns 0 on success or -1
+   on failure. Only reads sysfs and does not log failures or create VFs. */
+int
+fd_iavf_sriov_resources_check( char const * pf_if );
+
+/* fd_iavf_get_last_vf returns the PCI address of the highest enabled VF on pf_if
+   Returns 0 on success or -1 with errno set, including ENOENT for no VFs
+   vf_idx is optional and outputs are valid only on success */
+int
+fd_iavf_get_last_vf( char const * pf_if,
+                     uint *       vf_idx,
+                     char         vf_pci_addr[ FD_IAVF_PCI_ADDR_SZ ] );
+
+/* fd_iavf_pci_probe checks for a supported Intel Ethernet VF and requires
+   it to be alone in its IOMMU group so VFIO access cannot include another
+   device. Returns 0 on success or -1 with errno set on failure,
+   clearing info when non-NULL. Records the current driver, empty if unbound.
+   The VF need not use vfio-pci until fd_iavf_vfio_init. */
+int
+fd_iavf_pci_probe( fd_iavf_pci_info_t * info,
+                   char const *         pci_addr );
+
+FD_PROTOTYPES_END
+#endif
+#endif
diff --git a/src/disco/net/iavf/fd_iavf_private.h b/src/disco/net/iavf/fd_iavf_private.h
new file mode 100644
index 0000000..f84aa3f
--- /dev/null
+++ b/src/disco/net/iavf/fd_iavf_private.h
@@ -0,0 +1,215 @@
+#ifndef HEADER_fd_src_disco_net_iavf_fd_iavf_private_h
+#define HEADER_fd_src_disco_net_iavf_fd_iavf_private_h
+
+#include "fd_iavf.h"
+#if defined(__linux__)
+
+#define FD_IAVF_BAR0_MAP_SZ (0x9000UL)
+#define FD_IAVF_PAGE_SZ     (4096UL)
+
+#define FD_IAVF_TX_TAIL(queue_id) (0x0000UL + 4UL*(queue_id)) /* IAVF_QTX_TAIL1 */
+#define FD_IAVF_RX_TAIL(queue_id) (0x2000UL + 4UL*(queue_id)) /* IAVF_QRX_TAIL1 */
+
+static inline void
+fd_iavf_hw_dma_to_device( void ) {
+#if FD_HAS_X86
+  FD_COMPILER_MFENCE();
+#elif FD_HAS_ARM
+  __asm__ __volatile__( "dmb oshst" ::: "memory" );
+#else
+  FD_HW_MFENCE_ST();
+#endif
+}
+
+static inline void
+fd_iavf_hw_dma_from_device( void ) {
+#if FD_HAS_X86
+  __asm__ __volatile__( "lfence" ::: "memory" );
+#elif FD_HAS_ARM
+  __asm__ __volatile__( "dmb oshld" ::: "memory" );
+#else
+  FD_HW_MFENCE();
+#endif
+}
+
+/* fd_iavf_vfio owns the Linux VFIO descriptors and mapped BAR0 registers. */
+struct fd_iavf_vfio {
+  int              container_fd;
+  int              group_fd;
+  int              device_fd;
+  volatile uchar * bar0;
+  ulong            iova_pgsizes;
+};
+typedef struct fd_iavf_vfio fd_iavf_vfio_t;
+
+/* fd_iavf_adminq holds the command channel to the PF driver, separate
+   from the rings carrying packet traffic. */
+struct fd_iavf_adminq {
+  void * dma_memory;
+  ulong  dma_iova;
+  uint   atq_prod;
+  uint   arq_cons;
+  /* PF events can arrive before the resource reply populates vf_info. */
+  uchar  pending_event[ 16 ];
+  ulong  pending_event_sz;
+};
+typedef struct fd_iavf_adminq fd_iavf_adminq_t;
+
+/* fd_iavf_vf_info contains resources assigned by the Physical Function. */
+struct fd_iavf_vf_info {
+  ushort vsi_id;
+  ushort queue_pair_cnt;
+  ushort vector_cnt;
+  ushort max_mtu;
+  uint   rss_key_sz;
+  uint   rss_lut_sz;
+  int    wb_on_itr;
+  uchar  mac_addr[ 6 ];
+  /* link_usable is false until the PF reports an up link. */
+  int    link_usable;
+};
+typedef struct fd_iavf_vf_info fd_iavf_vf_info_t;
+
+struct fd_iavf_tx_desc {
+  ulong buffer_iova;
+  ulong cmd_type_offset_buffer_sz;
+};
+
+typedef struct fd_iavf_tx_desc fd_iavf_tx_desc_t;
+
+FD_STATIC_ASSERT( sizeof(fd_iavf_tx_desc_t)==16UL, iavf_tx_desc_sz );
+
+/* fd_iavf_hw_rx_desc is the Intel 32-byte receive descriptor. */
+struct fd_iavf_hw_rx_desc {
+  ulong qword[ 4 ];
+};
+
+typedef struct fd_iavf_hw_rx_desc fd_iavf_hw_rx_desc_t;
+
+FD_STATIC_ASSERT( sizeof(fd_iavf_hw_rx_desc_t)==32UL, iavf_rx_desc_sz );
+
+/* fd_iavf_queue owns one Intel transmit or receive descriptor ring. */
+struct fd_iavf_queue {
+  void *          ring;
+  uint            depth;
+  ulong           prod;
+  ulong           posted;
+  ulong           cons;
+  volatile uint * tail;
+  int             enabled;
+  /* The NIC reports TX completion in the descriptor ring itself. Track
+     Report Status batch endpoints so we only poll each batch's last descriptor. */
+  ulong *         comp_ring;
+  ulong           comp_prod;
+  ulong           comp_cons;
+  uint            discard;
+};
+typedef struct fd_iavf_queue fd_iavf_queue_t;
+
+/* fd_iavf_vfio_tile identifies one tile's queues and packet memory during
+   shared VF initialization. Queue depths must be set before initialization. */
+struct fd_iavf_vfio_tile {
+  fd_iavf_queue_t * tx_queue;
+  fd_iavf_queue_t * rx_queue;
+  void *            queue_memory;
+  ulong             queue_memory_sz;
+  void *            packet_memory;
+  ulong             packet_memory_sz;
+  ulong             packet_iova;
+};
+typedef struct fd_iavf_vfio_tile fd_iavf_vfio_tile_t;
+
+FD_PROTOTYPES_BEGIN
+
+/* fd_iavf_init opens and resets a VF, negotiates PF resources, maps each
+   tile's memory and configures queues, MAC delivery and RSS. adminq->dma_memory
+   must hold fd_iavf_adminq_footprint() bytes. Queues remain disabled so callers
+   can post RX buffers before fd_iavf_virtchnl_enable_queues. Returns 0 on
+   success or -1 with errno set. After failure, the caller must exit. */
+int
+fd_iavf_init( fd_iavf_vfio_t *            vfio,
+              fd_iavf_adminq_t *          adminq,
+              fd_iavf_vf_info_t *         info,
+              fd_iavf_vfio_tile_t const * tiles,
+              uint                        tile_cnt,
+              char const *                pci_addr,
+              uint                        rx_buffer_sz,
+              uint                        max_frame_sz );
+
+/* fd_iavf_vfio_map_bar restores register access in each tile through the
+   inherited device FD, preserving the VF configuration prepared before launch. */
+int
+fd_iavf_vfio_map_bar( fd_iavf_vfio_t * vfio );
+
+/* fd_iavf_vfio_unmap_bar releases the launcher's register mapping
+   VFIO descriptors stay open for the tiles to inherit and remap */
+int
+fd_iavf_vfio_unmap_bar( fd_iavf_vfio_t * vfio );
+
+/* fd_iavf_vfio_dma_map pins memory and maps it at iova, the address visible to
+   the VF.  The memory, size, and I/O virtual address must be aligned to a page
+   size supported by the VFIO IOMMU.  It returns 0 on success and -1 on failure. */
+int
+fd_iavf_vfio_dma_map( fd_iavf_vfio_t * vfio,
+                      void *           memory,
+                      ulong            memory_sz,
+                      ulong            iova );
+
+ulong
+fd_iavf_adminq_footprint( void );
+
+/* fd_iavf_virtchnl_version requires virtchnl 1.1 so resource discovery can
+   request Ethernet and PF-managed RSS capabilities. Returns 0 on success
+   or -1 on failure. */
+int
+fd_iavf_virtchnl_version( fd_iavf_vfio_t *   vfio,
+                          fd_iavf_adminq_t * adminq );
+
+/* fd_iavf_virtchnl_get_resources obtains and validates the PF-assigned MAC
+   and limits used to configure packet queues and RSS. Requires initialized
+   VFIO and Admin Queue state after fd_iavf_virtchnl_version succeeds.
+   Returns 0 on success or -1 on failure. */
+int
+fd_iavf_virtchnl_get_resources( fd_iavf_vfio_t *    vfio,
+                                fd_iavf_adminq_t *  adminq,
+                                fd_iavf_vf_info_t * info );
+
+/* fd_iavf_virtchnl_poll_link updates link usability for VF selection and detects
+   resets that invalidate the configured queues. Sets changed when link
+   usability changes. Returns 0 on success or -1 on failure. */
+int
+fd_iavf_virtchnl_poll_link( fd_iavf_vfio_t *    vfio,
+                            fd_iavf_adminq_t *  adminq,
+                            fd_iavf_vf_info_t * info,
+                            int *               changed );
+
+ulong
+fd_iavf_queue_footprint( uint tx_depth,
+                         uint rx_depth );
+
+/* fd_iavf_virtchnl_configure_queues prepares queue pairs 0 through queue_cnt-1
+   for independent tile ownership. Requires initialized VFIO and Admin Queue
+   state, validated info and queue_cnt in [1,FD_IAVF_TILE_MAX].
+   Each tile must provide distinct queue memory and queue state.
+   Maps pairs at consecutive IOVAs starting at dma_iova and
+   leaves them disabled until fd_iavf_virtchnl_enable_queues. */
+int
+fd_iavf_virtchnl_configure_queues( fd_iavf_vfio_t *            vfio,
+                                   fd_iavf_adminq_t *          adminq,
+                                   fd_iavf_vf_info_t const *   info,
+                                   fd_iavf_vfio_tile_t const * tiles,
+                                   uint                        queue_cnt,
+                                   ulong                       dma_iova,
+                                   uint                        rx_buffer_sz,
+                                   uint                        max_frame_sz );
+
+int
+fd_iavf_virtchnl_enable_queues( fd_iavf_vfio_t *            vfio,
+                                fd_iavf_adminq_t *          adminq,
+                                fd_iavf_vf_info_t *         info,
+                                fd_iavf_vfio_tile_t const * tiles,
+                                uint                        queue_cnt );
+
+FD_PROTOTYPES_END
+#endif
+#endif
diff --git a/src/disco/net/iavf/fd_iavf_tile.c b/src/disco/net/iavf/fd_iavf_tile.c
new file mode 100644
index 0000000..f099a44
--- /dev/null
+++ b/src/disco/net/iavf/fd_iavf_tile.c
@@ -0,0 +1,1160 @@
+#define _GNU_SOURCE
+/* The iavf tile translates Ethernet frames between Intel VF descriptor
+   rings and fd_tango traffic. Each tile owns one RX/TX pair per VF, with
+   completions written into the descriptor rings themselves.
+
+   Separate Admin Queues carry configuration requests to the PF driver.
+   Tile 0 consumes PF events for all tiles. */
+
+#include "../fd_net_tile.h"
+#include "../fd_net_tile_private.h"
+#include "fd_iavf_private.h"
+#include "../fd_net_router.h"
+#include "../../topo/fd_topo.h"
+
+#include <errno.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <stdlib.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <linux/rtnetlink.h>
+
+#include "../../../util/pod/fd_pod_format.h"
+#include "generated/fd_iavf_tile_seccomp.h"
+
+#define FD_IAVF_TX_FLUSH_TIMEOUT_NS         (  20000L)
+#define FD_IAVF_LO_TX_TIMEOUT_NS            ( 500000L)
+#define FD_IAVF_VF_HOUSEKEEPING_INTERVAL_NS (1000000L)
+
+#define FD_IAVF_TX_DESC_TYPE_MASK         (0xfUL)    /* IAVF_TXD_QW1_DTYPE_MASK */
+#define FD_IAVF_TX_DESC_DONE              (0xfUL)    /* IAVF_TX_DESC_DTYPE_DESC_DONE */
+#define FD_IAVF_TX_DESC_CMD_SHIFT         (4)        /* IAVF_TXD_QW1_CMD_SHIFT */
+#define FD_IAVF_TX_DESC_CMD_EOP           (1UL)      /* IAVF_TX_DESC_CMD_EOP */
+#define FD_IAVF_TX_DESC_CMD_REPORT_STATUS (2UL)      /* IAVF_TX_DESC_CMD_RS */
+#define FD_IAVF_TX_DESC_CMD_ICRC          (4UL)      /* IAVF_TX_DESC_CMD_ICRC */
+#define FD_IAVF_TX_DESC_BUFFER_SHIFT      (34)       /* IAVF_TXD_QW1_TX_BUF_SZ_SHIFT */
+#define FD_IAVF_TX_DESC_BUFFER_MAX        (0x3fffUL) /* IAVF_TXD_QW1_TX_BUF_SZ_MASK >> 34 */
+
+#define FD_IAVF_RX_DESC_DONE              (1UL<<0)   /* IAVF_RXD_LEGACY_DD_M */
+#define FD_IAVF_RX_DESC_END_OF_PACKET     (1UL<<1)   /* IAVF_RXD_LEGACY_EOP_M */
+#define FD_IAVF_RX_DESC_MAC_ERR           (1UL<<19)  /* IAVF_RXD_LEGACY_RXE_M */
+#define FD_IAVF_RX_DESC_LENGTH_SHIFT      (38)       /* Low bit of IAVF_RXD_LEGACY_LENGTH_M */
+#define FD_IAVF_RX_DESC_LENGTH_MASK       (0x3fffUL) /* IAVF_RXD_LEGACY_LENGTH_M >> 38 */
+
+FD_STATIC_ASSERT( FD_NET_MTU<=FD_IAVF_TX_DESC_BUFFER_MAX, iavf_tx_frame_sz );
+
+struct fd_iavf_tile_rx_comp {
+  uint  chunk;
+  uint  discard;
+  uint  end_of_packet;
+  ulong frame_sz;
+};
+typedef struct fd_iavf_tile_rx_comp fd_iavf_tile_rx_comp_t;
+
+/* fd_iavf_tile_vf is private tile state for a single VF */
+struct fd_iavf_tile_vf {
+  fd_iavf_vfio_t    vfio;
+  fd_iavf_adminq_t  adminq;
+  fd_iavf_vf_info_t vf_info;
+  fd_iavf_queue_t   rx_queue;
+  fd_iavf_queue_t   tx_queue;
+  void *            queue_memory;
+  uint *            rx_desc_buf_chunk;
+  uint *            tx_desc_buf_chunk;
+  /* A Report Status completion can cover several frames. Keep each frame's
+     length to count the bytes in a completed batch. */
+  ushort *          tx_desc_frame_sz;
+  uint              rx_pending_chunk[ FD_IAVF_BATCH_SIZE ];
+  uint              rx_pending_cnt;
+  long              tx_flush_deadline_ticks;
+};
+typedef struct fd_iavf_tile_vf fd_iavf_tile_vf_t;
+
+/* fd_iavf_tile is private tile state */
+struct __attribute__((aligned(64UL))) fd_iavf_tile {
+  fd_iavf_tile_vf_t     vfs[ FD_IAVF_MEMBER_MAX ];
+  ulong                 vf_cnt;
+  ulong                 tx_vf_idx;
+  ulong                 rx_next_vf;
+  /* vf_link_usable shares tile 0's PF link decision with the other tiles. */
+  ulong                 vf_link_usable[ FD_IAVF_MEMBER_MAX ];
+  ulong const *         vf_link_usable_shared;
+  long                  vf_housekeeping_interval_ticks;
+  long                  vf_housekeeping_deadline_ticks;
+  uint                  prepared;
+  uint                  batch_size;
+  long                  tx_flush_timeout_ticks;
+  long                  lo_tx_timeout_ticks;
+  long                  lo_tx_deadline_ticks;
+  int                   lo_tx_sock;
+  uint                  lo_tx_cnt;
+  fd_net_tile_t         net;
+  fd_net_router_t       router;
+  ulong                 netdev_seq;
+
+  struct mmsghdr     lo_tx_msg [ FD_IAVF_BATCH_SIZE ];
+  struct iovec       lo_tx_iov [ FD_IAVF_BATCH_SIZE ];
+  struct sockaddr_in lo_tx_addr[ FD_IAVF_BATCH_SIZE ];
+  uchar              lo_tx_buf [ FD_IAVF_BATCH_SIZE ][ FD_NET_MTU ];
+
+  struct {
+    ulong tx_no_buffer_cnt;
+    ulong tx_no_link_cnt;
+    ulong tx_loopback_fail_cnt;
+    ulong rx_no_link_cnt;
+    ulong non_fd_pkt_cnt;
+  } metrics;
+};
+typedef struct fd_iavf_tile fd_iavf_tile_t;
+
+static void *
+fd_iavf_hw_join_queues( fd_iavf_tile_t *       ctx,
+                        fd_topo_tile_t const * tile ) {
+  FD_SCRATCH_ALLOC_INIT( scratch, ctx );
+  (void)FD_SCRATCH_ALLOC_APPEND( scratch, alignof(fd_iavf_tile_t), sizeof(fd_iavf_tile_t) );
+  ulong const queue_sz   = fd_iavf_queue_footprint( tile->iavf.tx_queue_size, tile->iavf.rx_queue_size );
+  ulong const tx_ring_sz = fd_ulong_align_up( tile->iavf.tx_queue_size*sizeof(fd_iavf_tx_desc_t), FD_IAVF_PAGE_SZ );
+  ulong const rx_ring_sz = fd_ulong_align_up( tile->iavf.rx_queue_size*sizeof(fd_iavf_hw_rx_desc_t), FD_IAVF_PAGE_SZ );
+
+  for( ulong vf_idx=0UL; vf_idx<tile->iavf.member_cnt; vf_idx++ ) {
+    fd_iavf_tile_vf_t * vf = &ctx->vfs[vf_idx];
+    /* Only tile 0 needs Admin Queue memory */
+    vf->adminq.dma_memory = NULL;
+    if( 0==tile->kind_id ) {
+      vf->adminq.dma_memory = FD_SCRATCH_ALLOC_APPEND( scratch, FD_IAVF_PAGE_SZ, fd_iavf_adminq_footprint() );
+    }
+
+    vf->queue_memory       = FD_SCRATCH_ALLOC_APPEND( scratch, FD_IAVF_PAGE_SZ, queue_sz );
+    vf->tx_queue.ring      = vf->queue_memory;
+    vf->rx_queue.ring      = (uchar *)vf->queue_memory + tx_ring_sz;
+    vf->tx_queue.depth     = tile->iavf.tx_queue_size;
+    vf->rx_queue.depth     = tile->iavf.rx_queue_size;
+    vf->tx_queue.comp_ring = (ulong *)((uchar *)vf->queue_memory + tx_ring_sz + rx_ring_sz);
+
+    vf->rx_desc_buf_chunk = FD_SCRATCH_ALLOC_APPEND( scratch, alignof(uint),   tile->iavf.rx_queue_size*sizeof(uint)   );
+    vf->tx_desc_buf_chunk = FD_SCRATCH_ALLOC_APPEND( scratch, alignof(uint),   tile->iavf.tx_queue_size*sizeof(uint)   );
+    vf->tx_desc_frame_sz  = FD_SCRATCH_ALLOC_APPEND( scratch, alignof(ushort), tile->iavf.tx_queue_size*sizeof(ushort) );
+  }
+  return (void *)FD_SCRATCH_ALLOC_FINI( scratch, 1UL );
+}
+
+static int
+fd_iavf_hw_map_regs( fd_iavf_tile_vf_t * vf,
+                     ulong               queue_id ) {
+  if( FD_UNLIKELY( -1==fd_iavf_vfio_map_bar( &vf->vfio ) ) ) return -1;
+  vf->tx_queue.tail = (volatile uint *)(vf->vfio.bar0 + FD_IAVF_TX_TAIL( queue_id ));
+  vf->rx_queue.tail = (volatile uint *)(vf->vfio.bar0 + FD_IAVF_RX_TAIL( queue_id ));
+  return 0;
+}
+
+static int
+fd_iavf_hw_rx_enqueue( fd_iavf_tile_vf_t * vf,
+                       uint                recv_cnt ) {
+  fd_iavf_queue_t * rx_queue    = &vf->rx_queue;
+  ulong const       outstanding = rx_queue->prod-rx_queue->cons;
+
+  if( FD_UNLIKELY( outstanding>=rx_queue->depth || recv_cnt>=rx_queue->depth-outstanding ) ) {
+    errno = ENOSPC;
+    return -1;
+  }
+
+  for( uint i=0U; i<recv_cnt; i++ ) {
+    uint const            chunk    = vf->rx_pending_chunk[i];
+    uint const            desc_idx = (uint)((rx_queue->prod+i) & (rx_queue->depth-1U));
+    fd_iavf_hw_rx_desc_t * desc     = (fd_iavf_hw_rx_desc_t *)rx_queue->ring + desc_idx;
+
+    desc->qword[0] = (ulong)chunk<<FD_CHUNK_LG_SZ;
+    desc->qword[1] = 0UL;
+    desc->qword[2] = 0UL;
+    desc->qword[3] = 0UL;
+
+    vf->rx_desc_buf_chunk[ desc_idx ] = chunk;
+  }
+  rx_queue->prod += recv_cnt;
+
+  fd_iavf_hw_dma_to_device();
+  *rx_queue->tail = (uint)(rx_queue->prod & (rx_queue->depth-1U));
+  FD_COMPILER_MFENCE();
+  rx_queue->posted = rx_queue->prod;
+  return 0;
+}
+
+static void
+fd_iavf_hw_tx_enqueue( fd_iavf_tile_vf_t * vf,
+                       ulong               frame_sz ) {
+  fd_iavf_queue_t * tx_queue = &vf->tx_queue;
+
+  FD_TEST( tx_queue->prod-tx_queue->cons<tx_queue->depth-1UL );
+
+  uint const desc_idx     = (uint)(tx_queue->prod & (tx_queue->depth-1U));
+  uint const chunk        = vf->tx_desc_buf_chunk[desc_idx];
+  ulong const frame_iova  = (ulong)chunk<<FD_CHUNK_LG_SZ;
+  fd_iavf_tx_desc_t * desc = (fd_iavf_tx_desc_t *)tx_queue->ring + desc_idx;
+  desc->buffer_iova        = frame_iova;
+  desc->cmd_type_offset_buffer_sz =
+      ((FD_IAVF_TX_DESC_CMD_EOP | FD_IAVF_TX_DESC_CMD_ICRC)<<FD_IAVF_TX_DESC_CMD_SHIFT) |
+      (frame_sz<<FD_IAVF_TX_DESC_BUFFER_SHIFT);
+  vf->tx_desc_frame_sz[desc_idx] = (ushort)frame_sz;
+  tx_queue->prod++;
+}
+
+static void
+fd_iavf_hw_tx_flush( fd_iavf_queue_t * tx_queue ) {
+  if( FD_UNLIKELY( tx_queue->posted==tx_queue->prod ) ) return;
+
+  ulong const         tx_end   = tx_queue->prod;
+  uint const          desc_idx = (uint)((tx_end-1UL) & (tx_queue->depth-1U));
+  fd_iavf_tx_desc_t * desc     = (fd_iavf_tx_desc_t *)tx_queue->ring + desc_idx;
+  /* Request completion on the batch's last descriptor */
+  desc->cmd_type_offset_buffer_sz |= FD_IAVF_TX_DESC_CMD_REPORT_STATUS<<FD_IAVF_TX_DESC_CMD_SHIFT;
+  tx_queue->comp_ring[ tx_queue->comp_prod & (tx_queue->depth-1U) ] = tx_end;
+  tx_queue->comp_prod++;
+
+  fd_iavf_hw_dma_to_device();
+  *tx_queue->tail = (uint)(tx_end & (tx_queue->depth-1U));
+  FD_COMPILER_MFENCE();
+  tx_queue->posted = tx_end;
+}
+
+static ulong
+fd_iavf_hw_poll_tx( fd_iavf_tile_vf_t * vf,
+                    ulong *             comp_bytes ) {
+  fd_iavf_queue_t * tx_queue = &vf->tx_queue;
+  *comp_bytes = 0UL;
+  ulong const comp_cons = tx_queue->comp_cons;
+  if( comp_cons==tx_queue->comp_prod ) return 0UL;
+
+  ulong const         tx_end   = tx_queue->comp_ring[ comp_cons & (tx_queue->depth-1U) ];
+  uint const          desc_idx = (uint)((tx_end-1UL) & (tx_queue->depth-1U));
+  fd_iavf_tx_desc_t * desc     = (fd_iavf_tx_desc_t *)tx_queue->ring + desc_idx;
+  ulong const         cmd      = FD_VOLATILE_CONST( desc->cmd_type_offset_buffer_sz );
+  if( FD_LIKELY( (cmd & FD_IAVF_TX_DESC_TYPE_MASK)!=FD_IAVF_TX_DESC_DONE ) ) return 0UL;
+  FD_COMPILER_MFENCE();
+
+  ulong const tx_cons  = tx_queue->cons;
+  ulong const comp_cnt = tx_end-tx_cons;
+  for( ulong i=tx_cons; i<tx_end; i++ ) {
+    *comp_bytes += vf->tx_desc_frame_sz[ i & (tx_queue->depth-1U) ];
+  }
+  tx_queue->cons      = tx_end;
+  tx_queue->comp_cons = comp_cons+1UL;
+  return comp_cnt;
+}
+
+static int
+fd_iavf_hw_poll_rx( fd_iavf_tile_vf_t *      vf,
+                    fd_iavf_tile_rx_comp_t * comp,
+                    uint                     comp_capacity ) {
+  fd_iavf_queue_t * rx_queue   = &vf->rx_queue;
+  ulong             rx_cons    = rx_queue->cons;
+  uint const        comp_limit = fd_uint_min( comp_capacity, rx_queue->depth );
+  uint              comp_cnt   = 0U;
+  while( comp_cnt<comp_limit && rx_cons<rx_queue->posted ) {
+    uint const             desc_idx = (uint)(rx_cons & (rx_queue->depth-1U));
+    fd_iavf_hw_rx_desc_t * desc     = (fd_iavf_hw_rx_desc_t *)rx_queue->ring + desc_idx;
+    ulong const            status   = FD_VOLATILE_CONST( desc->qword[1] );
+
+    if( !(status & FD_IAVF_RX_DESC_DONE) ) break;
+
+    /* Drop frames that do not fit in one RX buffer. */
+    uint const end_of_packet = (uint)(0!=(status & FD_IAVF_RX_DESC_END_OF_PACKET));
+    uint const discard       = rx_queue->discard || !end_of_packet || (0!=(status & FD_IAVF_RX_DESC_MAC_ERR));
+    rx_queue->discard        = !end_of_packet;
+    comp[ comp_cnt++ ] = (fd_iavf_tile_rx_comp_t) {
+      .chunk         = vf->rx_desc_buf_chunk[ desc_idx ],
+      .discard       = discard,
+      .end_of_packet = end_of_packet,
+      .frame_sz      = (status>>FD_IAVF_RX_DESC_LENGTH_SHIFT) & FD_IAVF_RX_DESC_LENGTH_MASK
+    };
+    rx_cons++;
+  }
+  if( 0!=comp_cnt ) {
+    fd_iavf_hw_dma_from_device();
+    rx_queue->cons = rx_cons;
+  }
+  return (int)comp_cnt;
+}
+
+/* fd_iavf_tile_tx_chunk returns the buffer paired with TX descriptor tx_idx.
+   The buffer is reusable once tx_queue.cons advances past that descriptor. */
+static inline ulong
+fd_iavf_tile_tx_chunk( fd_iavf_tile_t const * ctx,
+                       ulong                  tx_idx ) {
+  fd_iavf_tile_vf_t const * vf = &ctx->vfs[ ctx->tx_vf_idx ];
+  return vf->tx_desc_buf_chunk[ tx_idx & (vf->tx_queue.depth-1U) ];
+}
+
+static inline void
+fd_iavf_tile_rx_recycle( fd_iavf_tile_t *    ctx,
+                         fd_iavf_tile_vf_t * vf,
+                         ulong               chunk ) {
+  vf->rx_pending_chunk[ vf->rx_pending_cnt++ ] = (uint)chunk;
+  /* Hold partial recycle batches, at most batch_size-1 RX buffers stay
+     unposted, avoiding a device-ordering barrier and RX tail write per packet. */
+  if( vf->rx_pending_cnt==ctx->batch_size ) {
+    FD_TEST( 0==fd_iavf_hw_rx_enqueue( vf, vf->rx_pending_cnt ) );
+    vf->rx_pending_cnt = 0U;
+  }
+}
+
+static ulong
+fd_iavf_tile_select_tx_vf( fd_iavf_tile_t * ctx,
+                           ulong            hash ) {
+  ulong available[ FD_IAVF_MEMBER_MAX ];
+  ulong available_cnt = 0UL;
+  for( ulong vf_idx=0UL; vf_idx<ctx->vf_cnt; vf_idx++ ) {
+    if( ctx->vfs[vf_idx].vf_info.link_usable ) {
+      available[ available_cnt++ ] = vf_idx;
+    }
+  }
+  return 0!=available_cnt ? available[ hash%available_cnt ] : ULONG_MAX;
+}
+
+static inline int
+fd_iavf_tile_poll_rx( fd_iavf_tile_t *    ctx,
+                      fd_stem_context_t * stem ) {
+  int busy                 = 0;
+  ulong const start_vf_idx  = ctx->rx_next_vf;
+  ctx->rx_next_vf           = (start_vf_idx+1UL)%ctx->vf_cnt;
+  for( ulong vf_idx=0UL; vf_idx<ctx->vf_cnt; vf_idx++ ) {
+    ulong const         actual_vf_idx = (start_vf_idx+vf_idx)%ctx->vf_cnt;
+    fd_iavf_tile_vf_t * vf            = &ctx->vfs[ actual_vf_idx ];
+
+    fd_iavf_tile_rx_comp_t comp[ FD_IAVF_BATCH_SIZE ];
+    int comp_cnt = fd_iavf_hw_poll_rx( vf, comp, ctx->batch_size );
+    if( 0==comp_cnt ) continue;
+    busy = 1;
+
+    int   active = vf->vf_info.link_usable;
+    ulong tspub  = (ulong)fd_frag_meta_ts_comp( fd_tickcount() );
+
+    for( uint i=0U; i<(uint)comp_cnt; i++ ) {
+      ulong const chunk = comp[ i ].chunk;
+      if( FD_UNLIKELY( chunk<ctx->net.pkt_buf_chunk0 || chunk>ctx->net.pkt_buf_wmark ) ) {
+        FD_LOG_CRIT(( "VF %lu RX completion chunk %lu out of bounds [%lu,%lu]",
+                      actual_vf_idx, chunk, ctx->net.pkt_buf_chunk0, ctx->net.pkt_buf_wmark ));
+      }
+      __builtin_prefetch( fd_chunk_to_laddr_const( ctx->net.pkt_buf_wksp_base, chunk ), 0, 3 );
+    }
+
+    for( uint i=0U; i<(uint)comp_cnt; i++ ) {
+      ulong freed_chunk = comp[i].chunk;
+      if( FD_UNLIKELY( !active ) ) ctx->metrics.rx_no_link_cnt += comp[i].end_of_packet;
+      else if( FD_UNLIKELY( comp[i].discard ) ) ctx->net.metrics.rx_drop_cnt[ FD_METRICS_ENUM_PKT_RX_DROP_REASON_V_MALFORMED_IDX ] += comp[i].end_of_packet;
+      else fd_net_rx_pkt( &ctx->net, stem, comp[i].chunk, comp[i].frame_sz, tspub, &freed_chunk, &ctx->metrics.non_fd_pkt_cnt );
+      if( FD_UNLIKELY( 0==freed_chunk ) ) FD_LOG_CRIT(( "invalid RX chunk in mcache" ));
+      fd_iavf_tile_rx_recycle( ctx, vf, freed_chunk );
+    }
+  }
+  return busy;
+}
+
+static inline int
+fd_iavf_tile_poll_tx( fd_iavf_tile_t *    ctx,
+                      fd_iavf_tile_vf_t * vf ) {
+  ulong comp_bytes;
+  ulong comp_cnt = fd_iavf_hw_poll_tx( vf, &comp_bytes );
+  ctx->net.metrics.tx_pkt_cnt     += comp_cnt;
+  ctx->net.metrics.tx_bytes_total += comp_bytes;
+  return !!comp_cnt;
+}
+
+/* fd_iavf_tile_lo_tx_flush drops unsent packets so socket backpressure
+   cannot stall RX or VF TX. */
+static void
+fd_iavf_tile_lo_tx_flush( fd_iavf_tile_t * ctx ) {
+  if( FD_UNLIKELY( 0==ctx->lo_tx_cnt ) ) return;
+  int const  send_cnt = sendmmsg( ctx->lo_tx_sock, ctx->lo_tx_msg, ctx->lo_tx_cnt, MSG_DONTWAIT );
+  uint const sent_cnt = -1==send_cnt ? 0U : (uint)send_cnt;
+  for( uint i=0U; i<sent_cnt; i++ ) ctx->net.metrics.tx_bytes_total += sizeof(fd_eth_hdr_t)+ctx->lo_tx_iov[ i ].iov_len;
+  ctx->net.metrics.tx_pkt_cnt += sent_cnt;
+  ctx->metrics.tx_loopback_fail_cnt += ctx->lo_tx_cnt-sent_cnt;
+  ctx->lo_tx_cnt = 0U;
+}
+
+static void
+fd_iavf_tile_lo_tx_enqueue( fd_iavf_tile_t *     ctx,
+                            fd_ip4_hdr_t const * ip4,
+                            ulong                ip_sz ) {
+  uint const           batch_idx = ctx->lo_tx_cnt;
+  struct mmsghdr *     msg       = ctx->lo_tx_msg  + batch_idx;
+  struct sockaddr_in * sa        = ctx->lo_tx_addr + batch_idx;
+  struct iovec *       iov       = ctx->lo_tx_iov  + batch_idx;
+  uchar *              buf       = ctx->lo_tx_buf[ batch_idx ];
+
+  *iov = (struct iovec) {
+    .iov_base = buf,
+    .iov_len  = ip_sz,
+  };
+  sa->sin_family      = AF_INET;
+  sa->sin_addr.s_addr = ip4->daddr;
+  sa->sin_port        = 0; /* Linux raw sockets ignore sin_port */
+
+  *msg = (struct mmsghdr) {
+    .msg_hdr = {
+      .msg_name    = sa,
+      .msg_namelen = sizeof(struct sockaddr_in),
+      .msg_iov     = iov,
+      .msg_iovlen  = 1UL
+    }
+  };
+
+  fd_memcpy( buf, ip4, ip_sz );
+  ctx->lo_tx_cnt++;
+  if( ctx->lo_tx_cnt==FD_IAVF_BATCH_SIZE ) fd_iavf_tile_lo_tx_flush( ctx );
+  else if( ctx->lo_tx_cnt==1U ) ctx->lo_tx_deadline_ticks = fd_tickcount()+ctx->lo_tx_timeout_ticks;
+}
+
+static inline void
+before_credit( fd_iavf_tile_t *    ctx,
+               fd_stem_context_t * stem,
+               int *               charge_busy ) {
+  fd_net_router_solicit( &ctx->router, stem );
+  long now = fd_tickcount();
+  if( 0!=ctx->lo_tx_cnt && now>=ctx->lo_tx_deadline_ticks ) {
+    fd_iavf_tile_lo_tx_flush( ctx );
+    *charge_busy = 1;
+  }
+  for( ulong i=0UL; i<ctx->vf_cnt; i++ ) {
+    fd_iavf_tile_vf_t * vf       = &ctx->vfs[i];
+    fd_iavf_queue_t *   tx_queue = &vf->tx_queue;
+    if( tx_queue->prod!=tx_queue->posted && now>=vf->tx_flush_deadline_ticks ) {
+      fd_iavf_hw_tx_flush( tx_queue );
+      *charge_busy = 1;
+    }
+    if( tx_queue->cons!=tx_queue->posted ) *charge_busy |= fd_iavf_tile_poll_tx( ctx, vf );
+  }
+}
+
+static inline void
+after_credit( fd_iavf_tile_t *    ctx,
+              fd_stem_context_t * stem,
+              int *               poll_in,
+              int *               charge_busy ) {
+  (void)poll_in;
+  *charge_busy |= fd_iavf_tile_poll_rx( ctx, stem );
+}
+
+/* before_frag resolves the TX route and checks for space in the TX descriptor ring. */
+static inline int
+before_frag( fd_iavf_tile_t * ctx,
+             ulong            in_idx,
+             ulong            seq,
+             ulong            sig ) {
+  (void)seq;
+  if( FD_UNLIKELY( ctx->net.in_kind[ in_idx ]==FD_NET_IN_KIND_IPROUTE ) ) return 0;
+
+  /* Resolve the TX route for outgoing packets */
+  ulong dst_proto = fd_disco_netmux_sig_proto( sig );
+  if( FD_UNLIKELY( dst_proto!=DST_PROTO_OUTGOING ) ) return 1;
+
+  ulong const hash       = fd_disco_netmux_sig_hash( sig );
+  ulong       target_idx = hash % ctx->net.tile_cnt;
+  ulong const kind_id    = ctx->net.kind_id;
+  if( 0!=kind_id && kind_id!=target_idx ) return 1;
+
+  uint const dst_ip = fd_disco_netmux_sig_ip( sig );
+  if( kind_id!=target_idx ) {
+    /* Tile 0 probes for loopback without counting another tile's route failures. */
+    fd_fib4_hop_t hop[2];
+    hop[0] = fd_fib4_lookup( ctx->router.fib_local, dst_ip, 0UL );
+    hop[1] = fd_fib4_lookup( ctx->router.fib_main,  dst_ip, 0UL );
+    fd_fib4_hop_t const * next_hop = fd_fib4_hop_or( hop+0, hop+1 );
+    if( next_hop->rtype!=FD_FIB4_RTYPE_LOCAL && next_hop->rtype!=FD_FIB4_RTYPE_UNICAST ) return 1;
+    uint const if_idx = next_hop->rtype==FD_FIB4_RTYPE_LOCAL ? 1U : next_hop->if_idx;
+    fd_netdev_t const * netdev = fd_netdev_tbl_query( &ctx->router.netdev_tbl, if_idx );
+    if( NULL==netdev || netdev->dev_type!=ARPHRD_LOOPBACK ) return 1;
+  }
+
+  fd_net_tx_route_t * route  = &ctx->net.tx_route;
+  if( FD_UNLIKELY( !fd_net_tx_route( &ctx->router, &ctx->net, dst_ip, route ) ) ) return 1;
+  if( FD_UNLIKELY( route->use_gre ) ) {
+    fd_net_tx_route_t outer_route;
+    uint const inner_src_ip = route->src_ip;
+    uint const outer_src_ip = route->gre_outer_src_ip;
+    uint const outer_dst_ip = route->gre_outer_dst_ip;
+
+    if( FD_UNLIKELY( 0==inner_src_ip || 0==outer_dst_ip ) ) {
+      ctx->net.metrics.tx_drop_cnt[ FD_METRICS_ENUM_PKT_TX_DROP_REASON_V_GRE_NO_ROUTE_IDX ]++;
+      return 1;
+    }
+    /* fd_net_tx_route counts its own drop reason */
+    if( FD_UNLIKELY( !fd_net_tx_route( &ctx->router, &ctx->net, outer_dst_ip, &outer_route ) ) ) return 1;
+    if( FD_UNLIKELY( outer_route.use_gre || outer_route.use_loopback ) ) {
+      ctx->net.metrics.tx_drop_cnt[ FD_METRICS_ENUM_PKT_TX_DROP_REASON_V_GRE_NO_ROUTE_IDX ]++;
+      return 1;
+    }
+    *route                  = outer_route;
+    route->src_ip           = inner_src_ip;
+    route->gre_outer_src_ip = fd_uint_if( 0==outer_src_ip, outer_route.src_ip, outer_src_ip );
+    route->gre_outer_dst_ip = outer_dst_ip;
+    route->use_gre          = 1U;
+  }
+
+  if( route->use_loopback ) target_idx = 0UL;
+  if( kind_id!=target_idx ) return 1;
+
+  ctx->tx_vf_idx = route->use_loopback ? 0UL : fd_iavf_tile_select_tx_vf( ctx, hash );
+  if( FD_UNLIKELY( ctx->tx_vf_idx==ULONG_MAX ) ) {
+    ctx->metrics.tx_no_link_cnt++;
+    return 1;
+  }
+  fd_iavf_queue_t const * tx_queue = &ctx->vfs[ ctx->tx_vf_idx ].tx_queue;
+  if( FD_UNLIKELY( !route->use_loopback && tx_queue->prod-tx_queue->cons>=tx_queue->depth-1UL ) ) {
+    ctx->metrics.tx_no_buffer_cnt++;
+    return 1;
+  }
+
+  return 0;
+}
+
+/* during_frag validates and stages the input packet or route update */
+static inline void
+during_frag( fd_iavf_tile_t * ctx,
+             ulong            in_idx,
+             ulong            seq,
+             ulong            sig,
+             ulong            chunk,
+             ulong            frame_sz,
+             ulong            ctl ) {
+  (void)seq; (void)sig; (void)ctl;
+  fd_net_in_frag_validate( &ctx->net, in_idx, chunk, frame_sz );
+
+  if( FD_UNLIKELY( fd_net_iproute_msg_stage( &ctx->net, in_idx, chunk, frame_sz ) ) ) return;
+
+  ulong   dst_chunk = fd_iavf_tile_tx_chunk( ctx, ctx->vfs[ ctx->tx_vf_idx ].tx_queue.prod );
+  uchar * dst       = fd_chunk_to_laddr( ctx->net.pkt_buf_wksp_base, dst_chunk );
+  /* Speculatively copy frame from in link into buffer */
+  fd_net_tx_pkt_cpy( &ctx->net, dst, chunk, frame_sz, in_idx );
+}
+
+/* after_frag enqueues the staged frame or applies the route update only
+   after stem checks that the input was not overwritten during the copy. */
+static void
+after_frag( fd_iavf_tile_t *    ctx,
+            ulong               in_idx,
+            ulong               seq,
+            ulong               sig,
+            ulong               frame_sz,
+            ulong               tsorig,
+            ulong               tspub,
+            fd_stem_context_t * stem ) {
+  (void)seq; (void)sig; (void)tsorig; (void)tspub;
+
+  if( FD_UNLIKELY( ctx->net.in_kind[ in_idx ]==FD_NET_IN_KIND_IPROUTE ) ) {
+    fd_iproute_msg_t const * msg = &ctx->net.iproute_msg;
+    if( msg->op==FD_IPROUTE_OP_FLUSH ) {
+      fd_fib4_clear( ctx->router.fib_local );
+      fd_fib4_clear( ctx->router.fib_main );
+      return;
+    }
+
+    fd_fib4_t * fib;
+    if( msg->table_id==RT_TABLE_LOCAL )     fib = ctx->router.fib_local;
+    else if( msg->table_id==RT_TABLE_MAIN ) fib = ctx->router.fib_main;
+    else return;
+
+    if( msg->op==FD_IPROUTE_OP_UPSERT && FD_UNLIKELY( !fd_fib4_insert( fib, msg->dst_addr, msg->prefix, msg->prio, &msg->hop ) ) ) {
+      FD_LOG_WARNING(( "route update dropped: route table full (increase [net.max_routes] or [net.max_peer_routes])" ));
+      fd_stem_publish( stem, ctx->router.netlnk_out_idx, FD_NETLINK_ROUTE4_SYNC_SIG, 0UL, 0UL, 0UL, 0UL, fd_frag_meta_ts_comp( fd_tickcount() ) );
+    } else if( msg->op==FD_IPROUTE_OP_DELETE ) {
+      fd_fib4_remove( fib, msg->dst_addr, msg->prefix, msg->prio );
+    }
+    return;
+  }
+
+  ulong               chunk    = fd_iavf_tile_tx_chunk( ctx, ctx->vfs[ ctx->tx_vf_idx ].tx_queue.prod );
+  uchar *             frame    = fd_chunk_to_laddr( ctx->net.pkt_buf_wksp_base, chunk );
+  fd_iavf_tile_vf_t * vf       = &ctx->vfs[ ctx->tx_vf_idx ];
+  fd_iavf_queue_t *   tx_queue = &vf->tx_queue;
+
+  if( FD_UNLIKELY( !fd_net_tx_pkt_prep( &ctx->net, frame, &frame_sz, in_idx ) ) ) return;
+
+  if( FD_UNLIKELY( ctx->net.tx_route.use_loopback ) ) {
+    fd_eth_hdr_t const * eth_hdr   = (fd_eth_hdr_t const *)frame;
+    fd_ip4_hdr_t const * ip4       = (fd_ip4_hdr_t const *)(eth_hdr+1);
+    ulong const          ip_hdr_sz = FD_IP4_GET_LEN( *ip4 );
+    ulong const          ip_sz     = fd_ushort_bswap( ip4->net_tot_len );
+    if( FD_UNLIKELY( ip4->protocol!=FD_IP4_HDR_PROTOCOL_UDP ||
+                     ip4->daddr!=fd_disco_netmux_sig_ip( sig ) ||
+                     (fd_ushort_bswap( ip4->net_frag_off ) & ~FD_IP4_HDR_FRAG_OFF_DF) ||
+                     ip_sz<ip_hdr_sz+sizeof(fd_udp_hdr_t) ||
+                     ip_sz>frame_sz-sizeof(fd_eth_hdr_t) ) ) {
+      ctx->net.metrics.tx_drop_cnt[ FD_METRICS_ENUM_PKT_TX_DROP_REASON_V_INVALID_IDX ]++;
+      return;
+    }
+    fd_udp_hdr_t const * udp    = (fd_udp_hdr_t const *)((uchar const *)ip4+ip_hdr_sz);
+    ulong const          udp_sz = fd_ushort_bswap( udp->net_len );
+    if( FD_UNLIKELY( udp_sz<sizeof(fd_udp_hdr_t) || udp_sz>ip_sz-ip_hdr_sz ) ) {
+      ctx->net.metrics.tx_drop_cnt[ FD_METRICS_ENUM_PKT_TX_DROP_REASON_V_INVALID_IDX ]++;
+      return;
+    }
+
+    int owns_udp_dst = 0;
+    if( 0==ctx->router.bind_address || ctx->router.bind_address==ip4->daddr ) {
+      ushort const dst_port = fd_ushort_bswap( udp->net_dport );
+      for( ulong i=0UL; i<ctx->net.dst_port_cnt; i++ ) owns_udp_dst |= ctx->net.dst_ports[ i ]==dst_port;
+    }
+    if( !owns_udp_dst ) {
+      fd_iavf_tile_lo_tx_enqueue( ctx, ip4, ip_sz );
+      return;
+    }
+
+    ulong freed_chunk;
+    if( fd_net_rx_pkt( &ctx->net, stem, chunk, frame_sz, (ulong)fd_frag_meta_ts_comp( fd_tickcount() ), &freed_chunk, NULL ) ) {
+      vf->tx_desc_buf_chunk[ tx_queue->prod & (tx_queue->depth-1U) ] = (uint)freed_chunk;
+    }
+    ctx->net.metrics.tx_pkt_cnt++;
+    ctx->net.metrics.tx_bytes_total += frame_sz;
+    return;
+  }
+
+  fd_iavf_hw_tx_enqueue( vf, frame_sz );
+  ctx->net.metrics.tx_gre_cnt += (ulong)ctx->net.tx_route.use_gre;
+  ulong const pending_desc_cnt = tx_queue->prod-tx_queue->posted;
+  if( pending_desc_cnt>=ctx->batch_size || tx_queue->prod-tx_queue->cons>=tx_queue->depth-1UL ) {
+    fd_iavf_hw_tx_flush( tx_queue );
+  } else if( pending_desc_cnt==1UL ) {
+    vf->tx_flush_deadline_ticks = fd_tickcount()+ctx->tx_flush_timeout_ticks;
+  }
+}
+
+static inline void
+metrics_write( fd_iavf_tile_t * ctx ) {
+
+  ulong rx_buffer_idle_cnt = 0UL;
+  ulong rx_buffer_busy_cnt = 0UL;
+  ulong tx_buffer_idle_cnt = 0UL;
+  ulong tx_buffer_busy_cnt = 0UL;
+  for( ulong i=0UL; i<ctx->vf_cnt; i++ ) {
+    fd_iavf_queue_t const * rx_queue = &ctx->vfs[i].rx_queue;
+    fd_iavf_queue_t const * tx_queue = &ctx->vfs[i].tx_queue;
+    ulong const             tx_capacity = tx_queue->depth-1UL;
+    ulong                   rx_idle = fd_ulong_min( rx_queue->prod-rx_queue->cons, rx_queue->depth );
+    ulong                   tx_busy = fd_ulong_min( tx_queue->prod-tx_queue->cons, tx_capacity );
+    rx_buffer_idle_cnt += rx_idle;
+    rx_buffer_busy_cnt += rx_queue->depth-rx_idle;
+    tx_buffer_busy_cnt += tx_busy;
+    tx_buffer_idle_cnt += tx_capacity-tx_busy;
+  }
+  FD_MCNT_SET(   IAVF, PKT_RX,                 ctx->net.metrics.rx_pkt_cnt           );
+  FD_MCNT_SET(   IAVF, PKT_RX_BYTES,           ctx->net.metrics.rx_bytes_total       );
+  FD_MCNT_ENUM_COPY( IAVF, PKT_RX_DROPPED, ctx->net.metrics.rx_drop_cnt        );
+  FD_MCNT_SET(   IAVF, PKT_RX_NO_LINK_DROPPED, ctx->metrics.rx_no_link_cnt           );
+  FD_MCNT_SET(   IAVF, NON_FD_PKT_RX,          ctx->metrics.non_fd_pkt_cnt           );
+  FD_MCNT_SET(   IAVF, GRE_PKT_RX,             ctx->net.metrics.rx_gre_cnt           );
+  FD_MGAUGE_SET( IAVF, RX_BUFFER_USED,         rx_buffer_busy_cnt                    );
+  FD_MGAUGE_SET( IAVF, RX_BUFFER_FREE,         rx_buffer_idle_cnt                    );
+
+  FD_MCNT_SET(   IAVF, PKT_TX_COMPLETED,       ctx->net.metrics.tx_pkt_cnt            );
+  FD_MCNT_SET(   IAVF, PKT_TX_COMPLETED_BYTES, ctx->net.metrics.tx_bytes_total        );
+  ctx->net.metrics.tx_drop_cnt[ FD_METRICS_ENUM_PKT_TX_DROP_REASON_V_NO_NEIGHBOR_IDX ] = ctx->router.metrics.tx_neigh_fail_cnt;
+  ctx->net.metrics.tx_drop_cnt[ FD_METRICS_ENUM_PKT_TX_DROP_REASON_V_RING_FULL_IDX   ] = ctx->metrics.tx_no_buffer_cnt;
+  FD_MCNT_ENUM_COPY( IAVF, PKT_TX_DROPPED,     ctx->net.metrics.tx_drop_cnt           );
+  FD_MCNT_SET(   IAVF, PKT_TX_NO_LINK_DROPPED, ctx->metrics.tx_no_link_cnt            );
+  FD_MCNT_SET(   IAVF, PKT_TX_LOOPBACK_FAILED, ctx->metrics.tx_loopback_fail_cnt      );
+  FD_MCNT_SET(   IAVF, GRE_PKT_TX_SUBMITTED,   ctx->net.metrics.tx_gre_cnt            );
+  FD_MGAUGE_SET( IAVF, TX_BUFFER_USED,         tx_buffer_busy_cnt                     );
+  FD_MGAUGE_SET( IAVF, TX_BUFFER_FREE,         tx_buffer_idle_cnt                     );
+}
+
+static inline void
+fd_iavf_tile_publish_vf_link( fd_iavf_tile_t * ctx,
+                              ulong            vf_idx ) {
+  ulong const usable = (ulong)ctx->vfs[vf_idx].vf_info.link_usable;
+  __atomic_store_n( &ctx->vf_link_usable[vf_idx], usable, __ATOMIC_RELEASE );
+}
+
+static inline void
+fd_iavf_tile_vf_housekeeping( fd_iavf_tile_t * ctx ) {
+  /* Other tiles read tile 0's link decisions */
+  if( 0!=ctx->net.kind_id ) {
+    for( ulong vf_idx=0UL; vf_idx<ctx->vf_cnt; vf_idx++ ) {
+      ctx->vfs[vf_idx].vf_info.link_usable = (int)__atomic_load_n( &ctx->vf_link_usable_shared[vf_idx], __ATOMIC_ACQUIRE );
+    }
+    return;
+  }
+
+  /* There is no need to check VF state on every housekeeping pass */
+  long const now = fd_tickcount();
+  if( FD_LIKELY( now<ctx->vf_housekeeping_deadline_ticks ) ) return;
+  ctx->vf_housekeeping_deadline_ticks = now+ctx->vf_housekeeping_interval_ticks;
+
+  /* Only tile 0 consumes PF events */
+  for( ulong vf_idx=0UL; vf_idx<ctx->vf_cnt; vf_idx++ ) {
+    fd_iavf_tile_vf_t * vf = &ctx->vfs[vf_idx];
+    int changed;
+    if( FD_UNLIKELY( -1==fd_iavf_virtchnl_poll_link( &vf->vfio, &vf->adminq, &vf->vf_info, &changed ) ) ) {
+      FD_LOG_ERR(( "PF member %lu VF link event or reset failure (%i-%s)", vf_idx, errno, fd_io_strerror( errno ) ));
+    }
+    if( changed ) {
+      fd_iavf_tile_publish_vf_link( ctx, vf_idx );
+      FD_LOG_INFO(( "PF member %lu VF link %s", vf_idx, vf->vf_info.link_usable ? "up" : "down" ));
+    }
+  }
+}
+
+static inline void
+during_housekeeping( fd_iavf_tile_t * ctx ) {
+  fd_iavf_tile_vf_housekeeping( ctx );
+
+  if( FD_UNLIKELY( fd_netdev_tbl_refresh( &ctx->router.netdev_tbl, &ctx->router.netdev_shared, &ctx->netdev_seq ) ) ) {
+    fd_net_gre_tunnels_refresh( &ctx->net, &ctx->router.netdev_tbl );
+  }
+}
+
+static uint
+fd_iavf_tile_if_ip4_addr( char const * if_name ) {
+  int sock_fd = socket( AF_INET, SOCK_DGRAM, 0 );
+  if( FD_UNLIKELY( -1==sock_fd ) ) {
+    FD_LOG_ERR(( "socket(AF_INET,SOCK_DGRAM) failed (%i-%s)", errno, fd_io_strerror( errno ) ));
+  }
+
+  struct ifreq ifr = { .ifr_addr.sa_family = AF_INET };
+  fd_cstr_ncpy( ifr.ifr_name, if_name, sizeof(ifr.ifr_name) );
+
+  if( FD_UNLIKELY( -1==ioctl( sock_fd, SIOCGIFADDR, &ifr ) ) ) {
+    FD_LOG_ERR(( "could not get IP address of interface `%s` (%i-%s)",
+                 if_name, errno, fd_io_strerror( errno ) ));
+  }
+  uint ip4_addr = ((struct sockaddr_in *)fd_type_pun( &ifr.ifr_addr ))->sin_addr.s_addr;
+  if( FD_UNLIKELY( -1==close( sock_fd ) ) ) {
+    FD_LOG_ERR(( "close() failed (%i-%s)", errno, fd_io_strerror( errno ) ));
+  }
+
+  return ip4_addr;
+}
+
+/* fd_iavf_tile_lo_tx_socket uses IPPROTO_RAW for send only IP_HDRINCL
+   transmission, preserving the source address and UDP source port. */
+static int
+fd_iavf_tile_lo_tx_socket( void ) {
+  int sock = socket( AF_INET, SOCK_RAW|SOCK_CLOEXEC|SOCK_NONBLOCK, IPPROTO_RAW );
+  if( FD_UNLIKELY( -1==sock ) ) {
+    FD_LOG_ERR(( "socket(AF_INET,SOCK_RAW,IPPROTO_RAW) failed (%i-%s)", errno, fd_io_strerror( errno ) ));
+  }
+  if( FD_UNLIKELY( -1==setsockopt( sock, SOL_SOCKET, SO_BINDTODEVICE, "lo", sizeof("lo") ) ) ) {
+    FD_LOG_ERR(( "setsockopt(SO_BINDTODEVICE,lo) failed (%i-%s)", errno, fd_io_strerror( errno ) ));
+  }
+  return sock;
+}
+
+static ulong
+scratch_align( void ) {
+  return FD_IAVF_PAGE_SZ;
+}
+
+static ulong
+scratch_footprint( fd_topo_tile_t const * tile ) {
+  ulong queue_sz = fd_iavf_queue_footprint( tile->iavf.tx_queue_size, tile->iavf.rx_queue_size );
+  if( FD_UNLIKELY( 0==queue_sz ) ) return 0UL;
+  ulong layout = FD_LAYOUT_INIT;
+  layout       = FD_LAYOUT_APPEND( layout, alignof(fd_iavf_tile_t), sizeof(fd_iavf_tile_t) );
+  for( ulong i=0UL; i<tile->iavf.member_cnt; i++ ) {
+    if( 0==tile->kind_id ) layout = FD_LAYOUT_APPEND( layout, FD_IAVF_PAGE_SZ, fd_iavf_adminq_footprint() );
+    layout = FD_LAYOUT_APPEND( layout, FD_IAVF_PAGE_SZ, queue_sz                                );
+    layout = FD_LAYOUT_APPEND( layout, alignof(uint),   tile->iavf.rx_queue_size*sizeof(uint)   );
+    layout = FD_LAYOUT_APPEND( layout, alignof(uint),   tile->iavf.tx_queue_size*sizeof(uint)   );
+    layout = FD_LAYOUT_APPEND( layout, alignof(ushort), tile->iavf.tx_queue_size*sizeof(ushort) );
+  }
+  layout = FD_LAYOUT_APPEND( layout, fd_netdev_tbl_align(), fd_netdev_tbl_footprint( NETDEV_MAX, BOND_MASTER_MAX )               );
+  layout = FD_LAYOUT_APPEND( layout, fd_fib4_align(),       fd_fib4_footprint( tile->iavf.route_max, tile->iavf.route_peer_max ) );
+  layout = FD_LAYOUT_APPEND( layout, fd_fib4_align(),       fd_fib4_footprint( tile->iavf.route_max, tile->iavf.route_peer_max ) );
+  return FD_LAYOUT_FINI( layout, scratch_align() );
+}
+
+fd_fib4_t *
+fd_iavf_tile_fib4_join( fd_fib4_t *            out,
+                        fd_topo_t const *      topo,
+                        fd_topo_tile_t const * tile,
+                        int                    main_table ) {
+  FD_SCRATCH_ALLOC_INIT( scratch, fd_topo_obj_laddr( topo, tile->tile_obj_id ) );
+  (void)FD_SCRATCH_ALLOC_APPEND( scratch, alignof(fd_iavf_tile_t), sizeof(fd_iavf_tile_t) );
+  ulong queue_sz = fd_iavf_queue_footprint( tile->iavf.tx_queue_size, tile->iavf.rx_queue_size );
+  for( ulong i=0UL; i<tile->iavf.member_cnt; i++ ) {
+    if( 0==tile->kind_id ) (void)FD_SCRATCH_ALLOC_APPEND( scratch, FD_IAVF_PAGE_SZ, fd_iavf_adminq_footprint() );
+    (void)FD_SCRATCH_ALLOC_APPEND( scratch, FD_IAVF_PAGE_SZ, queue_sz                                );
+    (void)FD_SCRATCH_ALLOC_APPEND( scratch, alignof(uint),   tile->iavf.rx_queue_size*sizeof(uint)   );
+    (void)FD_SCRATCH_ALLOC_APPEND( scratch, alignof(uint),   tile->iavf.tx_queue_size*sizeof(uint)   );
+    (void)FD_SCRATCH_ALLOC_APPEND( scratch, alignof(ushort), tile->iavf.tx_queue_size*sizeof(ushort) );
+  }
+  (void)FD_SCRATCH_ALLOC_APPEND( scratch,              fd_netdev_tbl_align(), fd_netdev_tbl_footprint( NETDEV_MAX, BOND_MASTER_MAX )               );
+  void * local_mem = FD_SCRATCH_ALLOC_APPEND( scratch, fd_fib4_align(),       fd_fib4_footprint( tile->iavf.route_max, tile->iavf.route_peer_max ) );
+  void * main_mem  = FD_SCRATCH_ALLOC_APPEND( scratch, fd_fib4_align(),       fd_fib4_footprint( tile->iavf.route_max, tile->iavf.route_peer_max ) );
+  return fd_fib4_join( out, main_table ? main_mem : local_mem );
+}
+
+/* fd_iavf_tile_join_pkt_bufs uses workspace offsets for packet IOVAs so
+   descriptors can address buffers directly as chunk<<FD_CHUNK_LG_SZ. */
+static void
+fd_iavf_tile_join_pkt_bufs( fd_topo_t const *      topo,
+                            fd_topo_tile_t const * tile,
+                            fd_iavf_tile_t *       ctx,
+                            void **                packet_memory,
+                            ulong *                packet_memory_sz,
+                            ulong *                packet_iova ) {
+  void * const packet_dcache_memory = fd_topo_obj_laddr( topo, tile->net.umem_dcache_obj_id );
+  void * const packet_dcache        = fd_dcache_join( packet_dcache_memory );
+  FD_TEST( NULL!=packet_dcache );
+  ulong const packet_dcache_data_sz = fd_dcache_data_sz( packet_dcache );
+  ulong const frame_sz              = FD_NET_MTU;
+  ulong const frame_region_sz       = fd_ulong_align_dn( packet_dcache_data_sz, frame_sz );
+  FD_TEST( frame_region_sz>=frame_sz && frame_region_sz<=ULONG_MAX-FD_IAVF_PAGE_SZ &&
+           (ulong)packet_dcache<=ULONG_MAX-frame_region_sz-FD_IAVF_PAGE_SZ );
+
+  void * const workspace_base = fd_wksp_containing( packet_dcache_memory );
+  FD_TEST( NULL!=workspace_base );
+  ulong const pkt_buf_chunk0 = ((ulong)packet_dcache-(ulong)workspace_base)>>FD_CHUNK_LG_SZ;
+  ulong const pkt_buf_wmark  = pkt_buf_chunk0 + ((frame_region_sz-frame_sz)>>FD_CHUNK_LG_SZ);
+  if( FD_UNLIKELY( 0==pkt_buf_chunk0 || pkt_buf_chunk0>UINT_MAX || pkt_buf_wmark>UINT_MAX || pkt_buf_chunk0>pkt_buf_wmark ) ) {
+    FD_LOG_ERR(( "Calculated invalid packet buffer bounds [%lu,%lu]", pkt_buf_chunk0, pkt_buf_wmark ));
+  }
+
+  ctx->net.pkt_buf_wksp_base = workspace_base;
+  ctx->net.pkt_buf_chunk0    = pkt_buf_chunk0;
+  ctx->net.pkt_buf_wmark     = pkt_buf_wmark;
+  if( NULL!=packet_memory    ) *packet_memory    = packet_dcache;
+  /* VFIO_IOMMU_MAP_DMA requires whole pages. */
+  if( NULL!=packet_memory_sz ) *packet_memory_sz = fd_ulong_align_up( frame_region_sz, FD_IAVF_PAGE_SZ );
+  if( NULL!=packet_iova      ) *packet_iova      = (ulong)packet_dcache-(ulong)workspace_base;
+}
+
+FD_FN_UNUSED static void
+fd_iavf_tile_init_pkt_bufs( fd_topo_t const *      topo,
+                            fd_topo_tile_t const * tile,
+                            fd_iavf_tile_t *       ctx ) {
+  ulong frame_chunks = FD_NET_MTU>>FD_CHUNK_LG_SZ;
+  ulong next_chunk   = ctx->net.pkt_buf_chunk0;
+  FD_TEST( tile->iavf.rx_queue_size>ctx->batch_size );
+  ulong const rx_fill_cnt = tile->iavf.rx_queue_size-ctx->batch_size;
+  for( ulong i=0UL; i<ctx->vf_cnt; i++ ) {
+    fd_iavf_tile_vf_t * vf = &ctx->vfs[i];
+    /* Post initial RX buffers */
+    for( ulong j=0UL; j<rx_fill_cnt; j++ ) {
+      fd_iavf_tile_rx_recycle( ctx, vf, next_chunk );
+      next_chunk += frame_chunks;
+    }
+
+    /* Reserve one packet buffer per TX descriptor */
+    for( ulong j=0UL; j<tile->iavf.tx_queue_size; j++ ) {
+      vf->tx_desc_buf_chunk[j] = (uint)next_chunk;
+      next_chunk += frame_chunks;
+    }
+  }
+
+  /* Reserve packet buffers for output mcache entries */
+  for( ulong i=0UL; i<tile->out_cnt; i++ ) {
+    fd_topo_link_t const * link   = &topo->links[ tile->out_link_id[i] ];
+    fd_frag_meta_t *       mcache = fd_mcache_join( fd_topo_obj_laddr( topo, link->mcache_obj_id ) );
+    FD_TEST( NULL!=mcache );
+    ulong depth = fd_mcache_depth( mcache );
+    for( ulong j=0UL; j<depth; j++ ) {
+      mcache[j].chunk = (uint)next_chunk;
+      mcache[j].seq   = fd_seq_dec( j, 1UL );
+      next_chunk += frame_chunks;
+    }
+  }
+  if( FD_UNLIKELY( next_chunk-frame_chunks>ctx->net.pkt_buf_wmark ) ) {
+    ulong const required_sz  = (next_chunk-ctx->net.pkt_buf_chunk0)<<FD_CHUNK_LG_SZ;
+    ulong const available_sz = ((ctx->net.pkt_buf_wmark-ctx->net.pkt_buf_chunk0)<<FD_CHUNK_LG_SZ)+FD_NET_MTU;
+    FD_LOG_ERR(( "packet dcache needs %lu bytes, available %lu", required_sz, available_sz ));
+  }
+}
+
+FD_FN_UNUSED static void
+fd_iavf_tile_join_obj_workspace( fd_topo_t * topo,
+                                 ulong       obj_id ) {
+  fd_topo_wksp_t * wksp = &topo->workspaces[ topo->objs[obj_id].wksp_id ];
+  if( NULL==wksp->wksp ) fd_topo_join_workspace( topo, wksp, FD_SHMEM_JOIN_MODE_READ_WRITE, 0 );
+}
+
+#ifndef FD_TILE_TEST
+void
+fd_topo_install_iavf( fd_topo_t *     topo,
+                      fd_iavf_fds_t * fds ) {
+  ulong const tile_cnt = fd_topo_tile_name_cnt( topo, "iavf" );
+  if( FD_UNLIKELY( 0==tile_cnt || tile_cnt>FD_IAVF_TILE_MAX ) ) {
+    FD_LOG_ERR(( "IAVF net tile count %lu must be in [1,%lu]", tile_cnt, FD_IAVF_TILE_MAX ));
+  }
+  fd_iavf_tile_t *       ctxs  [ FD_IAVF_TILE_MAX ];
+  fd_topo_tile_t const * tiles [ FD_IAVF_TILE_MAX ];
+  fd_iavf_vfio_tile_t    queues[ FD_IAVF_MEMBER_MAX ][ FD_IAVF_TILE_MAX ];
+
+  /* Prepare tile memory and collect queue pairs by VF */
+  for( ulong tile_idx=0UL; tile_idx<tile_cnt; tile_idx++ ) {
+    ulong const tile_id = fd_topo_find_tile( topo, "iavf", tile_idx );
+    FD_TEST( tile_id!=ULONG_MAX );
+    fd_topo_tile_t const * tile = &topo->tiles[tile_id];
+    tiles[tile_idx] = tile;
+
+    fd_iavf_tile_join_obj_workspace( topo, tile->tile_obj_id );
+    fd_iavf_tile_join_obj_workspace( topo, tile->net.umem_dcache_obj_id );
+    for( ulong out_idx=0UL; out_idx<tile->out_cnt; out_idx++ ) {
+      fd_iavf_tile_join_obj_workspace( topo, topo->links[ tile->out_link_id[out_idx] ].mcache_obj_id );
+    }
+    fd_iavf_tile_t * ctx = fd_topo_obj_laddr( topo, tile->tile_obj_id );
+    ctxs[tile_idx] = ctx;
+    fd_memset( ctx, 0, sizeof(*ctx) );
+    ctx->vf_cnt                = tile->iavf.member_cnt;
+    ctx->batch_size            = FD_IAVF_BATCH_SIZE;
+    ctx->net.kind_id           = tile_idx;
+    ctx->net.tile_cnt          = tile_cnt;
+    ctx->vf_link_usable_shared = ctxs[0]->vf_link_usable;
+    fd_iavf_hw_join_queues( ctx, tile );
+
+    void * packet_memory;
+    ulong  packet_memory_sz;
+    ulong  packet_iova;
+    fd_iavf_tile_join_pkt_bufs( topo, tile, ctx, &packet_memory, &packet_memory_sz, &packet_iova );
+    for( ulong vf_idx=0UL; vf_idx<ctx->vf_cnt; vf_idx++ ) {
+      fd_iavf_tile_vf_t * vf = &ctx->vfs[vf_idx];
+      queues[vf_idx][tile_idx] = (fd_iavf_vfio_tile_t) {
+        .tx_queue         = &vf->tx_queue,
+        .rx_queue         = &vf->rx_queue,
+        .queue_memory     = vf->queue_memory,
+        .queue_memory_sz  = fd_iavf_queue_footprint( vf->tx_queue.depth, vf->rx_queue.depth ),
+        .packet_memory    = packet_memory,
+        .packet_memory_sz = packet_memory_sz,
+        .packet_iova      = packet_iova
+      };
+    }
+    fd_net_rx_dst_ports_init( &ctx->net, topo, tile );
+  }
+
+  /* Configure VFs through tile 0's Admin Queues */
+  fd_topo_tile_t const * first_tile = tiles[0];
+  fd_iavf_tile_t *       owner      = ctxs[0];
+  for( ulong vf_idx=0UL; vf_idx<owner->vf_cnt; vf_idx++ ) {
+    fd_iavf_tile_vf_t * vf = &owner->vfs[vf_idx];
+    char const * pf_if = first_tile->iavf.members[vf_idx];
+    char vf_pci[ FD_IAVF_PCI_ADDR_SZ ];
+    if( FD_UNLIKELY( -1==fd_iavf_get_last_vf( pf_if, NULL, vf_pci ) ) ) {
+      FD_LOG_ERR(( "VF lookup for PF %s failed (%i-%s)", pf_if, errno, fd_io_strerror( errno ) ));
+    }
+    if( FD_UNLIKELY( -1==fd_iavf_init( &vf->vfio, &vf->adminq, &vf->vf_info,
+                                       queues[vf_idx], (uint)tile_cnt, vf_pci, FD_NET_MTU, FD_NET_MTU ) ) ) {
+      FD_LOG_ERR(( "VF %s setup failed (%i-%s)", vf_pci, errno, fd_io_strerror( errno ) ));
+    }
+  }
+
+  /* Fill RX descriptors before enabling reception */
+  for( ulong tile_idx=0UL; tile_idx<tile_cnt; tile_idx++ ) {
+    fd_iavf_tile_init_pkt_bufs( topo, tiles[tile_idx], ctxs[tile_idx] );
+  }
+
+  /* Enable queues and distribute VF state to all tiles */
+  if( NULL!=fds ) fds->member_cnt = owner->vf_cnt;
+  for( ulong vf_idx=0UL; vf_idx<owner->vf_cnt; vf_idx++ ) {
+    fd_iavf_tile_vf_t * vf = &owner->vfs[vf_idx];
+    char const * pf_if = first_tile->iavf.members[vf_idx];
+    if( FD_UNLIKELY( -1==fd_iavf_virtchnl_enable_queues( &vf->vfio, &vf->adminq, &vf->vf_info, queues[vf_idx], (uint)tile_cnt ) ) ) {
+      FD_LOG_ERR(( "VF queue enable for PF %s failed (%i-%s)", pf_if, errno, fd_io_strerror( errno ) ));
+    }
+    fd_iavf_tile_publish_vf_link( owner, vf_idx );
+
+    /* Save VFIO descriptors for child launch */
+    if( NULL!=fds ) {
+      fds->container_fd[ vf_idx ] = vf->vfio.container_fd;
+      fds->group_fd    [ vf_idx ] = vf->vfio.group_fd;
+      fds->device_fd   [ vf_idx ] = vf->vfio.device_fd;
+    }
+
+    /* Each tile remaps BAR0 at launch */
+    if( FD_UNLIKELY( -1==fd_iavf_vfio_unmap_bar( &vf->vfio ) ) ) {
+      FD_LOG_ERR(( "VF BAR unmap for PF %s failed (%i-%s)", pf_if, errno, fd_io_strerror( errno ) ));
+    }
+
+    /* Copy VF resources while retaining each tile's queues */
+    for( ulong tile_idx=0UL; tile_idx<tile_cnt; tile_idx++ ) {
+      fd_iavf_tile_vf_t * tile_vf = &ctxs[tile_idx]->vfs[vf_idx];
+      tile_vf->vfio          = vf->vfio;
+      tile_vf->vf_info       = vf->vf_info;
+      tile_vf->tx_queue.tail = NULL;
+      tile_vf->rx_queue.tail = NULL;
+    }
+  }
+  for( ulong tile_idx=0UL; tile_idx<tile_cnt; tile_idx++ ) ctxs[tile_idx]->prepared = 1U;
+}
+#endif
+
+FD_FN_UNUSED static void
+privileged_init( fd_topo_t const *      topo,
+                 fd_topo_tile_t const * tile ) {
+  /* Prepare VFs if the launcher has not done so */
+  fd_iavf_tile_t * ctx = fd_topo_obj_laddr( topo, tile->tile_obj_id );
+  if( !ctx->prepared ) {
+    fd_topo_install_iavf( (fd_topo_t *)topo, NULL );
+  }
+
+  /* Join this tile's queue and packet memory */
+  fd_iavf_hw_join_queues( ctx, tile );
+  fd_iavf_tile_join_pkt_bufs( topo, tile, ctx, NULL, NULL, NULL );
+
+  /* Use tile 0's VF link decisions */
+  ulong const owner_tile_id = fd_topo_find_tile( topo, "iavf", 0UL );
+  FD_TEST( owner_tile_id!=ULONG_MAX );
+  fd_iavf_tile_t const * owner = fd_topo_obj_laddr( topo, topo->tiles[ owner_tile_id ].tile_obj_id );
+  ctx->vf_link_usable_shared = owner->vf_link_usable;
+
+  /* Queue IDs match IAVF tile indices */
+  for( ulong vf_idx=0UL; vf_idx<ctx->vf_cnt; vf_idx++ ) {
+    fd_iavf_tile_vf_t * vf = &ctx->vfs[vf_idx];
+    char const * pf_if = tile->iavf.members[vf_idx];
+
+    if( FD_UNLIKELY( -1==fd_iavf_hw_map_regs( vf, tile->kind_id ) ) ) {
+      FD_LOG_ERR(( "VF register mapping for PF %s failed (%i-%s)", pf_if, errno, fd_io_strerror( errno ) ));
+    }
+  }
+
+  /* Routing interface and default source IP */
+  uint const interface_idx = if_nametoindex( tile->iavf.if_name );
+  if( FD_UNLIKELY( 0==interface_idx ) ) {
+    FD_LOG_ERR(( "interface %s lookup failed (%i-%s)",
+                 tile->iavf.if_name, errno, fd_io_strerror( errno ) ));
+  }
+  ctx->router.if_virt         = interface_idx;
+  ctx->router.default_address = fd_iavf_tile_if_ip4_addr( tile->iavf.if_name );
+
+  /* Only tile 0 sends loopback traffic */
+  ctx->lo_tx_sock = 0UL==tile->kind_id ? fd_iavf_tile_lo_tx_socket() : -1;
+}
+
+FD_FN_UNUSED static void
+unprivileged_init( fd_topo_t const *      topo,
+                   fd_topo_tile_t const * tile ) {
+  /* Tile state and scratch memory */
+  fd_iavf_tile_t * ctx          = fd_topo_obj_laddr( topo, tile->tile_obj_id );
+  void *           after_queues = fd_iavf_hw_join_queues( ctx, tile );
+  FD_SCRATCH_ALLOC_INIT( scratch, after_queues );
+
+  ctx->batch_size                     = FD_IAVF_BATCH_SIZE;
+  ctx->tx_flush_timeout_ticks         = (long)(FD_IAVF_TX_FLUSH_TIMEOUT_NS*fd_tempo_tick_per_ns( NULL ));
+  ctx->lo_tx_timeout_ticks            = (long)(FD_IAVF_LO_TX_TIMEOUT_NS*fd_tempo_tick_per_ns( NULL ));
+  ctx->vf_housekeeping_interval_ticks = (long)(FD_IAVF_VF_HOUSEKEEPING_INTERVAL_NS*fd_tempo_tick_per_ns( NULL ));
+  ctx->vf_housekeeping_deadline_ticks = fd_tickcount();
+  ctx->lo_tx_cnt                      = 0U;
+  ctx->net.kind_id                    = tile->kind_id;
+  ctx->net.tile_cnt                   = fd_topo_tile_name_cnt( topo, tile->name );
+
+  void * netdev_tbl_local = FD_SCRATCH_ALLOC_APPEND( scratch, fd_netdev_tbl_align(), fd_netdev_tbl_footprint( NETDEV_MAX, BOND_MASTER_MAX )               );
+  void * fib_local_mem    = FD_SCRATCH_ALLOC_APPEND( scratch, fd_fib4_align(),       fd_fib4_footprint( tile->iavf.route_max, tile->iavf.route_peer_max ) );
+  void * fib_main_mem     = FD_SCRATCH_ALLOC_APPEND( scratch, fd_fib4_align(),       fd_fib4_footprint( tile->iavf.route_max, tile->iavf.route_peer_max ) );
+
+  /* Input links and buffer bounds */
+  if( FD_UNLIKELY( tile->in_cnt>FD_NET_IN_MAX ) ) {
+    FD_LOG_ERR(( "iavf tile in link count %lu exceeds max of %lu", tile->in_cnt, FD_NET_IN_MAX ));
+  }
+  for( ulong i=0UL; i<tile->in_cnt; i++ ) {
+    fd_topo_link_t const * link = &topo->links[ tile->in_link_id[ i ] ];
+    if( 0==strcmp( link->name, "iproute_out" ) ) {
+      ctx->net.in_kind[ i ] = FD_NET_IN_KIND_IPROUTE;
+    } else {
+      ctx->net.in_kind[ i ] = FD_NET_IN_KIND_TX;
+      if( FD_UNLIKELY( link->mtu!=FD_NET_MTU ) ) FD_LOG_ERR(( "iavf tile in link %s MTU %lu, expected %lu", link->name, link->mtu, (ulong)FD_NET_MTU ));
+    }
+
+    ctx->net.in_dcache_ctx[ i ].wksp_base = topo->workspaces[ topo->objs[ link->dcache_obj_id ].wksp_id ].wksp;
+    ctx->net.in_dcache_ctx[ i ].chunk0    = fd_dcache_compact_chunk0( ctx->net.in_dcache_ctx[ i ].wksp_base, link->dcache );
+    ctx->net.in_dcache_ctx[ i ].wmark     = fd_dcache_compact_wmark(  ctx->net.in_dcache_ctx[ i ].wksp_base, link->dcache, link->mtu );
+  }
+
+  /* Join fib4 tables */
+  FD_TEST( NULL!=fd_fib4_join( ctx->router.fib_local, fd_fib4_new( fib_local_mem, tile->iavf.route_max, tile->iavf.route_peer_max, tile->iavf.route_peer_seed ) ) );
+  FD_TEST( NULL!=fd_fib4_join( ctx->router.fib_main,  fd_fib4_new( fib_main_mem,  tile->iavf.route_max, tile->iavf.route_peer_max, tile->iavf.route_peer_seed ) ) );
+
+  /* Join shared netdev table */
+  FD_TEST( NULL!=fd_netdev_tbl_join( &ctx->router.netdev_shared, fd_topo_obj_laddr( topo, tile->iavf.netdev_tbl_obj_id ) )                                        );
+
+  /* Create and join local netdev table */
+  FD_TEST( NULL!=fd_netdev_tbl_new( netdev_tbl_local, NETDEV_MAX, BOND_MASTER_MAX )                                                                               );
+  FD_TEST( NULL!=fd_netdev_tbl_join( &ctx->router.netdev_tbl, netdev_tbl_local )                                                                                  );
+
+  /* Copy a consistent interface table for routing */
+  ctx->netdev_seq = fd_netdev_tbl_copy( &ctx->router.netdev_tbl, &ctx->router.netdev_shared );
+  fd_net_gre_tunnels_refresh( &ctx->net, &ctx->router.netdev_tbl );
+  ctx->router.bind_address = tile->iavf.net.bind_address;
+  ctx->net.bind_address    = tile->iavf.net.bind_address;
+
+  /* Join shared neighbor table */
+  ulong neigh4_obj_id = tile->iavf.neigh4_obj_id;
+  ulong ele_max       = fd_pod_queryf_ulong( topo->props, ULONG_MAX, "obj.%lu.ele_max",   neigh4_obj_id );
+  ulong probe_max     = fd_pod_queryf_ulong( topo->props, ULONG_MAX, "obj.%lu.probe_max", neigh4_obj_id );
+  ulong seed          = fd_pod_queryf_ulong( topo->props, ULONG_MAX, "obj.%lu.seed",      neigh4_obj_id );
+  if( FD_UNLIKELY( (ele_max==ULONG_MAX) | (probe_max==ULONG_MAX) | (seed==ULONG_MAX) ) ) {
+    FD_LOG_ERR(( "neigh4 hmap properties not set" ));
+  }
+  if( FD_UNLIKELY( NULL==fd_neigh4_hmap_join( ctx->router.neigh4, fd_topo_obj_laddr( topo, neigh4_obj_id ), ele_max, probe_max, seed ) ) ) {
+    FD_LOG_ERR(( "fd_neigh4_hmap_join failed" ));
+  }
+
+  /* Netlink requests for missing neighbors */
+  ctx->router.netlnk_out_idx = fd_topo_find_tile_out_link( topo, tile, "net_netlnk", tile->kind_id );
+  if( FD_UNLIKELY( ctx->router.netlnk_out_idx==ULONG_MAX ) ) FD_LOG_ERR(( "netlink request link not found" ));
+  ctx->router.solicit_ip = 0U;
+
+  ulong scratch_top = FD_SCRATCH_ALLOC_FINI( scratch, scratch_align() );
+  if( FD_UNLIKELY( scratch_top>(ulong)ctx+scratch_footprint( tile ) ) ) {
+    FD_LOG_ERR(( "scratch overflow" ));
+  }
+}
+
+FD_FN_UNUSED static ulong
+populate_allowed_seccomp( fd_topo_t const *      topo,
+                          fd_topo_tile_t const * tile,
+                          ulong                  out_cnt,
+                          struct sock_filter *   out ) {
+  fd_iavf_tile_t * ctx = fd_topo_obj_laddr( topo, tile->tile_obj_id );
+  populate_sock_filter_policy_fd_iavf_tile( out_cnt, out, (uint)fd_log_private_logfile_fd(), (uint)ctx->lo_tx_sock );
+  return sock_filter_policy_fd_iavf_tile_instr_cnt;
+}
+
+FD_FN_UNUSED static ulong
+populate_allowed_fds( fd_topo_t const *      topo,
+                      fd_topo_tile_t const * tile,
+                      ulong                  out_fds_cnt,
+                      int *                  out_fds ) {
+  fd_iavf_tile_t * ctx = fd_topo_obj_laddr( topo, tile->tile_obj_id );
+  if( FD_UNLIKELY( out_fds_cnt<4UL+3UL*ctx->vf_cnt ) ) FD_LOG_ERR(( "allowed FD array capacity %lu, expected at least %lu", out_fds_cnt, 4UL+3UL*ctx->vf_cnt ));
+  ulong out_cnt = 0UL;
+  out_fds[ out_cnt++ ] = 2;
+  if( fd_log_private_logfile_fd()!=-1 ) out_fds[ out_cnt++ ] = fd_log_private_logfile_fd();
+  for( ulong vf_idx=0UL; vf_idx<ctx->vf_cnt; vf_idx++ ) {
+    fd_iavf_vfio_t const * vfio = &ctx->vfs[vf_idx].vfio;
+    out_fds[ out_cnt++ ] = vfio->container_fd;
+    out_fds[ out_cnt++ ] = vfio->group_fd;
+    out_fds[ out_cnt++ ] = vfio->device_fd;
+  }
+  if( ctx->lo_tx_sock>=0 ) out_fds[ out_cnt++ ] = ctx->lo_tx_sock;
+  return out_cnt;
+}
+
+#define STEM_CALLBACK_CONTEXT_TYPE        fd_iavf_tile_t
+#define STEM_CALLBACK_CONTEXT_ALIGN       alignof(fd_iavf_tile_t)
+#define STEM_CALLBACK_BEFORE_CREDIT       before_credit
+#define STEM_CALLBACK_AFTER_CREDIT        after_credit
+#define STEM_CALLBACK_BEFORE_FRAG         before_frag
+#define STEM_CALLBACK_DURING_FRAG         during_frag
+#define STEM_CALLBACK_AFTER_FRAG          after_frag
+#define STEM_CALLBACK_METRICS_WRITE       metrics_write
+#define STEM_CALLBACK_DURING_HOUSEKEEPING during_housekeeping
+#define STEM_NEVER_PARK                   1
+/* Reserve output credit for one RX batch per VF and one direct loopback
+   delivery in the same stem iteration. */
+#define STEM_BURST (FD_IAVF_MEMBER_MAX*FD_IAVF_BATCH_SIZE+1UL)
+#define STEM_LAZY                         270000UL
+#include "../../stem/fd_stem.c"
+
+#ifndef FD_TILE_TEST
+fd_topo_run_tile_t fd_tile_iavf = {
+  .name                     = "iavf",
+  .populate_allowed_seccomp = populate_allowed_seccomp,
+  .populate_allowed_fds     = populate_allowed_fds,
+  .scratch_align            = scratch_align,
+  .scratch_footprint        = scratch_footprint,
+  .privileged_init          = privileged_init,
+  .unprivileged_init        = unprivileged_init,
+  .run                      = stem_run,
+};
+#endif
diff --git a/src/disco/net/iavf/fd_iavf_tile.seccomppolicy b/src/disco/net/iavf/fd_iavf_tile.seccomppolicy
new file mode 100644
index 0000000..77385dd
--- /dev/null
+++ b/src/disco/net/iavf/fd_iavf_tile.seccomppolicy
@@ -0,0 +1,28 @@
+# logfile_fd: It can be disabled by configuration, but typically tiles
+#             open a log file on boot and write all messages there.
+#
+# lo_tx_fd: Send-only raw IPv4 socket bound to lo, owned by iavf:0.
+uint logfile_fd, uint lo_tx_fd
+
+# logging: all log messages are written to a file and/or pipe
+#
+# 'WARNING' and above are written to the STDERR pipe, while all messages
+# are always written to the log file.
+#
+# arg 0 is the file descriptor to write to.  The boot process ensures
+# that descriptor 2 is always STDERR and descriptor 4 is the logfile.
+write: (or (eq (arg 0) 2)
+           (eq (arg 0) logfile_fd))
+
+# logging: 'WARNING' and above fsync the logfile to disk immediately
+#
+# arg 0 is the file descriptor to fsync.
+fsync: (eq (arg 0) logfile_fd)
+
+# iavf: send loopback packets through the raw IPv4 socket
+#
+# arg 0 is the loopback socket. arg 2 limits the batch to 64 packets
+# and arg 3 requires a nonblocking send.
+sendmmsg: (and (eq (arg 0) lo_tx_fd)
+               (<= (arg 2) 64)
+               (eq (arg 3) MSG_DONTWAIT))
