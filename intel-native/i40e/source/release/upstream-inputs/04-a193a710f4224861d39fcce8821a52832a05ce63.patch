diff --git a/src/app/firedancer/config/default.toml b/src/app/firedancer/config/default.toml
index cab5acdd8a2..65b42d2db50 100644
--- a/src/app/firedancer/config/default.toml
+++ b/src/app/firedancer/config/default.toml
@@ -1251,6 +1251,20 @@ telemetry = true
     #   NICs.  Requires Linux 5.8 or newer and uses a kernel-bypass
     #   packet data path.  Bonding is supported when every bond member
     #   is a port on the same NIC.
+    #
+    #  "iavf"
+    #   Very fast userspace networking for Intel ice and i40e driver
+    #   based NICs. Requires SR-IOV and IOMMU to be enabled in system
+    #   BIOS as well as Virtualization Mode set to SR-IOV within the
+    #   NIC's BIOS section, on some motherboards/NIC OEMs this isn't
+    #   always the default.
+    #
+    #   If "iavf" is selected and your BIOS has some of the BIOS
+    #   options disabled then some relevant help will be given in
+    #   the Firedancer iavf configure stage error message (please
+    #   follow at your own discretion, although SR-IOV has existed
+    #   for a long time there is always some risk with changing
+    #   BIOS settings).
     provider = "auto"
 
     # Which interface to bind to for network traffic.  Currently,
@@ -1459,6 +1473,19 @@ telemetry = true
         rx_queue_size = 32768
         tx_queue_size = 32768
 
+
+    # This section contains Intel i40e/ice specific network
+    # configuration. Only active if [net.provider] is set to "iavf".
+    [net.iavf]
+        # Controls the depths of receive (RX) and transmit (TX) queues.
+        # Queue depth values must be a power of two. The highest allowed
+        # rx/tx_queue_size is 4096 due to Intel queue limits.
+        #
+        # Smaller values use less memory.  Larger values reduce packet
+        # loss caused by excessive scheduling or inter-CPU latency.
+        rx_queue_size = 4096
+        tx_queue_size = 4096
+
 # Tiles are described in detail in the layout section above.  While the
 # layout configuration determines how many of each tile to place on
 # which CPU core to create a functioning system, below is the individual
