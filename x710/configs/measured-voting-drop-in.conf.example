# Measured reference, with non-operational SITE placeholders. Not a drop-in installation.
[Unit]
ConditionPathExists=!/SITE/experiment/hold
ConditionPathExists=!/SITE/experiment/fenced
[Service]
LimitMEMLOCK=96G
MemoryMax=104G
Restart=no
