+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef BNXT_XSK_LIFECYCLE_H
+#define BNXT_XSK_LIFECYCLE_H
+#include <linux/errno.h>
+
+/* Disconnected prototype. Caller MUST hold lifecycle serialization before init/detach and
+ * through unmap. Plain state fields do not protect concurrent calls. The check
+ * callback verifies existing ownership; it does not acquire it. Callbacks need
+ * complete inventory (including both 239 TX rings per NAPI), stopped
+ * producers, live completion handling, and post-drain software ownership.
+ * This coordinator cannot prove those hardware/integration contracts itself.
+ * It can also order rollback after mapping but before publication. Failed
+ * transactions retain local mappings/progress; recovery is external. Linux
+ * pool release does not honor a failing detach return: this is NOT safe to
+ * connect to ndo_bpf without a separate pool/UMEM lifetime recovery contract.
+ */
+#define BNXT_XSK_LC_MAX_RINGS 64U
+#define BNXT_XSK_LC_RX 1U
+#define BNXT_XSK_LC_TX 2U
+#define BNXT_XSK_LC_MAPPED 1U
+#define BNXT_XSK_LC_BUSY 2U
+#define BNXT_XSK_LC_FAILED 3U
+#define BNXT_XSK_LC_UNMAPPED 4U
+struct bnxt_xsk_lc_ring { unsigned int kind, id; };
+struct bnxt_xsk_lc {
+ unsigned int state, count;
+ unsigned long long generation;
+ struct bnxt_xsk_lc_ring ring[BNXT_XSK_LC_MAX_RINGS];
+ unsigned char drained[BNXT_XSK_LC_MAX_RINGS];
+ unsigned char reclaimed[BNXT_XSK_LC_MAX_RINGS];
+ int error;
+};
+struct bnxt_xsk_lc_ops {
+ int (*check)(void *, const struct bnxt_xsk_lc *);
+ int (*fence)(void *);
+ int (*drain)(void *, const struct bnxt_xsk_lc_ring *);
+ int (*synchronize)(void *);
+ int (*reclaim)(void *, const struct bnxt_xsk_lc_ring *);
+ int (*owners_empty)(void *);
+ void (*unmap)(void *);
+};
+static inline int
+bnxt_xsk_lc_init(struct bnxt_xsk_lc *s, unsigned long long generation,
+                 const struct bnxt_xsk_lc_ring *rings, unsigned int count)
+{
+ unsigned int i, j;
+ if (!s || !rings || !count || count > BNXT_XSK_LC_MAX_RINGS)
+  return -EINVAL;
+ /* Caller owns fresh storage; never reinitialize an active transaction. */
+ if (s->state)
+  return -EALREADY;
+ for (i=0; i<count; i++) {
+  if (rings[i].kind != BNXT_XSK_LC_RX && rings[i].kind != BNXT_XSK_LC_TX)
+   return -EINVAL;
+  for (j=0; j<i; j++)
+   if (rings[j].kind==rings[i].kind && rings[j].id==rings[i].id)
+    return -EINVAL;
+ }
+ for (i=0; i<count; i++) {
+  s->ring[i]=rings[i]; s->drained[i]=0; s->reclaimed[i]=0;
+ }
+ s->count=count; s->generation=generation; s->error=0;
+ s->state=BNXT_XSK_LC_MAPPED;
+ return 0;
+}
+static inline int
+bnxt_xsk_lc_detach(struct bnxt_xsk_lc *s,
+                    const struct bnxt_xsk_lc_ops *ops, void *ctx)
+{
+ unsigned int i, kind;
+ int rc;
+ if (!s || !ops || !ops->check || !ops->fence || !ops->drain ||
+     !ops->synchronize || !ops->reclaim || !ops->owners_empty || !ops->unmap)
+  return -EINVAL;
+ if (s->state!=BNXT_XSK_LC_MAPPED)
+  return -EALREADY;
+ s->state=BNXT_XSK_LC_BUSY;
+ rc=ops->check(ctx,s); if (rc) goto fail;
+ rc=ops->fence(ctx); if (rc) goto fail;
+ for (i=0; i<s->count; i++) {
+  rc=ops->check(ctx,s); if (rc) goto fail;
+  rc=ops->drain(ctx,&s->ring[i]); if (rc) goto fail;
+  s->drained[i]=1;
+ }
+ rc=ops->check(ctx,s); if (rc) goto fail;
+ rc=ops->synchronize(ctx); if (rc) goto fail;
+ /* Release TX software references before their potentially RX-backed frames. */
+ for (kind=BNXT_XSK_LC_TX; kind>=BNXT_XSK_LC_RX; kind--)
+  for (i=0; i<s->count; i++) {
+   if (s->ring[i].kind!=kind) continue;
+   rc=ops->check(ctx,s); if (rc) goto fail;
+   rc=ops->reclaim(ctx,&s->ring[i]); if (rc) goto fail;
+   s->reclaimed[i]=1;
+  }
+ rc=ops->check(ctx,s); if (rc) goto fail;
+ rc=ops->owners_empty(ctx); if (rc) goto fail;
+ rc=ops->check(ctx,s); if (rc) goto fail;
+ s->state=BNXT_XSK_LC_UNMAPPED;
+ ops->unmap(ctx);
+ return 0;
+fail:
+ s->error=rc; s->state=BNXT_XSK_LC_FAILED;
+ return rc;
+}
+#endif
