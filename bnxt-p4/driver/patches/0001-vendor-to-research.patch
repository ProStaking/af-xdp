+        parts.append(source[start:source.index('\n}\n',start)+3])
+    common=r'''
+#include <assert.h>
+#include <stdint.h>
+typedef uint16_t u16;
+#define PCI_COMMAND 4
+#define PCI_COMMAND_MASTER 4
+struct pci_dev { int dev,enable_cnt,is_busmaster; u16 command; };
+static int fail_read,fail_write,reads,writes;
+#define dev_WARN_ONCE(...) ((void)0)
+#define atomic_read(p) (*(p))
+#define atomic_dec_return(p) (--*(p))
