+ for (unsigned int i=0;i<s->count;i++) {
+  if (s->ring[i].kind==BNXT_XSK_LC_RX && s->ring[i].id==10) found|=1;
+  else if (s->ring[i].kind==BNXT_XSK_LC_TX && s->ring[i].id==20) found|=2;
