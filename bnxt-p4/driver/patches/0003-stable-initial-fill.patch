+static int bnxt_open_nic(struct bnxt *bp,bool irq,bool link){assert(irq&&!link&&closed);events[count++]=3;opening=true;assert(!test_bit(0,bp->af_xdp_zc_qs)||mapping);if(open_rc){live=false;bp->dev->running=false;}else{live=test_bit(0,bp->af_xdp_zc_qs);set_bit(BNXT_STATE_OPEN,&bp->state);bp->rx_ring=rxrings;bp->tx_ring=txrings;bp->bnapi=(void*)1;rxrings[0]=(struct rx){live?&pool:NULL,posted,live,live && posted==bp->rx_ring_size};txrings[0].xsk_pool=live?&pool:NULL;}if(shrink)bp->rx_nr_rings=bp->txbase=0;opening=false;return open_rc;}
 static void xsk_tx_completed(struct xsk_buff_pool *p,unsigned n){assert(p==&pool);completions+=n;}
