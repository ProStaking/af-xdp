diff --git a/tests/test_initial_fill_race.py b/tests/test_initial_fill_race.py
new file mode 100644
index 0000000..c674ac1
--- /dev/null
+++ b/tests/test_initial_fill_race.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Extract real allocation/enable functions; mock hardware only. No device access."""
+from pathlib import Path
+import ast, subprocess, tempfile
+root=Path(__file__).resolve().parents[1]
+net=(root/'bnxt.c').read_text();xsk=(root/'bnxt_xsk.c').read_text()
+def extract(src,sig):
+ a=src.index(sig);return src[a:src.index('\n}\n',a)+3]
+# Reuse reviewed lifecycle API mocks, but replace the mocked allocation result
+# with the actual bnxt_alloc_one_rx_ring_skb implementation.
+tree=ast.parse((root/'tests/test_normal_lifecycle.py').read_text())
+pre=next(ast.literal_eval(n.value) for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='code' for t in n.targets))
+pre=pre.replace('unsigned fill=8,posted=8;static bool shrink;', 'unsigned fill=1024,posted=511;static bool shrink;')
+pre=pre.replace('static int bnxt_open_nic(', 'static int unused_old_open(')
+a=pre.index('static int unused_old_open(');b=pre.index('\n',a);pre=pre[:a]+pre[b:]
+pre=pre.replace('static void xsk_tx_completed(', 'static void __attribute__((unused)) xsk_tx_completed(')
+pre=pre.replace('static struct xsk_buff_pool *xsk_get_pool_from_qid(', 'static struct xsk_buff_pool *__attribute__((unused)) xsk_get_pool_from_qid(')
+# GCC unused-function exemptions apply only to the reused unused API fixtures.
+pre += r'''
+#define GFP_KERNEL 0
+#define NEXT_RX(n) ((u16)((n)+1))
+static void mock_warn(void *dev,const char *fmt,...){(void)dev;(void)fmt;}
+#define netdev_warn mock_warn
+static unsigned allocations, fail_after=511, advance;
+static int bnxt_alloc_rx_data(struct bnxt *bp,struct rx *r,unsigned p,int flags){
+ (void)bp;(void)r;(void)p;(void)flags;
+ if(allocations==fail_after)return -ENOMEM;
+ allocations++;return 0;
+}
+'''
+allocation=extract(net,'static void bnxt_alloc_one_rx_ring_skb(').replace('struct bnxt_rx_ring_info','struct rx')
+pre+=allocation
+pre+=r'''
+static int bnxt_open_nic(struct bnxt *bp,bool irq,bool link){
+ assert(irq&&!link&&closed);events[count++]=3;opening=true;
+ if(open_rc){live=false;bp->dev->running=false;opening=false;return open_rc;}
+ live=test_bit(0,bp->af_xdp_zc_qs);set_bit(BNXT_STATE_OPEN,&bp->state);
+ bp->rx_ring=rxrings;bp->tx_ring=txrings;bp->bnapi=(void*)1;
+ rxrings[0]=(struct rx){.xsk_pool=live?&pool:NULL,.rx_prod=0,.zc=live};
+ txrings[0].xsk_pool=live?&pool:NULL;
+ allocations=0;bnxt_alloc_one_rx_ring_skb(bp,&rxrings[0],0);
+ /* Models packets after open enabled NAPI, before caller validates. */
+ rxrings[0].rx_prod=(u16)(rxrings[0].rx_prod+advance);
+ opening=false;return 0;
+}
+'''
+main=r'''
+static void reset(struct bnxt *bp,struct netdev *dev,unsigned long *bits){
+ static struct pci pci;*bits=0;*dev=(struct netdev){true};
+ *bp=(struct bnxt){.dev=dev,.pdev=&pci,.xdp_prog=(void*)1,.rx_ring=(void*)1,.tx_ring=(void*)1,.bnapi=(void*)1,.state=1,.af_xdp_zc_qs=bits,.flags=1,.txbase=2,.rx_ring_size=511,.rx_nr_rings=2};
+ count=maps=unmaps=0;validate_rc=bounds_rc=map_rc=open_rc=0;
+ mapping=live=closed=opening=false;fill=1024;fail_after=511;advance=0;
+}
+int main(void){
+ struct bnxt bp;struct netdev dev;unsigned long bits;
+ /* Actual observed 525-vs-511 and counter wrap, not a >= approximation. */
+ unsigned advances[]={0,14,65025,65535};
+ for(unsigned j=0;j<4;j++){
+  reset(&bp,&dev,&bits);advance=advances[j];
+  int rc=bnxt_xdp_enable_pool(&bp,&pool,0);
+  if(OLD_PREDICATE && advance){assert(rc==-ENOBUFS&&!mapping&&!live&&!bits&&unmaps==1);}
+  else{assert(rc==0&&mapping&&live&&bits==1&&rxrings[0].xsk_rx_initial_fill_done);}
+ }
+ /* Every genuine short initial allocation still rejects; no false success. */
+ for(unsigned n=0;n<511;n++){
+  reset(&bp,&dev,&bits);fail_after=n;
+  assert(bnxt_xdp_enable_pool(&bp,&pool,0)==-ENOBUFS);
+  assert(!mapping&&!bits&&!live&&!dev.running&&unmaps==1);
+ }
+ reset(&bp,&dev,&bits);fill=510;assert(bnxt_xdp_enable_pool(&bp,&pool,0)==-ENOBUFS&&!maps);
+ reset(&bp,&dev,&bits);open_rc=-ENOMEM;assert(bnxt_xdp_enable_pool(&bp,&pool,0)==-ENOMEM&&!mapping&&!bits&&unmaps==1);
+ /* Real allocator clears a prior success before any new allocation. */
+ reset(&bp,&dev,&bits);struct rx r={.xsk_pool=&pool,.zc=true};
+ allocations=0;bnxt_alloc_one_rx_ring_skb(&bp,&r,0);assert(r.xsk_rx_initial_fill_done);
+ for(unsigned n=0;n<=3;n+=3){
+  allocations=0;fail_after=511;r.rx_prod=0;bnxt_alloc_one_rx_ring_skb(&bp,&r,0);assert(r.xsk_rx_initial_fill_done);
+  allocations=0;fail_after=n;r.rx_prod=0;bnxt_alloc_one_rx_ring_skb(&bp,&r,0);assert(!r.xsk_rx_initial_fill_done&&r.rx_prod==n);
+ }
+ /* A short fill cannot become success by advancing to the old expected value. */
+ if(!OLD_PREDICATE){reset(&bp,&dev,&bits);fail_after=497;advance=14;assert(bnxt_xdp_enable_pool(&bp,&pool,0)==-ENOBUFS&&!mapping&&!bits);}
+ /* Non-XSK and non-ZC rings never publish an XSK fill result. */
+ fail_after=511;allocations=0;r=(struct rx){.zc=true,.xsk_rx_initial_fill_done=true};bnxt_alloc_one_rx_ring_skb(&bp,&r,0);assert(!r.xsk_rx_initial_fill_done);
+ allocations=0;r=(struct rx){.xsk_pool=&pool,.xsk_rx_initial_fill_done=true};bnxt_alloc_one_rx_ring_skb(&bp,&r,0);assert(!r.xsk_rx_initial_fill_done);
+ return 0;
+}
+'''
+# Verify source ordering: allocator runs before chip/NAPI/interrupt publication.
+init=extract(net,'static int bnxt_init_nic(')
+assert init.index('bnxt_init_rx_rings')<init.index('bnxt_init_chip')
+a=net.index('rc = bnxt_init_nic(bp, irq_re_init);');b=net.index('bnxt_enable_int(bp);',a)
+assert 'bnxt_enable_napi(bp);' in net[a:b]
+assert 'return bnxt_alloc_one_rx_ring(bp, ring_nr);' in extract(net,'static int bnxt_init_one_rx_ring(')
+assert 'bnxt_alloc_one_rx_ring_skb(bp, rxr, ring_nr);' in extract(net,'static int bnxt_alloc_one_rx_ring(')
+func=extract(xsk,'static int bnxt_xdp_enable_pool(')
+assert '!bp->rx_ring[queue_id].xsk_rx_initial_fill_done' in func
+with tempfile.TemporaryDirectory() as d:
+ d=Path(d)
+ for old in [1,0]:
+  body=func.replace('!bp->rx_ring[queue_id].xsk_rx_initial_fill_done','bp->rx_ring[queue_id].rx_prod != bp->rx_ring_size') if old else func
+  for sanitize in [False,True]:
+   p=d/'test.c';p.write_text('#define OLD_PREDICATE '+str(old)+'\n'+pre+body+main)
+   exe=d/'test';args=['gcc','-std=gnu11','-Wall','-Wextra','-Werror','-Wno-unused-function','-Wno-unused-variable','-Wno-sign-compare','-g','-O1',str(p),'-o',str(exe)]
+   if sanitize:args+=['-fsanitize=address,undefined','-fno-omit-frame-pointer','-no-pie']
+   subprocess.run(args,check=True);subprocess.run([str(exe)],check=True)
+   print('PASS', 'old-reproduction' if old else 'fixed-invariant', 'ASan+UBSan' if sanitize else 'normal',flush=True)
