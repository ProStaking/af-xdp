+use driver-restored nTUPLE steering: RFS on, TruFlow not in use, in every
+build. The backstop re-checks every configured zero-copy queue after reopen.
+"""
+from pathlib import Path
+import os, re, subprocess, sys, tempfile
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import csrc
