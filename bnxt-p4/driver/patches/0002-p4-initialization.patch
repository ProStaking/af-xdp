+static int bnxt_change_msix(struct bnxt *b, int n) { (void)b; return n; }
+static int __bnxt_reserve_rings(struct bnxt *b) { (void)b; return inner_rc; }
+static void netdev_reset_tc(struct net_device *d) { (void)d; }
+'''
