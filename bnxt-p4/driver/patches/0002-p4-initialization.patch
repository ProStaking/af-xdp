+# SPDX-License-Identifier: GPL-2.0-only
+"""Whole-function extraction from driver C sources for actual-source tests.
+
+Unlike the older per-test ``s.index(sig)`` helpers, this matches braces while
+skipping comments, strings and character literals, and it fails unless exactly
+one definition of the requested function exists.
+"""
+import re
+
+
+def _skip_literal(src, i):
+    quote = src[i]
+    i += 1
+    while src[i] != quote:
+        i += 2 if src[i] == '\\' else 1
+    return i + 1
+
+
+def _definitions(src, name):
+    found = []
+    for m in re.finditer(r'^[A-Za-z_][^\n;#=]*\b' + re.escape(name) + r'\(', src, re.M):
+        i, depth = m.end(), 1
+        while depth:
+            depth += {'(': 1, ')': -1}.get(src[i], 0)
+            i += 1
+        while src[i] in ' \t\n':
+            i += 1
+        if src[i] == '{':
+            found.append((m.start(), i))
+    return found
+
+
+def _directive(src, i):
+    """Preprocessor directive name if a line starts at ``i``, else None."""
+    if i and src[i - 1] != '\n':
+        return None
+    j = i
+    while src[j] in ' \t':
+        j += 1
+    if src[j] != '#':
+        return None
+    rest = src[j + 1:src.index('\n', j)].strip()
+    return rest.split(None, 1)[0] if rest else ''
+
+
+def _next_line(src, i):
+    while True:
+        end = src.index('\n', i)
+        if src[end - 1] != '\\':
+            return end + 1
+        i = end + 1
+
+
+def _skip_branch(src, i):
+    """From an #else/#elif line, return the start of the matching #endif line."""
+    nest, i = 0, _next_line(src, i)
+    while True:
+        d = _directive(src, i)
+        if d in ('if', 'ifdef', 'ifndef'):
+            nest += 1
+        elif d == 'endif':
+            if not nest:
+                return i
+            nest -= 1
+        i = _next_line(src, i)
+
+
+def function(src, name, occurrence=None):
+    """Return the complete definition of ``name`` (signature through '}').
+
+    ``occurrence`` selects one of several definitions in alternative
+    preprocessor branches (e.g. 0 for the one before an ``#else`` stub).
+    Braces are counted in the first branch of each conditional only, since
+    vendor code repeats an opening brace across #if/#else alternatives; all
+    branches are still returned verbatim.
+    """
+    defs = _definitions(src, name)
+    if occurrence is None and len(defs) != 1:
+        raise SystemExit(f'{name}: expected exactly one definition, found {len(defs)}')
+    start, i = defs[occurrence or 0]
+    depth = 0
+    while True:
+        if i >= len(src):
+            raise SystemExit(f'{name}: unbalanced braces')
+        d = _directive(src, i)
+        if d is not None:
+            i = _skip_branch(src, i) if d in ('else', 'elif') else _next_line(src, i)
+            continue
+        if src.startswith('/*', i):
+            i = src.index('*/', i) + 2
+            continue
+        if src.startswith('//', i):
+            i = src.index('\n', i)
+            continue
+        c = src[i]
+        if c in '"\'':
+            i = _skip_literal(src, i)
+            continue
+        if c == '{':
+            depth += 1
+        elif c == '}':
+            depth -= 1
+            if depth == 0:
+                return src[start:i + 1] + '\n'
+        i += 1
+
+
+def has_function(src, name):
+    return len(_definitions(src, name)) >= 1
+
+
+def returns_void(src, name):
+    return function(src, name).split(name, 1)[0].split()[-1] == 'void'
