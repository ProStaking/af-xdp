+
+model = r'''
+/* ---- UMEM and frame-ownership ledger ---------------------------------- */
+#define NFRAMES 48
+#define CHUNK 2048
+#define DMA_BASE 0x100000ULL
+enum { F_FREE, F_POSTED, F_HELD, F_PEER, F_UTX, F_TXRAW, F_DONE };
+static u8 umem[NFRAMES * CHUNK];
+static struct xdp_buff xbuf[NFRAMES];
+static int owner[NFRAMES];
+static u32 canary[NFRAMES];
+static struct xsk_buff_pool pool = { CHUNK, XDP_PACKET_HEADROOM };
+static int fill_left;		/* frames the FILL ring can still supply */
+static bool alloc_fail, redirect_fail, force_full;
+static int utx[NFRAMES], utx_head, utx_tail;	/* user TX ring */
+static int inflight[NFRAMES], if_head, if_tail;	/* raw TX awaiting completion, FIFO */
+static int peer_rx, peer_echo, peer_raw, completions, redirects;
+static dma_addr_t frame_dma(int f) { return DMA_BASE + (dma_addr_t)f * CHUNK; }
+static int dma_frame(dma_addr_t a) { assert(a >= DMA_BASE); int f = (a - DMA_BASE) / CHUNK; assert(f < NFRAMES); return f; }
+static u32 rd32(int f, dma_addr_t a) { u32 v; memcpy(&v, &umem[f * CHUNK + (a - frame_dma(f))], 4); return v; }
+static void ledger_reset(void)
+{
+	for (int f = 0; f < NFRAMES; f++) {
+		xbuf[f] = (struct xdp_buff){ .data_hard_start = &umem[f * CHUNK], .frame = f };
+		owner[f] = F_FREE;
+	}
+	utx_head = utx_tail = if_head = if_tail = 0;
+	peer_rx = peer_echo = peer_raw = completions = redirects = 0;
+}
+static struct xdp_buff *xsk_buff_alloc(struct xsk_buff_pool *p)
+{
+	assert(p == &pool);
+	if (alloc_fail || !fill_left) return NULL;
+	for (int f = 0; f < NFRAMES; f++)
+		if (owner[f] == F_FREE) {
+			fill_left--; owner[f] = F_HELD;
+			xbuf[f].data = xbuf[f].data_hard_start + XDP_PACKET_HEADROOM;
+			return &xbuf[f];
+		}
+	return NULL;
+}
+static dma_addr_t xsk_buff_xdp_get_dma(struct xdp_buff *x) { return frame_dma(x->frame) + XDP_PACKET_HEADROOM; }
+static void xsk_buff_free(struct xdp_buff *x)
+{
+	int f = x->frame; assert(owner[f] == F_HELD || owner[f] == F_POSTED);
+	owner[f] = F_FREE; fill_left++;	/* back to the FILL ring */
+}
+static void xsk_buff_dma_sync_for_cpu(struct xdp_buff *x) { assert(owner[x->frame] == F_HELD); }
+static u32 xsk_pool_get_chunk_size(struct xsk_buff_pool *p) { return p->chunk_size; }
+static u32 xsk_pool_get_headroom(struct xsk_buff_pool *p) { return p->headroom; }
+static int xdp_do_redirect(struct net_device *d, struct xdp_buff *x, struct bpf_prog *p)
+{
+	(void)d; (void)p; if (redirect_fail) return -EINVAL;
+	assert(owner[x->frame] == F_HELD); owner[x->frame] = F_PEER; redirects++; return 0;
+}
+static bool xsk_tx_peek_desc(struct xsk_buff_pool *p, struct xdp_desc *d)
+{
+	assert(p == &pool);
+	if (utx_head == utx_tail) return false;
+	int f = utx[utx_head++ % NFRAMES]; assert(owner[f] == F_UTX);
+	owner[f] = F_TXRAW; inflight[if_tail++ % NFRAMES] = f;
+	*d = (struct xdp_desc){ .addr = (u64)f * CHUNK + XDP_PACKET_HEADROOM, .len = 64 };
+	return true;
+}
+static dma_addr_t xsk_buff_raw_get_dma(struct xsk_buff_pool *p, u64 addr) { (void)p; return DMA_BASE + addr; }
+static void xsk_buff_raw_dma_sync_for_device(struct xsk_buff_pool *p, dma_addr_t a, u32 l) { (void)p; (void)a; (void)l; }
+static void xsk_tx_release(struct xsk_buff_pool *p) { (void)p; }
+static void xsk_tx_completed(struct xsk_buff_pool *p, u32 n)
+{
+	assert(p == &pool && (u32)(if_tail - if_head) >= n);
+	while (n--) { int f = inflight[if_head++ % NFRAMES]; assert(owner[f] == F_TXRAW); owner[f] = F_DONE; completions++; }
+}
+static bool xsk_uses_need_wakeup(struct xsk_buff_pool *p) { (void)p; return false; }
+static void xsk_set_tx_need_wakeup(struct xsk_buff_pool *p) { (void)p; }
+static void dma_sync_single_for_device(struct device *d, dma_addr_t a, u32 l, int dir)
+{ (void)d; (void)dir; int f = dma_frame(a); assert(owner[f] == F_HELD && l); }
+static unsigned bpf_action[1024], pkt;
+static u32 bpf_prog_run_xdp(struct bpf_prog *p, struct xdp_buff *x) { (void)p; (void)x; return bpf_action[pkt]; }
+static struct netdev_queue txq;
+static struct netdev_queue *netdev_get_tx_queue(struct net_device *d, int i) { (void)d; assert(i == 0); return &txq; }
+static void __netif_tx_lock(struct netdev_queue *q, int cpu) { (void)cpu; assert(!q->locked); q->locked = 1; }
+static void __netif_tx_unlock(struct netdev_queue *q) { assert(q->locked); q->locked = 0; }
+/* Paths that must not be reached for a zero-copy ring. */
+static void dma_unmap_single(struct device *d, dma_addr_t a, u32 l, int dir) { (void)d; (void)a; (void)l; (void)dir; assert(!"redirect TX unmap"); }
+static void xdp_return_frame(struct xdp_frame *f) { (void)f; assert(!"redirect TX frame"); }
