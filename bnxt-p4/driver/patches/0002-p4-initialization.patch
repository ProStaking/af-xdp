+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""P4 zero-copy gate: rejected in default builds, accepted only when the
+isolated-qualification build is requested with make p4_xsk_experimental=1."""
+from pathlib import Path
+import os, re, subprocess, tempfile
+
+root = Path(__file__).resolve().parents[1]
+hdr = (root / 'bnxt_xsk.h').read_text()
+bnxt_h = (root / 'bnxt.h').read_text()
+mk = (root / 'Makefile').read_text()
+net = (root / 'bnxt.c').read_text()
+xsk = (root / 'bnxt_xsk.c').read_text()
+
+a = hdr.index('#ifdef BNXT_P4_XSK_EXPERIMENTAL')
+gate = hdr[a:hdr.index('#endif', a) + 6]
+a = bnxt_h.index('#ifdef BNXT_P4_XSK_EXPERIMENTAL')
+version = bnxt_h[a:bnxt_h.index('#endif', a) + 6]
+
+# Every consumer of the define is known; nothing else can widen the gate.
+users = {p.name: len(re.findall(r'BNXT_P4_XSK_EXPERIMENTAL', p.read_text(errors='ignore')))
+         for p in root.iterdir() if p.suffix in ('.c', '.h') or p.name == 'Makefile'}
+assert {k: v for k, v in users.items() if v} == {'bnxt_xsk.h': 1, 'bnxt.h': 1, 'bnxt.c': 1, 'Makefile': 1}, users
+for site in ('\tif (BNXT_XSK_ZC_CHIP(bp)) {\n\t\trc = bnxt_xsk_bitmap_init(bp);',
+             '\tif (BNXT_XSK_ZC_CHIP(bp))\n\t\tdev->xdp_features |= NETDEV_XDP_ACT_XSK_ZEROCOPY;',
+             '\t\tif (BNXT_XSK_ZC_CHIP(bp) && bp->af_xdp_zc_qs &&\n\t\t    test_bit(i, bp->af_xdp_zc_qs) && bp->xdp_prog) {'):
+    assert net.count(site) == 1, site
+assert xsk.count('if (!BNXT_XSK_ZC_CHIP(bp) || !bp->af_xdp_zc_qs)') == 1
+a = net.index('#ifdef BNXT_P4_XSK_EXPERIMENTAL')
+warn = ('\t\tif (BNXT_CHIP_P4(bp))\n\t\t\tnetdev_warn(bp->dev, "EXPERIMENTAL P4 AF_XDP zero-copy '
+        'build: isolated qualification hosts only\\n");\n')
+assert net[a:net.index('#endif', a)].count(warn) == 1
+# R8: nothing in the Makefile may assign the switch (it must come from the command line).
+assert not re.search(r'^\s*(override\s+)?p4_xsk_experimental\s*(::|:|\?|\+|!)?=', mk, re.M)
+assert 'NETDEV_XDP_ACT_XSK_ZEROCOPY' not in net.replace(
+    '\tif (BNXT_XSK_ZC_CHIP(bp))\n\t\tdev->xdp_features |= NETDEV_XDP_ACT_XSK_ZEROCOPY;', '')
+
+for experimental in (False, True):
+    for extra in ('"-239.1.170.0"', '"-239.1.170.0-g0123456789abcdef-dirty-local"'):
+        code = ('#define BNXT_P4_XSK_EXPERIMENTAL 1\n' if experimental else '') + r"""
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+struct bnxt { int gen; };
+#define BNXT_CHIP_P4(bp) ((bp)->gen == 4)
+#define BNXT_CHIP_P5_PLUS(bp) ((bp)->gen >= 5)
+#define DRV_MODULE_EXTRA_VER """ + extra + '\n' + gate + '\n' + version + r"""
+int main(void)
+{
+	struct bnxt p4 = { 4 }, p5 = { 5 }, p7 = { 7 }, p3 = { 3 };
+	assert(BNXT_XSK_ZC_CHIP(&p5) && BNXT_XSK_ZC_CHIP(&p7) && !BNXT_XSK_ZC_CHIP(&p3));
+	assert((BNXT_XSK_ZC_CHIP(&p4) ? 1 : 0) == EXPECT_P4);
+	char shown[32];	/* ethtool_drvinfo.version is 32 bytes; bnxt copies with truncation */
+	snprintf(shown, sizeof(shown), "%s", DRV_MODULE_VERSION);
+	assert((strstr(shown, "p4xsk") ? 1 : 0) == EXPECT_P4);
+	return 0;
+}
+"""
+        code = f'#define EXPECT_P4 {int(experimental)}\n' + code
+        with tempfile.TemporaryDirectory() as d:
+            p = Path(d)
+            (p / 'gate.c').write_text(code)
+            subprocess.run(['gcc', '-std=gnu17', '-Wall', '-Wextra', '-Werror', '-Wno-format-truncation',
+                            '-fsanitize=address,undefined', '-fno-sanitize-recover=all',
+                            str(p / 'gate.c'), '-o', str(p / 'gate')], check=True)
+            subprocess.run([str(p / 'gate')], check=True)
+    if not experimental:
+        # Default expansion is token-identical to the original P5+ guard.
+        out = subprocess.run(['gcc', '-E', '-P', '-x', 'c', '-'], input=gate + '\nGATE: BNXT_XSK_ZC_CHIP(bp)\n',
+                             capture_output=True, text=True, check=True).stdout
+        assert 'GATE: BNXT_CHIP_P5_PLUS(bp)' in out, out
+
+# Actual Make conditional: only an explicit command-line request enables it;
+# the same value inherited from the environment is a hard error.
+start = mk.index('ifeq ($(p4_xsk_experimental),1)')
+probe = mk[start:mk.index('\nendif', start) + 6]
+cases = ((None, None, False), ('p4_xsk_experimental=0', None, False),
+         ('p4_xsk_experimental=1', None, True), (None, '1', 'error'))
+for arg, env, expect in cases:
+    with tempfile.TemporaryDirectory() as d:
+        p = Path(d)
+        (p / 'probe.mk').write_text(probe + '\n$(info FLAGS=$(DISTRO_CFLAG))\nall:;@true\n')
+        cmd = ['make', '-s', '-f', str(p / 'probe.mk')] + ([arg] if arg else [])
+        environ = dict(os.environ)
+        environ.pop('p4_xsk_experimental', None)
+        if env is not None:
+            environ['p4_xsk_experimental'] = env
+        r = subprocess.run(cmd, capture_output=True, text=True, env=environ)
+        if expect == 'error':
+            assert r.returncode != 0 and 'command line' in r.stderr, (r.returncode, r.stdout, r.stderr)
+        else:
+            assert r.returncode == 0, r.stderr
+            assert ('-DBNXT_P4_XSK_EXPERIMENTAL' in r.stdout) == expect, (arg, r.stdout)
+print('PASS P4 zero-copy gate: default expansion equals P5+ guard at all four sites; P4 only with '
+      'make p4_xsk_experimental=1 on the command line (environment rejected); version tag visible in ethtool -i')
