+build(baseline, strict=False)
+print('PASS baseline research-driver: P4 per-ring reset, P5 full reset, firmware fallback')
+build(root / 'bnxt.c', strict=True)
+print('PASS actual RX ring reset: zero-copy rings take the full reset (scheduled or escalated); native rings unchanged')
