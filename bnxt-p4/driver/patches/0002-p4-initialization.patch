+"""Actual RX ring-error reset scheduling and per-ring reset.
+
+P4 resets one RX ring in the service task: it frees and re-posts that ring's
+buffers while NAPI is live and without reclaiming RX-backed XDP_TX frames still
+on the TX ring. That is acceptable for page-pool rings (vendor behavior) but not
+for AF_XDP zero-copy rings, which must take the full close/open reset as P5
+always does. Native cases also run against research-driver. Mocked firmware.
+"""
+from pathlib import Path
+import os, subprocess, sys, tempfile
