+ * Publish ownership only after memory-model registration succeeds. P4 calls
+ * are currently confined to actual-source fixtures, not live allocation.
+ */
+static int bnxt_xsk_rx_pool_init(struct bnxt *bp,
+				 struct bnxt_rx_ring_info *rxr, u16 queue_id)
+{
+	struct xsk_buff_pool *pool;
+	int rc;
 
+	if (!BNXT_CHIP_P4(bp) && !BNXT_CHIP_P5_PLUS(bp))
+		return -EOPNOTSUPP;
+	if (queue_id >= bp->rx_nr_rings || queue_id >= BNXT_MAX_XSK_RINGS ||
+	    !bp->af_xdp_zc_qs || !test_bit(queue_id, bp->af_xdp_zc_qs) ||
+	    !bp->xdp_prog)
+		return -EINVAL;
+	if (rxr->xsk_pool || (rxr->flags & BNXT_RING_FLAG_AF_XDP_ZC))
+		return -EBUSY;
+	pool = xsk_get_pool_from_qid(bp->dev, queue_id);
+	if (!pool)
+		return -EINVAL;
+	rc = bnxt_xsk_validate_pool(bp, pool, bp->rx_buf_use_size);
+	if (rc)
+		return rc;
+	rc = xdp_rxq_info_reg_mem_model(&rxr->xdp_rxq,
+				       MEM_TYPE_XSK_BUFF_POOL, NULL);
+	if (rc)
+		return rc;
+	xsk_pool_set_rxq_info(pool, &rxr->xdp_rxq);
+	rxr->xsk_pool = pool;
+	rxr->flags |= BNXT_RING_FLAG_AF_XDP_ZC;
 	return 0;
 }
