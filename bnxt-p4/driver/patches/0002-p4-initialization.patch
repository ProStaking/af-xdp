+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Actual full __close, packet-drain dispatcher and open wrapper; no hardware.
+__open, firmware/IRQ/NAPI APIs and individual packet drains are mocked.
+This tests ordering, not a firmware acknowledgement or DMA-stop guarantee.
+"""
+from pathlib import Path
+import os, subprocess, sys, tempfile
+sys.path.insert(0,str(Path(__file__).resolve().parent))
+import csrc
+root=Path(__file__).resolve().parents[1]
+s=(root/'bnxt.c').read_text()
+# Brace-matched: a forward declaration now precedes __bnxt_open_nic.
+def extract(sig):
+ return csrc.function(s,sig.rstrip('(').split()[-1])
+pre=r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <string.h>
+#define BNXT_STATE_OPEN 0
+#define BNXT_STATE_ABORT_ERR 1
+#define BNXT_STATE_IN_FW_RESET 2
+#define BNXT_STATE_NAPI_DISABLED 9
+#define BNXT_PF(b) 0
+#define BNXT_SUPPORTS_MULTI_RSS_CTX(b) 0
+#define netif_info(b,l,d,f,i,k) ((void)(i),(void)(k))
+#define netdev_err(...) ((void)0)
+struct device {bool running;};
+struct bnxt {unsigned long state;struct device *dev;int timer;};
+enum {TX_STOP=1,BARRIER,SYNC,LOCK,SHUTDOWN,UNLOCK,NAPI_STOP,TIMER,TX_DRAIN,RX_DRAIN,MPC_DRAIN,IRQ_FREE,NAPI_DELETE,MEM_FREE,NQ_ENABLE,OPEN_CALL,NETIF_CLOSE};
+static int events[64],used,open_rc,open_calls,sleeps,busy;
+static bool stopped,drained,locked;
+static void event(int n){assert(used<64);events[used++]=n;}
+static bool test_bit(unsigned n,unsigned long*p){return !!(*p&(1ul<<n));}
+static void clear_bit(unsigned n,unsigned long*p){*p&=~(1ul<<n);}
+static void bnxt_custom_tf_port_deinit(struct bnxt*b){(void)b;}
+static bool bnxt_tc_is_switchdev_mode(struct bnxt*b){(void)b;return false;}
+static void bnxt_vf_reps_close(struct bnxt*b){(void)b;assert(0);}
+static void bnxt_udcc_session_db_cleanup(struct bnxt*b){(void)b;assert(0);}
+static void bnxt_delete_debug_dim(struct bnxt*b){(void)b;}
+static void bnxt_tx_disable(struct bnxt*b){assert(test_bit(0,&b->state));event(TX_STOP);}
+static void smp_mb__after_atomic(void){event(BARRIER);}
+static void synchronize_net(void){event(SYNC);}
+static bool bnxt_drv_busy(struct bnxt*b){assert(!test_bit(0,&b->state));if(busy){busy--;return true;}return false;}
+static void msleep(int n){assert(n==20);sleeps++;}
+static void bnxt_en_dev_lock(struct bnxt*b){(void)b;assert(!locked);locked=true;event(LOCK);}
+static void bnxt_clear_rss_ctxs(struct bnxt*b){(void)b;assert(0);}
+static void bnxt_shutdown_nic(struct bnxt*b,bool irq){(void)irq;assert(locked&&!test_bit(0,&b->state));stopped=true;event(SHUTDOWN);}
+static void bnxt_en_dev_unlock(struct bnxt*b){(void)b;assert(locked);locked=false;event(UNLOCK);}
+static void bnxt_disable_napi(struct bnxt*b,bool all){(void)b;assert(stopped&&all);event(NAPI_STOP);}
+static void timer_delete_sync(int*t){(void)t;assert(events[used-1]==NAPI_STOP);event(TIMER);}
+static void bnxt_free_tx_skbs(struct bnxt*b){(void)b;assert(stopped&&events[used-1]==TIMER);event(TX_DRAIN);}
+static void bnxt_free_rx_skbs(struct bnxt*b){(void)b;assert(events[used-1]==TX_DRAIN);event(RX_DRAIN);}
+static void bnxt_free_mpc_entries(struct bnxt*b){(void)b;assert(events[used-1]==RX_DRAIN);drained=true;event(MPC_DRAIN);}
+static void bnxt_free_irq(struct bnxt*b){(void)b;assert(drained);event(IRQ_FREE);}
+static void bnxt_del_napi(struct bnxt*b){(void)b;assert(events[used-1]==IRQ_FREE);event(NAPI_DELETE);}
+static void bnxt_free_mem(struct bnxt*b,bool irq){(void)b;assert(drained&&events[used-1]==(irq?NAPI_DELETE:MPC_DRAIN));event(MEM_FREE);}
+static void bnxt_enable_nq0_napi(struct bnxt*b){(void)b;assert(events[used-1]==MEM_FREE);event(NQ_ENABLE);}
+static int __bnxt_open_nic(struct bnxt*b,bool irq,bool link){(void)irq;(void)link;open_calls++;event(OPEN_CALL);if(!open_rc){b->state|=1ul;b->dev->running=true;}return open_rc;}
+/* Model only netif_close's externally visible down transition, not ndo_stop. */
+static void netif_close(struct device*d){d->running=false;event(NETIF_CLOSE);}
+'''
+main=r'''
+int main(void){
+ struct device dev={true};struct bnxt b={.state=1,.dev=&dev};
+ for(int irq=0;irq<2;irq++)for(int repeat=0;repeat<2;repeat++){
+  used=0;stopped=drained=locked=false;busy=1;sleeps=0;
+  __bnxt_close_nic(&b,irq,false);
+  int expected[]={TX_STOP,BARRIER,SYNC,LOCK,SHUTDOWN,UNLOCK,NAPI_STOP,TIMER,TX_DRAIN,RX_DRAIN,MPC_DRAIN,IRQ_FREE,NAPI_DELETE,MEM_FREE,NQ_ENABLE};
+  int j=0;for(unsigned i=0;i<sizeof(expected)/sizeof(*expected);i++){
+   if(!irq&&(expected[i]==IRQ_FREE||expected[i]==NAPI_DELETE))continue;
+   assert(events[j++]==expected[i]);
+  }
+  assert(used==j&&!test_bit(0,&b.state)&&sleeps==1&&!locked);
+  open_rc=0;assert(!bnxt_open_nic(&b,irq,false)&&test_bit(0,&b.state)&&dev.running);
+ }
+ b.state=0;dev.running=true;used=0;open_rc=-ENOMEM;
+ assert(bnxt_open_nic(&b,true,false)==-ENOMEM&&!dev.running&&!test_bit(0,&b.state));
+ assert(used==2&&events[0]==OPEN_CALL&&events[1]==NETIF_CLOSE);
+ int before=open_calls;b.state=1ul<<BNXT_STATE_ABORT_ERR;dev.running=true;used=0;
+ assert(bnxt_open_nic(&b,true,false)==-EIO&&!dev.running&&open_calls==before);
+ assert(used==1&&events[0]==NETIF_CLOSE);
+ return 0;
+}
+'''
+code=pre+extract('static void bnxt_free_skbs(')+extract('static void __bnxt_close_nic(')+extract('int bnxt_open_nic(')+main
+with tempfile.TemporaryDirectory() as d:
+ p=Path(d);(p/'test.c').write_text(code)
+ subprocess.run(['gcc','-std=c17','-Wall','-Wextra','-Werror','-fsanitize='+os.environ.get('SANITIZERS','address,undefined'),'-fno-sanitize-recover=all',str(p/'test.c'),'-o',str(p/'test')],check=True)
+ subprocess.run([str(p/'test')],check=True)
