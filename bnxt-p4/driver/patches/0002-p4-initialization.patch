+static struct bnxt bp; static unsigned long zc;
+static void setup(bool zc_on, int rc)
+{
+	bp = (struct bnxt){ .irq_tbl = &irq_obj, .bnapi = &bnapi_obj, .total_irqs = 4, .new_rm = true,
+			    .tx_nr_rings_per_tc = 4, .tx_nr_rings = 4 };
+	zc = zc_on ? 1UL << 1 : 0; bp.af_xdp_zc_qs = &zc;
+	need = true; dyn_msix = true; irqs_required = 4; inner_rc = rc; frees = allocs = int_inits = 0;
