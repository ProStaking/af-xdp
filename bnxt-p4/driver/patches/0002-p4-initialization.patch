+int bnxt_hwrm_xsk_group_free_checked(struct bnxt *bp, u16 group_idx,
+                                    bool *blocked)
+{
+	struct hwrm_ring_grp_free_output *resp;
+	struct hwrm_ring_grp_free_input *req;
+	int rc;
