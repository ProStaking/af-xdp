+                    str(p / 'test.c'), '-o', str(p / 'test')], check=True)
+    subprocess.run([str(p / 'test')], check=True)
+print('PASS actual open/close: post-activation restore/backstop failure returned after full normal close; '
+      'ndo_stop dispatch idempotent; early unwind unchanged; ndo_open takes link down and undoes if_change; '
+      'fw-reset reopen does not set ABORT_ERR')
