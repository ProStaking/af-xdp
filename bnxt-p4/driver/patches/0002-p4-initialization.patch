+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Actual vendor generation-specific completion selectors; no hardware IO."""
+from pathlib import Path
+import subprocess,tempfile
+src=(Path(__file__).resolve().parents[1]/'bnxt.c').read_text()
+def extract(name):
+ start=src.index('static u16 '+name+'(')
+ return src[start:src.index('\n}\n',start)+3]
+preamble=r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stddef.h>
+typedef uint16_t u16;
+#define BNXT_FLAG_CHIP_P5_PLUS 1
+struct bnxt_ring_struct { unsigned grp_idx; u16 fw_ring_id; };
+struct bnxt_ring_grp_info { u16 cp_fw_ring_id; };
+struct bnxt { unsigned flags; struct bnxt_ring_grp_info *grp_info; };
+struct cp { struct bnxt_ring_struct cp_ring_struct; };
+struct bnxt_rx_ring_info { struct bnxt_ring_struct rx_ring_struct; struct cp *rx_cpr; };
+struct bnxt_tx_ring_info { struct bnxt_ring_struct tx_ring_struct; struct cp *tx_cpr; };
+'''
+main=r'''
+int main(void) {
+ struct bnxt_ring_grp_info groups[3]={{11},{22},{33}};
+ struct bnxt bp={0,groups};
+ struct bnxt_rx_ring_info rx={{2,100},NULL};
+ struct bnxt_tx_ring_info tx={{1,101},NULL};
+ /* P4 must use group membership, not queue position or P5-only pointers. */
+ assert(bnxt_cp_ring_for_rx(&bp,&rx)==33);
+ assert(bnxt_cp_ring_for_tx(&bp,&tx)==22);
+ groups[2].cp_fw_ring_id=UINT16_MAX;
+ assert(bnxt_cp_ring_for_rx(&bp,&rx)==UINT16_MAX);
+ /* P5 must use direct completion rings, independently of group memory. */
+ struct cp rcp={{0,44}},tcp={{0,55}};
+ bp.flags=BNXT_FLAG_CHIP_P5_PLUS;bp.grp_info=NULL;
+ rx.rx_cpr=&rcp;tx.tx_cpr=&tcp;
+ assert(bnxt_cp_ring_for_rx(&bp,&rx)==44);
+ assert(bnxt_cp_ring_for_tx(&bp,&tx)==55);
+ tcp.cp_ring_struct.fw_ring_id=UINT16_MAX;
+ assert(bnxt_cp_ring_for_tx(&bp,&tx)==UINT16_MAX);
+ return 0;
+}
+'''
+with tempfile.TemporaryDirectory() as d:
+ p=Path(d);(p/'test.c').write_text(preamble+'\n'.join(extract(n) for n in ('bnxt_cp_ring_from_grp','bnxt_cp_ring_for_rx','bnxt_cp_ring_for_tx'))+main)
+ subprocess.run(['gcc','-std=c17','-Wall','-Wextra','-Werror','-fsanitize=address,undefined','-fno-sanitize-recover=all','-g',str(p/'test.c'),'-o',str(p/'test')],check=True)
+ subprocess.run([str(p/'test')],check=True)
+print('P4/P5 actual completion selector regressions passed; no hardware or activation')
