+struct tx_bd { __le32 tx_bd_len_flags_type; u32 tx_bd_opaque; __le64 tx_bd_haddr; };
+struct bnxt_sw_rx_bd { void *data; u8 *data_ptr; dma_addr_t mapping; };
+struct bnxt_sw_tx_bd { struct xdp_frame *xdpf; struct page *page; dma_addr_t mapping; u32 len;
+		       u16 rx_prod; u8 action, nr_frags; };
