+# SPDX-License-Identifier: GPL-2.0-only
+"""Actual bnxt_reserve_rings wrapper: bnapi state after a failed reservation.
+
+With new resource management the wrapper frees bnapi before reserving and
+reallocates it only on success. A later open that needs no new reservation
+then dereferences a NULL bnapi in bnxt_alloc_mem. The AF_XDP shrink guard
+turns an ordinary short grant into such a failure, so with zero-copy queues
+configured the wrapper must not leave bnapi freed. Without zero-copy queues
+the vendor behavior is unchanged (also run against research-driver).
+"""
+from pathlib import Path
+import os, subprocess, sys, tempfile
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import csrc
+
+root = Path(__file__).resolve().parents[1]
