+main = r'''
+static struct net_device dev; static struct bnxt bp;
+static void reset(void)
+{
+	nev = locks = noop_releases = restore_calls = steer_calls = 0;
+	mem = irq = napi_added = napi_on = hw = ints = tx = timer_on = false;
+	bp = (struct bnxt){ .dev = &dev }; dev = (struct net_device){ .running = true, .priv = &bp };
+}
+static bool released(void)
+{
+	return !mem && !irq && !napi_added && !napi_on && !hw && !ints && !tx && !timer_on &&
+	       !locks && !test_bit(BNXT_STATE_OPEN, &bp.state);
+}
+static int find(int e, int from) { for (int i = from; i < nev; i++) if (ev[i] == e) return i; return -1; }
+static void expect_full_close_after(int at, bool irq_re_init)
+{
+	int order[] = { EV_TX_DIS, EV_SHUTDOWN, EV_NAPI_DIS, EV_TIMER_DEL, EV_TX_DRAIN, EV_RX_DRAIN,
+			EV_MPC_DRAIN, EV_IRQ_FREE, EV_NAPI_DEL, EV_MEM_FREE };
+	int pos = at;
+	for (unsigned i = 0; i < sizeof(order) / sizeof(*order); i++) {
+		if (!irq_re_init && (order[i] == EV_IRQ_FREE || order[i] == EV_NAPI_DEL)) continue;
+		int next = find(order[i], pos + 1);
+		assert(next > pos); pos = next;
+	}
+}
+
+int main(void)
+{
+	int post_activation[] = { EV_RESTORE, EV_STEER };
+	for (int irq_re_init = 0; irq_re_init < 2; irq_re_init++) {
+		for (unsigned k = 0; k < 2; k++) {
+			int stage = post_activation[k];
+			reset(); fail_at = stage; fail_rc = k ? -EOPNOTSUPP : -ENOSPC;
+			int rc = bnxt_open_nic(&bp, irq_re_init, false);
+			fprintf(stderr, "post-activation failure stage=%d irq=%d rc=%d\n", stage, irq_re_init, rc);
+			assert(rc == fail_rc);
+			int at = find(stage, 0), closed = find(EV_NETIF_CLOSE, 0);
+			assert(at > 0 && closed > at && find(EV_PEER, 0) < 0);
+			/* Full normal close of the activated NIC, before netif_close. */
+			expect_full_close_after(at, irq_re_init);
+			assert(find(EV_MEM_FREE, at) < closed);
+			int ld = find(EV_LINK_DOWN, at); assert(ld < 0 || ld > closed);	/* only ndo_stop's */
+			/* Kernel then stops the still-running device; release is idempotent. */
+			assert(find(EV_NDO_STOP, closed) > closed && !dev.running);
+			assert(released() && noop_releases > 0);
+			/* The same objects reopen cleanly after the failure. */
+			nev = restore_calls = steer_calls = 0; fail_at = 0; dev.running = true;
+			assert(bnxt_open_nic(&bp, irq_re_init, false) == 0);
+			bnxt_close_nic(&bp, irq_re_init, false); assert(released());
+		}
+		/* Success: restore and backstop run once, peer maps after them. */
+		reset(); fail_at = 0;
+		assert(bnxt_open_nic(&bp, irq_re_init, false) == 0 && test_bit(BNXT_STATE_OPEN, &bp.state));
+		assert(restore_calls == 1 && steer_calls == 1 && find(EV_PEER, find(EV_STEER, 0)) > 0);
+		bnxt_close_nic(&bp, irq_re_init, false);
+		assert(released() && find(EV_NETIF_CLOSE, 0) < 0);
+	}
+
+	/* Pre-activation failures keep the existing unwind; no close inside open. */
+	int early[] = { EV_RESERVE, EV_ALLOC, EV_IRQ, EV_INIT };
+	for (unsigned k = 0; k < 4; k++) {
+		reset(); fail_at = early[k]; fail_rc = -ENOMEM;
+		assert(bnxt_open_nic(&bp, true, false) == -ENOMEM);
+		int closed = find(EV_NETIF_CLOSE, 0);
+		assert(closed > 0 && find(EV_TX_DIS, 0) > closed && find(EV_RESTORE, 0) < 0);
+		assert(released());
+	}
+
+	/* ndo_open: error returned, interface-change undone, no ndo_stop by core. */
+	for (unsigned k = 0; k < 2; k++) {
+		reset(); fail_at = post_activation[k]; fail_rc = -EIO; dev.running = false;
+		assert(bnxt_open(&dev) == -EIO);
+		assert(find(EV_IF_DOWN, find(EV_MEM_FREE, 0)) > 0 && find(EV_NETIF_CLOSE, 0) < 0);
+		/* The core will not call ndo_stop: take the PHY link down as it would. */
+		int link = find(EV_LINK_DOWN, find(EV_MEM_FREE, 0));
+		assert(link > 0 && link < find(EV_IF_DOWN, 0) && find(EV_LINK_DOWN, link + 1) < 0);
+		assert(released());
+	}
+
+	/* Firmware-reset reopen (IN_FW_RESET set): the unwind must use the plain
+	 * close, not bnxt_close_nic(), which would set ABORT_ERR. */
+	reset(); fail_at = EV_RESTORE; fail_rc = -EIO; dev.running = false;
+	set_bit(BNXT_STATE_IN_FW_RESET, &bp.state);
+	assert(bnxt_open(&dev) == -EIO && !test_bit(BNXT_STATE_ABORT_ERR, &bp.state) && released());
+	return 0;
+}
+'''
+
+names = ['bnxt_free_skbs', '__bnxt_close_nic', 'bnxt_close_nic', 'bnxt_close',
+         '__bnxt_open_nic', 'bnxt_open_nic', 'bnxt_open']
+code = pre + ''.join(csrc.function(src, n) for n in names) + main
