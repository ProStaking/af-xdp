+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <errno.h>
+#define BNXT_MAX_XSK_RINGS 64
+#define BNXT_NEW_RM(bp) ((bp)->new_rm)
+#define BNXT_TX_XDP_RINGS_PER_GRP(bp) 1
+#define netdev_err(...) ((void)0)
+struct net_device;
+struct bnxt {
+	void *irq_tbl, *bnapi, *pdev; struct net_device *dev; unsigned long *af_xdp_zc_qs;
+	int num_tc, total_irqs, tx_nr_rings_per_tc, tx_nr_rings, tx_nr_rings_xdp; bool new_rm;
+};
+static bool bitmap_empty(const unsigned long *p, unsigned n) { (void)n; return !*p; }
+static int bnapi_obj, irq_obj, inner_rc, irqs_required, frees, allocs, int_inits;
+static bool need, dyn_msix;
+static bool bnxt_need_reserve_rings(struct bnxt *b) { (void)b; return need; }
+static int bnxt_get_irqs_required(struct bnxt *b) { (void)b; return irqs_required; }
+static bool pci_msix_can_alloc_dyn(void *p) { (void)p; return dyn_msix; }
+static void bnxt_ulp_irq_stop(struct bnxt *b) { (void)b; }
+static void bnxt_ulp_irq_restart(struct bnxt *b, int rc) { (void)b; (void)rc; }
+static void bnxt_free_bnapi_mem(struct bnxt *b) { if (b->bnapi) frees++; b->bnapi = NULL; }
+static int bnxt_alloc_bnapi_mem(struct bnxt *b) { assert(!b->bnapi); allocs++; b->bnapi = &bnapi_obj; return 0; }
+static void bnxt_clear_int_mode(struct bnxt *b) { bnxt_free_bnapi_mem(b); b->irq_tbl = NULL; }
