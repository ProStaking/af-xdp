+	if (bp->grp_info[group_idx].fw_grp_id == INVALID_HW_RING_ID)
+		return -EINVAL;
+	if (BNXT_NO_FW_ACCESS(bp)) {
+		*blocked = true;
+		return -ENODEV;
 	}
+	rc = hwrm_req_init(bp, req, HWRM_RING_GRP_FREE);
+	if (rc)
