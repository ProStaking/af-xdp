+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <errno.h>
+typedef uint16_t u16; typedef uint32_t u32;
+#define BNXT_MAX_XSK_RINGS 64
