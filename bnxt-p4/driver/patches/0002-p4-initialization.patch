+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Actual open/close wrappers: steering restored after activation must be checked.
+
+Failure is injected at the restore call (and the AF_XDP steering backstop),
+not at an earlier stage. netif_close is modeled as the kernel does it: a
+running device is stopped through ndo_stop (bnxt_close). Lower layers are
+state-model mocks; this is control flow and ordering, not DMA-stop proof.
+"""
+from pathlib import Path
+import os, subprocess, sys, tempfile
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import csrc
+
+root = Path(__file__).resolve().parents[1]
+src = (root / 'bnxt.c').read_text()
