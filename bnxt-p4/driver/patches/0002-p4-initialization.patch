+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Integrated AF_XDP zero-copy data-path lifecycle on actual driver code.
+
+Actual functions, compiled together: RX fill (bnxt_alloc_one_rx_ring_skb,
+bnxt_alloc_rx_data, bnxt_xsk_validate_pool), bnxt_reuse_rx_data, the RX
+producer bnxt_rx_xsk, XDP_TX enqueue (__bnxt_xmit_xdp, bnxt_xmit_bd with the
+real length-hint table), raw TX submission bnxt_xsk_xmit, TX completion
+(bnxt_tx_int_xdp, __bnxt_tx_int_xdp) via the real end-of-poll
+__bnxt_poll_work_done, bnxt_xsk_reclaim_tx, the whole bnxt_free_one_rx_ring
+and bnxt_clear_ring_indices. Ring/descriptor macros come from bnxt.h.
+
+Modeled: the completion-ring parsing of __bnxt_poll_work (the caller's
+consumer/producer updates and the XDP_TX doorbell block are reproduced as in
+bnxt_rx_pkt), the AF_XDP core (FILL/TX/completion rings, redirect peer), and the
+device. The device only DMAs into RX buffers the driver has published by
+doorbell and that no uncompleted XDP_TX references, and only transmits
+descriptors published by TX doorbell whose frame owner and payload still match.
+
+Scenarios: two attach/process/detach cycles on the same ring objects with a
+ring-index reset between them; a FILL ring that runs dry partway through open;
+for each packet position, a failed replacement allocation, a failed redirect
+or a full TX ring; and close with raw TX still outstanding. Every frame's owner
+is tracked and checked after every step. Not proof of hardware DMA ordering.
+"""
+from pathlib import Path
+import os, re, subprocess, sys, tempfile
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import csrc
+
+root = Path(__file__).resolve().parents[1]
+net = (root / 'bnxt.c').read_text()
+xsk = (root / 'bnxt_xsk.c').read_text()
+xdp = (root / 'bnxt_xdp.c').read_text()
+hdr = (root / 'bnxt.h').read_text()
+
+
+def macro(name):
+    lines = hdr.splitlines()
+    for i, line in enumerate(lines):
+        if re.match(r'\s*#define\s+' + re.escape(name) + r'(\s|\()', line):
+            out = [line.strip()]
+            while out[-1].endswith('\\'):
+                i += 1
+                out.append(lines[i])
+            return '\n'.join(out) + '\n'
+    raise SystemExit('macro absent: ' + name)
+
+
+macros = ''.join(macro(n) for n in (
+    'TX_BD_LEN', 'TX_BD_LEN_SHIFT', 'TX_BD_FLAGS_PACKET_END', 'TX_BD_FLAGS_BD_CNT',
+    'TX_BD_FLAGS_BD_CNT_SHIFT', 'TX_BD_CNT', 'TX_BD_FLAGS_LHINT_512_AND_SMALLER',
+    'TX_BD_FLAGS_LHINT_512_TO_1023', 'TX_BD_FLAGS_LHINT_1024_TO_2047',
+    'TX_BD_FLAGS_LHINT_2048_AND_LARGER', 'TX_OPAQUE_IDX_MASK', 'TX_OPAQUE_BDS_MASK',
+    'TX_OPAQUE_BDS_SHIFT', 'TX_OPAQUE_RING_SHIFT', 'SET_TX_OPAQUE', 'RX_BD_LEN_SHIFT',
+    'RX_DESC_CNT', 'TX_DESC_CNT', 'RX_RING', 'RX_IDX', 'TX_RING', 'TX_IDX', 'RING_RX',
+    'RING_TX', 'NEXT_RX', 'NEXT_TX', 'BNXT_RING_FLAG_AF_XDP_ZC', 'BNXT_RING_RX_ZC_MODE',
+    'BNXT_RX_PAGE_MODE', 'BNXT_DEV_STATE_CLOSING', 'BNXT_XSK_TX', 'BNXT_RX_EVENT',
+    'BNXT_AGG_EVENT', 'BNXT_TX_EVENT', 'BNXT_REDIRECT_EVENT', 'BNXT_TX_CMP_EVENT',
+    'BNXT_NQ0_NAPI', 'bnxt_for_each_napi_tx'))
+a = net.index('const u16 bnxt_lhint_arr[] = {')
+lhint = net[a:net.index('};', a) + 2] + '\n'
+tx_avail = csrc.function(hdr, 'bnxt_tx_avail').replace('bnxt_tx_avail(', 'bnxt_tx_avail_real(', 1)
+# The XDP_TX doorbell block that ends the RX loop of __bnxt_poll_work.
+work = csrc.function(net, '__bnxt_poll_work')
+a = work.index('\tif (event & BNXT_TX_EVENT) {')
+tx_doorbell = work[a:work.index('\t}\n', a) + 3]
