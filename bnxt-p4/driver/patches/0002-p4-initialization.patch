+/* Only after ring/pool teardown, or before any pool has been published. */
+static void bnxt_xsk_bitmap_fini(struct bnxt *bp)
+{
+	bitmap_free(bp->af_xdp_zc_qs);
+	bp->af_xdp_zc_qs = NULL;
+}
