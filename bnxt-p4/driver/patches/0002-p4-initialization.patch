+	u32 rx_offset, rx_dma_offset, rx_buf_use_size, rx_ring_mask, tx_ring_mask;
+	int rx_dir, rx_ring_size, tx_ring_size, rx_nr_pages, cp_nr_rings; struct bnxt_napi **bnapi;
+};
+static void wmb(void) {}
+struct skb_shared_info { int nr_frags; };
+static bool xdp_buff_has_frags(struct xdp_buff *x) { (void)x; assert(!"frags"); return false; }
