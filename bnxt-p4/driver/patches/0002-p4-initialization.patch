+/* Initialization seam for isolated P4 development. Live probe/setup still
+ * permit P5+ only. Caller owns device lifecycle serialization; no MMIO/HWRM
+ * or generation-specific ring/group/doorbell state is changed here.
+ */
+static int bnxt_xsk_bitmap_init(struct bnxt *bp)
+{
+	if (!BNXT_CHIP_P4(bp) && !BNXT_CHIP_P5_PLUS(bp))
+		return -EOPNOTSUPP;
+	if (bp->af_xdp_zc_qs)
+		return -EALREADY;
+	bp->af_xdp_zc_qs = bitmap_zalloc(BNXT_MAX_XSK_RINGS, GFP_KERNEL);
+	return bp->af_xdp_zc_qs ? 0 : -ENOMEM;
+}
