+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Disconnected checked group-free primitive; no recovery/DMA guarantee."""
+from pathlib import Path
+import subprocess,tempfile
+src=(Path(__file__).resolve().parents[1]/'bnxt.c').read_text()
+def extract(sig):
+ a=src.index(sig);return src[a:src.index('\n}\n',a)+3]
+pre=r'''
+#include <assert.h>
+#include <stdint.h>
+#include <errno.h>
+#include <string.h>
+#include <stdbool.h>
+typedef uint16_t u16;
+#define BNXT_FLAG_CHIP_P5_PLUS 1
+#define INVALID_HW_RING_ID 65535
+#define HWRM_RING_GRP_ALLOC 1
+#define HWRM_RING_GRP_FREE 2
+#define BNXT_CHIP_P4(b) (!((b)->flags & BNXT_FLAG_CHIP_P5_PLUS))
+#define BNXT_NO_FW_ACCESS(b) no_fw_access(b)
+#define le16_to_cpu(x) (x)
+#define cpu_to_le16(x) (x)
+#define cpu_to_le32(x) (x)
+#define le32_to_cpu(x) (x)
+struct grp {unsigned cp_fw_ring_id,rx_fw_ring_id,agg_fw_ring_id,fw_stats_ctx,fw_grp_id;};
+struct napi {unsigned index;};
+struct rx {struct napi *bnapi;};
+struct bnxt {unsigned flags,rx_nr_rings,cp_nr_rings;struct rx *rx_ring;struct grp *grp_info;};
+struct hwrm_ring_grp_alloc_input {unsigned cr,rr,ar,sc;};
+struct hwrm_ring_grp_free_input {unsigned ring_group_id;};
+struct hwrm_ring_grp_alloc_output {unsigned ring_group_id;};
+static union {struct hwrm_ring_grp_alloc_input alloc;struct hwrm_ring_grp_free_input free;} req_storage;
+static struct hwrm_ring_grp_alloc_output response;
+static unsigned op,inits,holds,drops,sends,fail_send,active[256];
+struct hwrm_ring_grp_free_output {unsigned error_code;};
+static struct hwrm_ring_grp_free_output free_response;
+static unsigned no_fw_at,fw_checks;
+static bool timeout_applied,internal_loss;
+static int init_rc;
+static bool no_fw_access(struct bnxt*b){(void)b;return ++fw_checks==no_fw_at;}
+static int init(void **p,unsigned type){inits++;op=type;*p=&req_storage;return init_rc;}
+#define hwrm_req_init(b,r,t) ((void)(b),init((void**)&(r),t))
+static void *hwrm_req_hold(struct bnxt*b,void*p){(void)b;assert(p==&req_storage);holds++;return op==HWRM_RING_GRP_FREE?(void*)&free_response:(void*)&response;}
+static void hwrm_req_drop(struct bnxt*b,void*p){(void)b;assert(p==&req_storage);drops++;}
+static int hwrm_req_send(struct bnxt*b,void*p){
+ (void)p;sends++;if(internal_loss)return -EBUSY;if(sends==fail_send){if(timeout_applied)active[req_storage.free.ring_group_id]--;return -ETIMEDOUT;}
+ if(op==2 && free_response.error_code)return 0;
+ if(op==1){unsigned idx=b->rx_ring[sends-1].bnapi->index;struct grp*g=&b->grp_info[idx];assert(req_storage.alloc.cr==g->cp_fw_ring_id&&req_storage.alloc.rr==g->rx_fw_ring_id&&req_storage.alloc.ar==g->agg_fw_ring_id&&req_storage.alloc.sc==g->fw_stats_ctx);response.ring_group_id=100+idx;active[100+idx]++;}
+ else {unsigned id=req_storage.free.ring_group_id;assert(id<256&&active[id]==1);active[id]--;}
+ return 0;
+}
+'''
+main=r'''
+int main(void){
+ struct grp g[3]={{.fw_grp_id=100},{.fw_grp_id=101},{.fw_grp_id=102}};
+ struct bnxt b={.cp_nr_rings=3,.grp_info=g};bool blocked=false;
+ assert(bnxt_hwrm_xsk_group_free_checked(&b,0,NULL)==-EINVAL);
+ assert(bnxt_hwrm_xsk_group_free_checked(&b,3,&blocked)==-EINVAL&&!inits);
+ b.flags=1;assert(bnxt_hwrm_xsk_group_free_checked(&b,0,&blocked)==-EOPNOTSUPP&&!inits);b.flags=0;
+ init_rc=-ENOMEM;assert(bnxt_hwrm_xsk_group_free_checked(&b,0,&blocked)==-ENOMEM&&!blocked&&!holds&&!sends&&g[0].fw_grp_id==100);init_rc=0;
+ for(unsigned missing=1;missing<=2;missing++){
+  fw_checks=0;no_fw_at=missing;blocked=false;
+  assert(bnxt_hwrm_xsk_group_free_checked(&b,0,&blocked)==-ENODEV&&blocked&&g[0].fw_grp_id==100);
+  unsigned before=inits;assert(bnxt_hwrm_xsk_group_free_checked(&b,0,&blocked)==-EUCLEAN&&inits==before);
+ }
+ no_fw_at=0;blocked=false;internal_loss=true;
+ assert(bnxt_hwrm_xsk_group_free_checked(&b,0,&blocked)==-EBUSY&&blocked&&g[0].fw_grp_id==100);
+ internal_loss=false;
+ /* Two indistinguishable timeout outcomes: request not applied, or applied
+  * before the acknowledgement was lost. Neither permits automatic retry. */
+ for(unsigned applied=0;applied<2;applied++){
+  blocked=false;sends=0;fail_send=1;timeout_applied=applied;active[100]=1;
+  assert(bnxt_hwrm_xsk_group_free_checked(&b,0,&blocked)==-ETIMEDOUT&&blocked&&g[0].fw_grp_id==100);
+  assert(active[100]==1-applied);
+  unsigned before=sends;assert(bnxt_hwrm_xsk_group_free_checked(&b,0,&blocked)==-EUCLEAN&&sends==before);
+ }
+ /* Fresh independent fixtures, not an in-place recovery or flag reset API. */
+ fail_send=0;timeout_applied=false;free_response.error_code=1;blocked=false;active[101]=1;
+ assert(bnxt_hwrm_xsk_group_free_checked(&b,1,&blocked)==-EIO&&blocked&&g[1].fw_grp_id==101&&active[101]);
+ free_response.error_code=0;bool fresh_blocked=false;active[102]=1;
+ assert(!bnxt_hwrm_xsk_group_free_checked(&b,2,&fresh_blocked)&&!fresh_blocked&&g[2].fw_grp_id==INVALID_HW_RING_ID&&!active[102]);
+ assert(g[0].fw_grp_id==100&&g[1].fw_grp_id==101);
+ unsigned before=sends;assert(bnxt_hwrm_xsk_group_free_checked(&b,2,&fresh_blocked)==-EINVAL&&sends==before);
+ assert(holds==drops);
+ return 0;
+}
+'''
+transport=(Path(__file__).resolve().parents[1]/'bnxt_hwrm.c').read_text()
+start=transport.index('static int __hwrm_send(')
+body=transport[start:transport.index('\n}\n',start)+3]
+assert 'int rc = -EBUSY;' in body[:body.index('if (BNXT_NO_FW_ACCESS(bp)')]
+# Retention is deliberately disconnected: legacy teardown and reinit would
+# still free/reset surrounding state. Do not imply end-to-end quarantine.
+legacy=extract('static void bnxt_hwrm_ring_grp_free(')
+assert 'bnxt_hwrm_xsk_group_free_checked' not in legacy
