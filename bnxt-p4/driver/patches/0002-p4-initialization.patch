+tf_lines, lines = [], hdr.splitlines()
+for i, line in enumerate(lines):
+    if re.match(r'\s*#define\s+BNXT_TF_FLAG_(INITIALIZED|SWITCHDEV|DEVLINK)\s', line):
+        tf_lines.append(line.strip())
