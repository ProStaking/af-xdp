+#include <assert.h>
+#include <stdbool.h>
+#include <errno.h>
+#include <stdio.h>
+#define BNXT_STATE_OPEN 0
+#define BNXT_STATE_ABORT_ERR 1
+#define BNXT_STATE_IN_FW_RESET 2
+#define BNXT_STATE_FW_RESET_DET 3
+#define BNXT_STATE_NAPI_DISABLED 9
+#define BNXT_PF(b) 1
+#define BNXT_SINGLE_PF(b) 1
+#define BNXT_TRUFLOW_EN(b) 0
+#define BNXT_SUPPORTS_MULTI_RSS_CTX(b) 0
+#define BNXT_RESTART_ULP_SP_EVENT 9
+#define netif_info(...) ((void)0)
+#define netdev_err(...) ((void)0)
+#define netdev_warn(...) ((void)0)
+#define HZ 100
+static int jiffies;
+struct bnxt;
+struct net_device { bool running; struct bnxt *priv; };
+struct bnxt {
+	unsigned long state; struct net_device *dev; int timer, link_lock, current_interval;
+	void *ktls_info; int (*get_pkt_dev)(void);
+	struct { bool phy_retry; int phy_retry_expires; } link_info;
+};
+enum { EV_RESERVE = 1, EV_ALLOC, EV_IRQ, EV_INIT, EV_NAPI_EN, EV_INT_EN, EV_TX_EN, EV_TIMER,
+       EV_RESTORE, EV_STEER, EV_PEER, EV_TX_DIS, EV_SHUTDOWN, EV_NAPI_DIS, EV_TIMER_DEL,
+       EV_TX_DRAIN, EV_RX_DRAIN, EV_MPC_DRAIN, EV_IRQ_FREE, EV_NAPI_DEL, EV_MEM_FREE,
+       EV_IF_UP, EV_IF_DOWN, EV_NETIF_CLOSE, EV_NDO_STOP, EV_LINK_DOWN };
+static int ev[256], nev;
+static void event(int e) { assert(nev < 256); ev[nev++] = e; }
+static int fail_at, fail_rc = -EIO;
+static bool mem, irq, napi_added, napi_on, hw, ints, tx, timer_on;
+static int locks, noop_releases, restore_calls, steer_calls;
+static int hit(int stage) { return fail_at == stage ? fail_rc : 0; }
+static bool test_bit(int n, unsigned long *p) { return *p >> n & 1; }
+static void set_bit(int n, unsigned long *p) { *p |= 1UL << n; }
+static void clear_bit(int n, unsigned long *p) { *p &= ~(1UL << n); }
